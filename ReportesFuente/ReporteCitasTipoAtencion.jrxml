<?xml version='1.0' encoding='UTF-8'?>
<jasperReport name="ReporteCitasTipoAtencion" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f6e94b3b-62cc-419b-8c30-baf92cdf6a77">
  <parameter name="fechaInicio" class="java.sql.Date"/>
  <parameter name="fechaFin" class="java.sql.Date"/>
  <query language="sql">SELECT t.tipo AS tipo_atencion,
 CAST(COALESCE(SUM(CASE WHEN c.estado IN ('RESERVADA', 'CONFIRMADA') THEN 1 ELSE 0 END),0) AS SIGNED) AS programadas,
 CAST(COALESCE(SUM(CASE WHEN c.estado = 'ATENDIDA' THEN 1 ELSE 0 END),0) AS SIGNED) AS atendidas,
 CAST(COALESCE(SUM(CASE WHEN c.estado = 'CANCELADA' THEN 1 ELSE 0 END),0) AS SIGNED) AS canceladas,
 CAST(COUNT(c.id_cita) AS SIGNED) AS total
 FROM (SELECT 'CONSULTA' AS tipo UNION ALL SELECT 'CONTROL' UNION ALL SELECT 'CIRUGIA' UNION ALL SELECT 'VACUNACION') t
 LEFT JOIN CITA c ON c.tipo_atencion = t.tipo AND c.activo = 1
 AND c.fecha BETWEEN $P{fechaInicio} AND $P{fechaFin}
 GROUP BY t.tipo
 ORDER BY FIELD(t.tipo, 'CONSULTA','CONTROL','CIRUGIA','VACUNACION')</query>
  <field name="tipo_atencion" class="java.lang.String"/>
  <field name="programadas" class="java.lang.Long"/>
  <field name="atendidas" class="java.lang.Long"/>
  <field name="canceladas" class="java.lang.Long"/>
  <field name="total" class="java.lang.Long"/>
  <variable name="TOTAL_CITAS" class="java.lang.Long" calculation="Sum">
    <expression>$F{total}</expression>
  </variable>
  <variable name="TOTAL_PROGRAMADAS" class="java.lang.Long" calculation="Sum">
    <expression>$F{programadas}</expression>
  </variable>
  <variable name="TOTAL_ATENDIDAS" class="java.lang.Long" calculation="Sum">
    <expression>$F{atendidas}</expression>
  </variable>
  <variable name="TOTAL_CANCELADAS" class="java.lang.Long" calculation="Sum">
    <expression>$F{canceladas}</expression>
  </variable>
  <background splitType="Stretch"/>
