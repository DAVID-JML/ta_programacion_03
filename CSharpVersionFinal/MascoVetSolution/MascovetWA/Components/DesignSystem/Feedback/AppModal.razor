@if (Visible)
{
    <div class="ms-modal-overlay">
        <div class="ms-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             tabindex="-1"
             @ref="_dialog"
             @onkeydown="HandleKeyDown">
            <header class="ms-modal__header">
                <h2 id="@_titleId" class="ms-modal__title">@Title</h2>
                <button type="button" class="ms-modal__close" aria-label="Cerrar diálogo" disabled="@Busy" @onclick="RequestCloseAsync">
                    <AppIcon Name="x" Size="18" />
                </button>
            </header>

            <div class="ms-modal__body">@ChildContent</div>

            <footer class="ms-modal__footer">
                @if (Actions is not null)
                {
                    @Actions
                }
                else
                {
                    <AppButton Variant="ButtonVariant.Tertiary" Disabled="@Busy" OnClick="RequestCloseAsync">@CancelText</AppButton>
                    <AppButton Variant="ConfirmVariant" Loading="@Busy" OnClick="ConfirmAsync">@ConfirmText</AppButton>
                }
            </footer>
        </div>
    </div>
}

@code {
    private readonly string _titleId = "ms-modal-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _dialog;
    private bool _wasVisible;

    /// <summary>Controla la visibilidad. Úsalo con @bind-Visible.</summary>
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Acciones propias del pie. Si se omite, se muestran Cancelar y Confirmar.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public string ConfirmText { get; set; } = "Confirmar";
    [Parameter] public string CancelText { get; set; } = "Cancelar";
    [Parameter] public ButtonVariant ConfirmVariant { get; set; } = ButtonVariant.Primary;

    /// <summary>Se invoca solo cuando la persona confirma. El modal NO se cierra solo: quien lo usa decide cuándo.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>Se invoca cuando la persona cancela o cierra de forma explícita (botón, X o Escape).</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Indica que la acción confirmada está en curso: bloquea el cierre y muestra carga.</summary>
    [Parameter] public bool Busy { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible && !_wasVisible)
        {
            _wasVisible = true;
            try { await _dialog.FocusAsync(); }
            catch (Exception) { /* el enfoque es una mejora; si falla (circuito cerrado) se ignora */ }
        }
        else if (!Visible)
        {
            _wasVisible = false;
        }
    }

    private async Task RequestCloseAsync()
    {
        if (Busy) return;
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
        await OnCancel.InvokeAsync();
    }

    private Task ConfirmAsync() => OnConfirm.InvokeAsync();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await RequestCloseAsync();
    }
}
