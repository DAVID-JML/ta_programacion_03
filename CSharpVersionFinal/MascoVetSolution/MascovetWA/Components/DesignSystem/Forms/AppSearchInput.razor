<AppFieldWrapper FieldId="@FieldId" Label="@Label" HelpText="@HelpText" Errors="@(Array.Empty<string>())">
    <div class="ms-search">
        <span class="ms-search__icon"><AppIcon Name="search" Size="18" /></span>
        <input @attributes="AdditionalAttributes"
               id="@FieldId"
               type="search"
               class="ms-control ms-search__input"
               value="@Value"
               placeholder="@Placeholder"
               disabled="@Disabled"
               aria-label="@(string.IsNullOrEmpty(Label) ? AriaLabel : null)"
               aria-describedby="@(string.IsNullOrEmpty(HelpText) ? null : $"{FieldId}-help")"
               @oninput="HandleInput"
               @ref="_input" />
        @if (!string.IsNullOrEmpty(Value) && !Disabled)
        {
            <button type="button" class="ms-search__clear" aria-label="Limpiar búsqueda" @onclick="ClearAsync">
                <AppIcon Name="x" Size="16" />
            </button>
        }
    </div>
</AppFieldWrapper>

@code {
    private readonly string _generatedId = "ms-search-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _input;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Id { get; set; }

    /// <summary>Etiqueta visible. Si se omite, se usa AriaLabel como nombre accesible.</summary>
    [Parameter] public string? Label { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Buscar";
    [Parameter] public string? Placeholder { get; set; } = "Buscar…";
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public bool Disabled { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string FieldId => Id ?? _generatedId;

    private Task HandleInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private async Task ClearAsync()
    {
        await ValueChanged.InvokeAsync(string.Empty);
        await _input.FocusAsync();
    }
}
