@if (TotalItems > 0)
{
    <div class="ms-pagination">
        <p class="ms-pagination__summary" aria-live="polite">Mostrando @FirstItem–@LastItem de @TotalItems</p>

        <nav aria-label="@AriaLabel">
            <ul class="ms-pagination__list">
                <li>
                    <button type="button" class="ms-page-btn" aria-label="Página anterior"
                            disabled="@(Page <= 1)" @onclick="() => GoToAsync(Page - 1)">
                        <AppIcon Name="chevron-left" Size="16" />
                    </button>
                </li>
                @foreach (var p in VisiblePages)
                {
                    <li>
                        <button type="button"
                                class="@(p == Page ? "ms-page-btn ms-page-btn--current" : "ms-page-btn")"
                                aria-label="@PageLabel(p)"
                                aria-current="@(p == Page ? "page" : null)"
                                @onclick="() => GoToAsync(p)">@p</button>
                    </li>
                }
                <li>
                    <button type="button" class="ms-page-btn" aria-label="Página siguiente"
                            disabled="@(Page >= TotalPages)" @onclick="() => GoToAsync(Page + 1)">
                        <AppIcon Name="chevron-right" Size="16" />
                    </button>
                </li>
            </ul>
        </nav>
    </div>
}

@code {
    /// <summary>Página actual (base 1). Úsalo con @bind-CurrentPage.</summary>
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }

    /// <summary>Total de registros (después de aplicar filtros).</summary>
    [Parameter, EditorRequired] public int TotalItems { get; set; }

    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public string AriaLabel { get; set; } = "Paginación";

    private int SafePageSize => Math.Max(1, PageSize);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(TotalItems / (double)SafePageSize));
    private int Page => Math.Clamp(CurrentPage, 1, TotalPages);
    private int FirstItem => (Page - 1) * SafePageSize + 1;
    private int LastItem => Math.Min(Page * SafePageSize, TotalItems);

    // Ventana de hasta 5 números de página alrededor de la actual
    private IEnumerable<int> VisiblePages
    {
        get
        {
            var start = Math.Max(1, Math.Min(Page - 2, TotalPages - 4));
            var end = Math.Min(TotalPages, start + 4);
            return Enumerable.Range(start, end - start + 1);
        }
    }

    private static string PageLabel(int page) => $"Ir a la página {page}";

    private async Task GoToAsync(int page)
    {
        page = Math.Clamp(page, 1, TotalPages);
        if (page == Page) return;
        await CurrentPageChanged.InvokeAsync(page);
    }
}
