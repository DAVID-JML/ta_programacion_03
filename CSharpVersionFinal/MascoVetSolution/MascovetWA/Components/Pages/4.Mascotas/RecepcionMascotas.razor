@page "/recepcion/mascotas"
@layout MainLayout

<PageTitle>Mascotas de clientes | Mascovet</PageTitle>

<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div>
            <h1>Mascotas de clientes</h1>
            <p>Consulta y administra las mascotas asociadas a los clientes.</p>
        </div>
        <span class="ms-demo-pill">Vista de demostración</span>
    </header>

    <div class="seccion">
        <AppCard Title="Mascotas de clientes" Subtitle="Registro, edición, consulta e inactivación de mascotas.">
            <ChildContent>
                <AppTable TItem="MascotaDemo" Items="@mascotas" ColumnCount="5" Caption="Mascotas registradas">
                    <HeaderContent>
                        <th scope="col">Mascota</th>
                        <th scope="col">Especie</th>
                        <th scope="col">Propietario</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </HeaderContent>
                    <RowTemplate Context="m">
                        <td>@m.Nombre</td>
                        <td>@m.Especie</td>
                        <td>@m.Propietario</td>
                        <td>
                            <AppBadge Variant="SemanticVariant.Success" ShowIcon="false">@m.Estado</AppBadge>
                        </td>
                        <td>
                            <AppButton Href="@($"/recepcion/mascotas/{m.Id}")" Size="ButtonSize.Small" Variant="ButtonVariant.Secondary">Ver ficha</AppButton>
                        </td>
                    </RowTemplate>
                </AppTable>
            </ChildContent>
        </AppCard>
    </div>

    <div class="ms-demo-actions">
        <AppButton Href="/recepcion/mascotas/nueva" Variant="ButtonVariant.Primary">Registrar mascota</AppButton>
    </div>
</div>

@code {
    private sealed record MascotaDemo(int Id, string Nombre, string Especie, string Propietario, string Estado);

    private readonly List<MascotaDemo> mascotas = new()
    {
        new(1, "Luna", "Perro", "Ana Martínez López", "Activa"),
        new(2, "Max", "Gato", "Carlos Vega Ruiz", "Activa")
    };
}