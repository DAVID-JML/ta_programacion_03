@page "/administrador/atenciones/nueva"
@layout MainLayout
@using Microsoft.AspNetCore.Components
@inject ToastService Toast

<PageTitle>Gestionar atención | Mascovet</PageTitle>

<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div>
            <h1>Gestionar atención médica</h1>
            <p>Registra, modifica o inactiva atenciones por tipo.</p>
        </div>
        <span class="ms-demo-pill">Vista de demostración</span>
    </header>

    <div class="seccion">
        <AppCard Title="Datos generales de la atención" Subtitle="Campos compartidos de las clases de atención médica.">
            <div class="ms-feature-grid">
                <AppSelect TValue="string" Label="Tipo de atención" @bind-Value="tipo" Options="@opcionesTipo" />
                <AppSelect TValue="string" Label="Cita asociada" @bind-Value="citaAsociada" Options="@opcionesCitas" />
                <AppInput TValue="decimal?" Label="Peso actual (kg)" Type="number" Placeholder="0.00" @bind-Value="peso" />
                <AppInput TValue="string" Label="Hora de inicio" Type="time" @bind-Value="horaInicio" />
                <AppInput TValue="string" Label="Hora de fin" Type="time" @bind-Value="horaFin" />
                <div class="ms-demo-wide">
                    <AppTextArea Label="Alergias" Rows="2" @bind-Value="alergias" />
                </div>
                <div class="ms-demo-wide">
                    <AppTextArea Label="Observaciones" Rows="2" @bind-Value="observaciones" />
                </div>
            </div>
        </AppCard>
    </div>

    <div class="seccion">
        <AppCard Title="Datos específicos" Subtitle="Los campos cambian según el tipo de atención seleccionado.">
            <div class="ms-feature-grid">
                @if (tipo == "Consulta")
                {
                    <div class="ms-demo-wide">
                        <AppTextArea Label="Motivo de consulta" Rows="2" @bind-Value="motivoConsulta" />
                    </div>
                    <div class="ms-demo-wide">
                        <AppTextArea Label="Diagnóstico" Rows="2" @bind-Value="diagnostico" />
                    </div>
                    <div class="ms-demo-wide">
                        <AppTextArea Label="Tratamiento" Rows="2" @bind-Value="tratamiento" />
                    </div>
                }
                else if (tipo == "Control")
                {
                    <div class="ms-demo-wide">
                        <AppTextArea Label="Evolución" Rows="2" @bind-Value="evolucion" />
                    </div>
                    <div class="ms-demo-wide">
                        <AppTextArea Label="Indicaciones" Rows="2" @bind-Value="indicaciones" />
                    </div>
                }
                else if (tipo == "Cirugía")
                {
                    <div class="ms-demo-wide">
                        <AppTextArea Label="Procedimiento" Rows="2" @bind-Value="procedimiento" />
                    </div>
                    <div class="ms-demo-wide">
                        <AppTextArea Label="Indicaciones postoperatorias" Rows="2" @bind-Value="indicacionesPost" />
                    </div>
                }
                else
                {
                    <AppSelect TValue="string" Label="Vacuna aplicada" @bind-Value="vacuna" Options="@opcionesVacunas" />
                    <AppDatePicker Label="Fecha de aplicación" @bind-Value="fechaAplicacion" />
                    <AppDatePicker Label="Próxima dosis" @bind-Value="proximaDosis" Required="true" />
                    <AppInput TValue="string" Label="Dosis" MaxLength="200" Placeholder="Ej. 1 dosis" Required="true" @bind-Value="dosis" />
                }
            </div>
            <div class="ms-demo-actions">
                <AppButton OnClick="MostrarAviso">Guardar atención</AppButton>
                <AppButton Href="/administrador/atenciones" Variant="ButtonVariant.Secondary">Volver</AppButton>
            </div>
        </AppCard>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "tipo")]
    public string? TipoSeleccionado { get; set; }

    private string tipo = "Consulta";
    private string citaAsociada = "101 — Luna";
    private decimal? peso;
    private string horaInicio = "";
    private string horaFin = "";
    private string alergias = "";
    private string observaciones = "";

    private string motivoConsulta = "";
    private string diagnostico = "";
    private string tratamiento = "";
    private string evolucion = "";
    private string indicaciones = "";
    private string procedimiento = "";
    private string indicacionesPost = "";
    private string vacuna = "Antirrábica";
    private DateOnly? fechaAplicacion;
    private DateOnly? proximaDosis;
    private string dosis = "";

    private List<SelectOption<string>> opcionesTipo = new()
    {
        new("Consulta", "Consulta"),
        new("Control", "Control"),
        new("Cirugía", "Cirugía"),
        new("Vacunación", "Vacunación")
    };

    private List<SelectOption<string>> opcionesCitas = new()
    {
        new("101 — Luna", "101 — Luna"),
        new("102 — Max", "102 — Max")
    };

    private List<SelectOption<string>> opcionesVacunas = new()
    {
        new("Antirrábica", "Antirrábica"),
        new("Séxtuple", "Séxtuple"),
        new("Triple felina", "Triple felina")
    };

    protected override void OnParametersSet()
    {
        if (TipoSeleccionado is "Consulta" or "Control" or "Cirugía" or "Vacunación")
            tipo = TipoSeleccionado;
    }

    private void MostrarAviso() => Toast.Info("La operación es demostrativa. Se integrará con el backend.");
}