@page "/administrador/horarios"
@layout MainLayout
@inject ToastService Toast

<PageTitle>Horarios de atención | Mascovet</PageTitle>

<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div>
            <h1>Horarios de atención</h1>
            <p>Gestión de disponibilidad semanal por veterinario.</p>
        </div>
        <span class="ms-demo-pill">Vista de demostración</span>
    </header>

    <div class="seccion">
        <AppCard Title="Gestionar horario" Subtitle="Selecciona el veterinario, día y rango horario.">
            <ChildContent>
                <div class="ms-feature-grid">
                    <AppSelect TValue="string" Label="Veterinario" @bind-Value="vetSeleccionado" Options="@opcionesVets" />
                    <AppSelect TValue="string" Label="Día de la semana" @bind-Value="diaSeleccionado" Options="@opcionesDias" />
                    <AppInput TValue="string" Label="Hora de inicio" Type="time" @bind-Value="horaInicio" />
                    <AppInput TValue="string" Label="Hora de fin" Type="time" @bind-Value="horaFin" />
                </div>
                <div class="ms-demo-note">
                    <AppIcon Name="check-circle" Size="16" />
                    <span>Los horarios del mismo veterinario no deben superponerse.</span>
                </div>
                <div class="ms-demo-actions">
                    <AppButton Variant="ButtonVariant.Primary" OnClick="MostrarAviso">Guardar horario</AppButton>
                </div>
            </ChildContent>
        </AppCard>
    </div>

    <div class="seccion">
        <AppCard Title="Horarios registrados" Subtitle="Registros de ejemplo para la demostración">
            <ChildContent>
                <AppTable TItem="HorarioDemo" Items="@horarios" ColumnCount="6" Caption="Horarios de atención">
                    <HeaderContent>
                        <th scope="col">Veterinario</th>
                        <th scope="col">Día</th>
                        <th scope="col">Inicio</th>
                        <th scope="col">Fin</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </HeaderContent>
                    <RowTemplate Context="h">
                        <td>@h.Veterinario</td>
                        <td>@h.Dia</td>
                        <td>@h.Inicio</td>
                        <td>@h.Fin</td>
                        <td>
                            <AppBadge Variant="SemanticVariant.Success" ShowIcon="false">@h.Estado</AppBadge>
                        </td>
                        <td>
                            <AppButton Size="ButtonSize.Small" Variant="ButtonVariant.Secondary" OnClick="MostrarAviso">Editar</AppButton>
                            <AppButton Size="ButtonSize.Small" Variant="ButtonVariant.Danger" OnClick="MostrarAviso">Inactivar</AppButton>
                        </td>
                    </RowTemplate>
                </AppTable>
            </ChildContent>
        </AppCard>
    </div>
</div>

@code {
    private string vetSeleccionado = "Dra. Lucía Paredes";
    private string diaSeleccionado = "LUNES";
    private string horaInicio = "";
    private string horaFin = "";

    private List<SelectOption<string>> opcionesVets = new()
    {
        new("Dra. Lucía Paredes", "Dra. Lucía Paredes"),
        new("Dr. Mateo Silva", "Dr. Mateo Silva")
    };

    private List<SelectOption<string>> opcionesDias = new()
    {
        new("Lunes", "LUNES"),
        new("Martes", "MARTES"),
        new("Miércoles", "MIERCOLES"),
        new("Jueves", "JUEVES"),
        new("Viernes", "VIERNES"),
        new("Sábado", "SABADO"),
        new("Domingo", "DOMINGO")
    };

    private sealed record HorarioDemo(string Veterinario, string Dia, string Inicio, string Fin, string Estado);

    private readonly List<HorarioDemo> horarios = new()
    {
        new("Dra. Lucía Paredes", "Lunes", "08:00", "12:00", "Activo"),
        new("Dr. Mateo Silva", "Martes", "09:00", "13:00", "Activo")
    };

    private void MostrarAviso() => Toast.Info("Esta operación se habilitará al integrar el backend.");
}