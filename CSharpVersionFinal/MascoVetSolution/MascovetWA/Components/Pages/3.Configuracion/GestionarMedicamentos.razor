@page "/administrador/medicamentos"
@layout MainLayout
@inject ToastService Toast

<PageTitle>Gestión de medicamentos | Mascovet</PageTitle>

<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div>
            <h1>Gestión de medicamentos</h1>
            <p>Registro, consulta, modificación e inactivación del catálogo.</p>
        </div>
        <span class="ms-demo-pill">Vista de demostración</span>
    </header>

    <div class="seccion">
        <AppCard Title="Registrar o editar medicamento" Subtitle="Catálogo utilizado en las recetas médicas.">
            <ChildContent>
                <div class="ms-feature-grid">
                    <AppInput TValue="string" Label="Nombre" MaxLength="100" @bind-Value="nombre" />
                    <AppDatePicker Label="Fecha de vencimiento" @bind-Value="fechaVencimiento" />
                    <AppInput TValue="decimal?" Label="Monto (S/)" Type="number" Placeholder="0.00" @bind-Value="monto" />
                    <div class="ms-demo-wide">
                        <AppTextArea Label="Descripción" Rows="3" MaxLength="200" Placeholder="Escribe aquí..." @bind-Value="descripcion" />
                    </div>
                </div>
                <div class="ms-demo-actions">
                    <AppButton Variant="ButtonVariant.Primary" OnClick="MostrarAviso">Guardar medicamento</AppButton>
                </div>
            </ChildContent>
        </AppCard>
    </div>

    <div class="seccion">
        <AppCard Title="Medicamentos registrados" Subtitle="Registros de ejemplo para la demostración">
            <ChildContent>
                <AppTable TItem="MedicamentoDemo" Items="@medicamentos" ColumnCount="6" Caption="Medicamentos registrados">
                    <HeaderContent>
                        <th scope="col">Medicamento</th>
                        <th scope="col">Descripción</th>
                        <th scope="col">Vencimiento</th>
                        <th scope="col">Monto (S/)</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </HeaderContent>
                    <RowTemplate Context="m">
                        <td>@m.Nombre</td>
                        <td>@m.Descripcion</td>
                        <td>@m.Vencimiento</td>
                        <td>@m.Monto.ToString("F2")</td>
                        <td>
                            <AppBadge Variant="SemanticVariant.Success" ShowIcon="false">@m.Estado</AppBadge>
                        </td>
                        <td>
                            <AppButton Size="ButtonSize.Small" Variant="ButtonVariant.Secondary" OnClick="MostrarAviso">Editar</AppButton>
                            <AppButton Size="ButtonSize.Small" Variant="ButtonVariant.Danger" OnClick="MostrarAviso">Inactivar</AppButton>
                        </td>
                    </RowTemplate>
                </AppTable>
            </ChildContent>
        </AppCard>
    </div>
</div>

@code {
    private string nombre = "";
    private DateOnly? fechaVencimiento;
    private decimal? monto;
    private string descripcion = "";

    private sealed record MedicamentoDemo(string Nombre, string Descripcion, string Vencimiento, decimal Monto, string Estado);

    private readonly List<MedicamentoDemo> medicamentos = new()
    {
        new("Amoxicilina", "Antibiótico veterinario", "15/12/2027", 35.50m, "Activo"),
        new("Meloxicam", "Antiinflamatorio", "30/06/2027", 28.00m, "Activo")
    };

    private void MostrarAviso() => Toast.Info("Esta operación se habilitará al integrar el backend.");
}