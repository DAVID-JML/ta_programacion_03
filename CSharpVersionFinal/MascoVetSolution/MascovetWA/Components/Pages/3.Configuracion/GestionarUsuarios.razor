@page "/administrador/cuentas"
@page "/administrador/cuentas/gestionar"
@layout MainLayout
@inject ToastService Toast

<PageTitle>Cuentas y roles | Mascovet</PageTitle>

<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div>
            <h1>Cuentas y roles</h1>
            <p>Consulta cuentas, cambia los roles y controla el acceso al sistema.</p>
        </div>
        <span class="ms-demo-pill">Vista de demostración</span>
    </header>

    <div class="seccion">
        <AppCard Title="Cuentas del sistema" Subtitle="Habilitar, deshabilitar o actualizar el rol del personal.">
            <ChildContent>
                <AppTable TItem="UsuarioDemo" Items="@cuentas" ColumnCount="4" Caption="Cuentas de usuario">
                    <HeaderContent>
                        <th scope="col">Usuario</th>
                        <th scope="col">Rol actual</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </HeaderContent>
                    <RowTemplate Context="u">
                        <td>@u.Usuario</td>
                        <td>@u.Rol</td>
                        <td>
                            <AppBadge Variant="SemanticVariant.Success" ShowIcon="false">@u.Estado</AppBadge>
                        </td>
                        <td>
                            <AppButton Href="/administrador/cuentas/gestionar" Size="ButtonSize.Small" Variant="ButtonVariant.Secondary">Gestionar</AppButton>
                        </td>
                    </RowTemplate>
                </AppTable>
            </ChildContent>
        </AppCard>
    </div>

    <div class="seccion">
        <AppCard Title="Administrar acceso" Subtitle="Los cambios se muestran solo como demostración visual.">
            <ChildContent>
                <div class="ms-feature-grid">
                    <AppInput TValue="string" Label="Nombre de usuario" @bind-Value="usuarioNombre" />
                    <AppSelect TValue="string" Label="Rol" @bind-Value="rolSeleccionado" Options="@opcionesRoles" />
                    <AppSelect TValue="string" Label="Acceso" @bind-Value="accesoSeleccionado" Options="@opcionesAcceso" />
                </div>
                <div class="ms-demo-actions">
                    <AppButton Variant="ButtonVariant.Primary" OnClick="MostrarAviso">Guardar cambios</AppButton>
                </div>
            </ChildContent>
        </AppCard>
    </div>
</div>

@code {
    private string usuarioNombre = "vet.paredes";
    private string rolSeleccionado = "Veterinario";
    private string accesoSeleccionado = "Habilitado";

    private List<SelectOption<string>> opcionesRoles = new()
    {
        new("Administrador", "Administrador"),
        new("Veterinario", "Veterinario"),
        new("Recepcionista", "Recepcionista")
    };

    private List<SelectOption<string>> opcionesAcceso = new()
    {
        new("Habilitado", "Habilitado"),
        new("Deshabilitado", "Deshabilitado")
    };

    private sealed record UsuarioDemo(string Usuario, string Rol, string Estado);

    private readonly List<UsuarioDemo> cuentas = new()
    {
        new("admin", "Administrador", "Habilitado"),
        new("vet.paredes", "Veterinario", "Habilitado"),
        new("recepcion", "Recepcionista", "Habilitado")
    };

    private void MostrarAviso() => Toast.Info("Esta operación se habilitará al integrar el backend.");
}
}