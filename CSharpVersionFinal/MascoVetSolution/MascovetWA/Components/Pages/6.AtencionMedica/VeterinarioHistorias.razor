@page "/veterinario/historias"
@layout MainLayout
@inject ToastService Toast

<PageTitle>Historias clínicas | Mascovet</PageTitle>

<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div>
            <h1>Historias clínicas</h1>
            <p>Consulta cronológica del historial médico por paciente.</p>
        </div>
        <span class="ms-demo-pill">Vista de demostración</span>
    </header>

    <div class="seccion">
        <AppCard Title="Buscar historia clínica" Subtitle="Consulta cronológicamente las atenciones de una mascota.">
            <ChildContent>
                <div class="ms-feature-grid">
                    <AppSelect TValue="string" Label="Paciente / Mascota" @bind-Value="pacienteSeleccionado" Options="@opcionesPacientes" />
                </div>
                <div class="ms-demo-actions">
                    <AppButton Variant="ButtonVariant.Primary" OnClick="MostrarAviso">Buscar historial</AppButton>
                </div>
            </ChildContent>
        </AppCard>
    </div>
</div>

@code {
    private string pacienteSeleccionado = "Luna (Propietario: Ana Martínez)";

    private List<SelectOption<string>> opcionesPacientes = new()
    {
        new("Luna (Propietario: Ana Martínez)", "Luna (Propietario: Ana Martínez)"),
        new("Max (Propietario: Carlos Vega)", "Max (Propietario: Carlos Vega)")
    };

    private void MostrarAviso() => Toast.Info("La búsqueda completa se habilitará al integrar el backend.");
}