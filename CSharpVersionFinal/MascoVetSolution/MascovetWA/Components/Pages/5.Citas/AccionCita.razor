@page "/cliente/citas/{Id:int}/{Accion}"
@page "/recepcion/citas/{Id:int}/{Accion}"
@layout MainLayout
@inject NavigationManager Navigation
@inject ToastService Toast

<PageTitle>Acción sobre cita | Mascovet</PageTitle>

<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div>
            <h1>@(Accion == "reprogramar" ? "Reprogramar cita" : "Cancelar cita")</h1>
            <p>Los datos de la cita seleccionada son de solo lectura.</p>
        </div>
        <span class="ms-demo-pill">Vista de demostración</span>
    </header>

    @if (Cita is null)
    {
        <AppCard Title="Cita no encontrada">
            <p>La cita solicitada no existe en los datos de demostración.</p>
        </AppCard>
    }
    else
    {
        <div class="seccion">
            <AppCard Title="Cita seleccionada" Subtitle="La cita se identifica automáticamente desde la acción del listado.">
                <div class="ms-feature-grid">
                    <AppInput TValue="string" Label="ID de cita" Value="@Id.ToString()" Disabled="true" />
                    <AppInput TValue="string" Label="Mascota" Value="@Cita.Mascota" Disabled="true" />
                    <AppInput TValue="string" Label="Veterinario" Value="@Cita.Veterinario" Disabled="true" />
                    <AppInput TValue="string" Label="Tipo de atención" Value="@Cita.Tipo" Disabled="true" />
                    <AppInput TValue="string" Label="Fecha y hora actuales" Value="@Cita.FechaHora" Disabled="true" />
                    <AppInput TValue="string" Label="Estado actual" Value="@Cita.Estado" Disabled="true" />
                </div>
            </AppCard>
        </div>

        @if (!AccionPermitida)
        {
            <div class="ms-demo-note">
                <AppIcon Name="alert-circle" Size="16" />
                <span>Esta cita no se puede @Accion porque su estado es <strong>@Cita.Estado</strong>.</span>
            </div>
        }
        else if (Accion == "reprogramar")
        {
            <div class="seccion">
                <AppCard Title="Nueva fecha y hora" Subtitle="Solo puedes cambiar el horario de la cita; sus otros datos no se modifican.">
                    <div class="ms-feature-grid">
                        <AppDatePicker Label="Nueva fecha" @bind-Value="nuevaFecha" />
                        <AppInput TValue="string" Label="Nueva hora" Type="time" @bind-Value="nuevaHoraStr" />
                    </div>
                    <div class="ms-demo-actions">
                        <AppButton Variant="ButtonVariant.Primary" OnClick="MostrarAviso">Reprogramar cita</AppButton>
                    </div>
                </AppCard>
            </div>
        }
        else if (Accion == "cancelar")
        {
            <div class="seccion">
                <AppCard Title="Motivo de cancelación" Subtitle="Registra el motivo de la cancelación de la cita seleccionada.">
                    <div class="ms-demo-wide">
                        <AppTextArea Label="Motivo de cancelación" Rows="3" Placeholder="Escribe el motivo" @bind-Value="motivo" />
                    </div>
                    <div class="ms-demo-actions">
                        <AppButton Variant="ButtonVariant.Danger" OnClick="MostrarAviso">Cancelar cita</AppButton>
                    </div>
                </AppCard>
            </div>
        }
    }

    <div class="ms-demo-actions">
        <AppButton Href="@VolverHref" Variant="ButtonVariant.Secondary">Volver a citas</AppButton>
        <AppButton Href="@DisponibilidadHref" Variant="ButtonVariant.Tertiary">Consultar disponibilidad</AppButton>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string Accion { get; set; } = "reprogramar";

    private bool EsCliente => Navigation.ToBaseRelativePath(Navigation.Uri)
        .StartsWith("cliente/", StringComparison.OrdinalIgnoreCase);

    private string VolverHref => EsCliente ? "/cliente/citas" : "/recepcion/citas";
    private string DisponibilidadHref => EsCliente ? "/cliente/disponibilidad" : "/recepcion/disponibilidad";

    private CitaDemo? Cita => (EsCliente, Id) switch
    {
        (true, 101) => new("Luna", "Dra. Lucía Paredes", "Consulta", "29/10/2026 09:00", "Reservada"),
        (true, 102) => new("Max", "Dr. Mateo Silva", "Control", "30/10/2026 11:30", "Confirmada"),
        (false, 101) => new("Luna", "Dra. Lucía Paredes", "Consulta", "29/10/2026 09:00", "Reservada"),
        (false, 102) => new("Max", "Dr. Mateo Silva", "Control", "30/10/2026 11:30", "Confirmada"),
        (false, 103) => new("Nina", "Dra. Lucía Paredes", "Vacunación", "22/10/2026 10:00", "Atendida"),
        (false, 104) => new("Milo", "Dr. Mateo Silva", "Consulta", "20/10/2026 16:00", "Cancelada"),
        _ => null
    };

    private bool AccionPermitida => Cita is not null &&
        ((Accion == "reprogramar" && Cita.Estado == "Reservada") ||
         (Accion == "cancelar" && (Cita.Estado == "Reservada" || Cita.Estado == "Confirmada")));

    private DateOnly? nuevaFecha = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private string nuevaHoraStr = "10:00";
    private string motivo = string.Empty;

    private void MostrarAviso() => Toast.Info("Esta operación se habilitará al integrar el backend.");

    private sealed record CitaDemo(string Mascota, string Veterinario, string Tipo, string FechaHora, string Estado);
}