@page "/cliente/reservar"
@layout MainLayout
@inject ToastService Toast

<PageTitle>Reservar cita | Mascovet</PageTitle>

<div class="reserva-cita">

    <header class="reserva-cita__header">
        <h1>Reservar una cita</h1>
        <p>
            Selecciona tu mascota, el tipo de atención y el horario
            que mejor se adapte a tus necesidades.
        </p>
    </header>

    <div class="reserva-cita__layout">

        <section class="reserva-cita__main"
                 aria-label="Datos de la reserva">

            <AppCard Title="Datos de la cita"
                     Subtitle="Completa los datos para consultar la disponibilidad.">

                <ChildContent>
                    <div class="reserva-cita__fields">

                        <div class="reserva-cita__field">
                            <AppSelect TValue="string"
                                       Id="reserva-mascota"
                                       Label="Mascota"
                                       Placeholder="Selecciona tu mascota"
                                       Required="true"
                                       Options="@OpcionesMascota"
                                       @bind-Value="MascotaSeleccionada"
                                       HelpText="Lista ilustrativa de mascotas registradas." />
                        </div>

                        <div class="reserva-cita__field">
                            <AppSelect TValue="string"
                                       Id="reserva-servicio"
                                       Label="Tipo de atención"
                                       Placeholder="Selecciona el tipo de atención"
                                       Required="true"
                                       Options="@Servicios"
                                       @bind-Value="ServicioSeleccionado" />
                        </div>

                        <div class="reserva-cita__field">
                            <AppSelect TValue="string"
                                       Id="reserva-veterinario"
                                       Label="Veterinario"
                                       Placeholder="Selecciona un veterinario"
                                       Required="true"
                                       Options="@OpcionesVeterinarios"
                                       @bind-Value="VeterinarioSeleccionado"
                                       HelpText="La disponibilidad real se validará con Java." />
                        </div>

                        <div class="reserva-cita__field">
                            <AppDatePicker Id="reserva-fecha"
                                           Label="Fecha de atención"
                                           Required="true"
                                           Min="@FechaMinima"
                                           @bind-Value="FechaSeleccionada"
                                           HelpText="Selecciona una fecha a partir de hoy." />
                        </div>

                    </div>
                </ChildContent>

            </AppCard>

            <AppCard Title="Horarios disponibles"
                     Subtitle="Selecciona una hora de atención.">

                <ChildContent>
                    <div class="reserva-cita__availability">
                        <label class="ms-demo-field">
                            <span>Hora disponible (demostración)</span>
                            <select class="ms-demo-input" @bind="HoraSeleccionada">
                                <option value="">Selecciona una hora</option>
                                <option value="09:00">09:00</option>
                                <option value="10:30">10:30</option>
                                <option value="11:00">11:00</option>
                                <option value="15:30">15:30</option>
                            </select>
                        </label>
                        <p class="ms-demo-muted">Horarios ficticios. Java comprobará disponibilidad y posibles conflictos antes de realizar una reserva real.</p>
                    </div>
                </ChildContent>

            </AppCard>

        </section>

        <aside class="reserva-cita__aside">

            <AppCard Title="Resumen de la reserva"
                     Subtitle="Revisa los datos seleccionados.">

                <ChildContent>
                    <div class="reserva-cita__summary">

                        <div class="reserva-cita__summary-item">
                            <span class="reserva-cita__summary-icon">
                                <AppIcon Name="heart" Size="19" />
                            </span>

                            <div>
                                <span>Mascota</span>
                                <strong>@(string.IsNullOrEmpty(MascotaSeleccionada) ? "Sin seleccionar" : MascotaSeleccionada)</strong>
                            </div>
                        </div>

                        <div class="reserva-cita__summary-item">
                            <span class="reserva-cita__summary-icon">
                                <AppIcon Name="calendar" Size="19" />
                            </span>

                            <div>
                                <span>Fecha</span>
                                <strong>
                                    @(FechaSeleccionada?.ToString("dd/MM/yyyy") ?? "Sin seleccionar")
                                </strong>
                            </div>
                        </div>

                        <div class="reserva-cita__summary-item">
                            <span class="reserva-cita__summary-icon">
                                <AppIcon Name="clock" Size="19" />
                            </span>

                            <div>
                                <span>Horario</span>
                                <strong>@(string.IsNullOrEmpty(HoraSeleccionada) ? "Sin seleccionar" : HoraSeleccionada)</strong>
                            </div>
                        </div>

                        <div class="reserva-cita__summary-item">
                            <span class="reserva-cita__summary-icon">
                                <AppIcon Name="check-circle" Size="19" />
                            </span>

                            <div>
                                <span>Estado inicial</span>
                                <strong>Reservada</strong>
                            </div>
                        </div>

                    </div>
                </ChildContent>

                <Footer>
                    <div class="reserva-cita__summary-actions">

                        <AppButton Href="/cliente/citas"
                                   Variant="ButtonVariant.Secondary">
                            Mis citas
                        </AppButton>

                        <AppButton Type="button"
                                   Variant="ButtonVariant.Primary"
                                   Icon="check-circle"
                                   Disabled="@(!DatosCompletos)"
                                   OnClick="ConfirmarReserva">
                            Confirmar reserva
                        </AppButton>

                    </div>
                </Footer>

            </AppCard>

        </aside>

    </div>

    <div class="reserva-cita__footer">
        <AppButton Href="/cliente"
                   Variant="ButtonVariant.Tertiary"
                   Icon="chevron-left">
            Volver al inicio
        </AppButton>
    </div>

</div>

@code {
    private DateOnly? FechaSeleccionada { get; set; }

    private DateOnly FechaMinima =>
        DateOnly.FromDateTime(DateTime.Today);

    private string MascotaSeleccionada { get; set; } = string.Empty;

    private string ServicioSeleccionado { get; set; } = string.Empty;

    private string VeterinarioSeleccionado { get; set; } = string.Empty;
    private string HoraSeleccionada { get; set; } = string.Empty;
    private bool DatosCompletos => !string.IsNullOrWhiteSpace(MascotaSeleccionada)
        && !string.IsNullOrWhiteSpace(ServicioSeleccionado)
        && !string.IsNullOrWhiteSpace(VeterinarioSeleccionado)
        && FechaSeleccionada.HasValue
        && FechaSeleccionada.Value >= FechaMinima
        && !string.IsNullOrWhiteSpace(HoraSeleccionada);
    private void ConfirmarReserva() => Toast.Info("La reserva es una demostración visual. El registro y la validación de disponibilidad se implementarán en Java.");

    private static readonly List<SelectOption<string>> Servicios =
    [
        new("CONSULTA", "Consulta"),
        new("CONTROL", "Control"),
        new("VACUNACION", "Vacunación"),
        new("CIRUGIA", "Cirugía")
    ];

    private static readonly List<SelectOption<string>> OpcionesMascota = [new("Luna", "Luna"), new("Max", "Max")];
    private static readonly List<SelectOption<string>> OpcionesVeterinarios = [new("Dra. Lucía Paredes", "Dra. Lucía Paredes"), new("Dr. Mateo Silva", "Dr. Mateo Silva")];
}
