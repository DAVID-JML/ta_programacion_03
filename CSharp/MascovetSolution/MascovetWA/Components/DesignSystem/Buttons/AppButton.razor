@if (!string.IsNullOrEmpty(Href) && !Disabled && !Loading)
{
    <a href="@Href" class="@CssClass" @attributes="AdditionalAttributes">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <AppIcon Name="@Icon" Size="@IconSize" />
        }
        @ChildContent
    </a>
}
else
{
    <button type="@Type"
            class="@CssClass"
            disabled="@Disabled"
            aria-disabled="@(Loading ? "true" : null)"
            aria-busy="@(Loading ? "true" : null)"
            @onclick="HandleClick"
            @onclick:preventDefault="Loading"
            @attributes="AdditionalAttributes">
        @if (Loading)
        {
            <span class="ms-btn__spinner" aria-hidden="true"></span>
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <AppIcon Name="@Icon" Size="@IconSize" />
        }
        @ChildContent
    </button>
}

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Icon { get; set; }

    /// <summary>Si se indica, el componente se dibuja como enlace &lt;a&gt; (navegación) en lugar de &lt;button&gt;.</summary>
    [Parameter] public string? Href { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private int IconSize => Size == ButtonSize.Small ? 16 : 18;

    private string CssClass => string.Join(' ', new[]
    {
        "ms-btn",
        $"ms-btn--{Variant.ToCss()}",
        Size == ButtonSize.Small ? "ms-btn--small" : null,
        Loading ? "ms-btn--loading" : null
    }.Where(c => c is not null));

    private async Task HandleClick(MouseEventArgs e)
    {
        if (Disabled || Loading) return;
        await OnClick.InvokeAsync(e);
    }
}