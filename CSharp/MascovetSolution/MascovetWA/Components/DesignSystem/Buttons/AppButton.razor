<button type="@Type"
        class="@CssClass"
        disabled="@Disabled"
        aria-disabled="@(Loading ? "true" : null)"
        aria-busy="@(Loading ? "true" : null)"
        @onclick="HandleClick"
        @onclick:preventDefault="Loading"
        @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <span class="ms-btn__spinner" aria-hidden="true"></span>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <AppIcon Name="@Icon" Size="@(Size == ButtonSize.Small ? 16 : 18)" />
    }
    @ChildContent
</button>

@code {
    /// <summary>Variante visual. Por defecto Primary.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    /// <summary>Tamaño normal (40 px) o pequeño (32 px).</summary>
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;

    /// <summary>Tipo HTML. Por defecto "button" para no enviar formularios por accidente; usa "submit" para enviarlos.</summary>
    [Parameter] public string Type { get; set; } = "button";

    /// <summary>Deshabilita el botón (atributo nativo disabled).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Muestra un indicador de carga e ignora los clics. Mantiene el foco (usa aria-disabled).</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>Nombre de un icono de IconCatalog (opcional).</summary>
    [Parameter] public string? Icon { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.Join(' ', new[]
    {
        "ms-btn",
        $"ms-btn--{Variant.ToCss()}",
        Size == ButtonSize.Small ? "ms-btn--small" : null,
        Loading ? "ms-btn--loading" : null
    }.Where(c => c is not null));

    private async Task HandleClick(MouseEventArgs e)
    {
        if (Disabled || Loading) return;
        await OnClick.InvokeAsync(e);
    }
}
}