@page "/recepcion/mascotas/nueva"
@layout MainLayout
@inject ToastService Toast
<PageTitle>Registrar mascota de cliente | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header">
       <div><h1>Registrar mascota de cliente</h1><p>Formulario utilizado por la recepcionista.</p></div>
       <span class="ms-demo-pill">Vista de demostración</span>
    </header>
    <div class="seccion"><AppCard Title="Registrar mascota" Subtitle="RF012 · Selecciona primero el cliente propietario de la mascota."><ChildContent><div class="ms-feature-grid"><label class="ms-demo-field"><span>Cliente</span><select class="ms-demo-input" ><option value="Ana Martínez López">Ana Martínez López</option><option value="Carlos Vega Ruiz">Carlos Vega Ruiz</option></select></label><label class="ms-demo-field"><span>Nombre de mascota</span><input class="ms-demo-input" type="text" placeholder="" value="" /></label><label class="ms-demo-field"><span>Especie</span><select class="ms-demo-input" ><option value="No especificado">No especificado</option><option value="Perro">Perro</option><option value="Gato">Gato</option><option value="Otro">Otro</option></select></label><label class="ms-demo-field"><span>Raza</span><input class="ms-demo-input" type="text" placeholder="" value="" /></label><label class="ms-demo-field"><span>Sexo</span><select class="ms-demo-input" ><option value="No especificado">No especificado</option><option value="Macho">Macho</option><option value="Hembra">Hembra</option></select></label><label class="ms-demo-field"><span>Fecha de nacimiento</span><input class="ms-demo-input" type="date" placeholder="" value="" /></label></div><div class="ms-demo-actions"><AppButton Variant="ButtonVariant.Primary" OnClick="MostrarAviso">Guardar mascota</AppButton><AppButton Href="/recepcion/mascotas" Variant="ButtonVariant.Secondary">Volver</AppButton></div></ChildContent></AppCard></div>
</div>
@code { // Solo demostración visual: no se guardan cambios ni se consulta una base de datos.
 private void MostrarAviso() => Toast.Info("Esta operación se habilitará al integrar el backend Java."); }
