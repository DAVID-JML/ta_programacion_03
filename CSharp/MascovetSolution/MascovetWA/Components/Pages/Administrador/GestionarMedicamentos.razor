@page "/administrador/medicamentos"
@layout MainLayout
@inject ToastService Toast
<PageTitle>Gestión de medicamentos | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header">
       <div><h1>Gestión de medicamentos</h1><p>Registro, consulta, modificación e inactivación del catálogo.</p></div>
       <span class="ms-demo-pill">Vista de demostración</span>
    </header>
    <div class="seccion"><AppCard Title="Registrar o editar medicamento" Subtitle="RF010 · Catálogo utilizado en las recetas médicas."><ChildContent><div class="ms-feature-grid"><label class="ms-demo-field"><span>Nombre</span><input class="ms-demo-input" type="text" placeholder="" value="" maxlength="100"/></label><label class="ms-demo-field"><span>Fecha de vencimiento</span><input class="ms-demo-input" type="date" placeholder="" value="" /></label><label class="ms-demo-field ms-demo-wide"><span>Descripción</span><textarea class="ms-demo-input" rows="3" placeholder="Escribe aquí..."></textarea></label></div><div class="ms-demo-actions"><AppButton Variant="ButtonVariant.Primary" OnClick="MostrarAviso">Guardar medicamento</AppButton></div></ChildContent></AppCard></div><div class="seccion"><AppCard Title="Medicamentos registrados" Subtitle="Registros de ejemplo para la demostración"><ChildContent><div class="ms-table-wrap"><table class="ms-table"><thead><tr><th scope="col">Medicamento</th><th scope="col">Descripción</th><th scope="col">Vencimiento</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead><tbody><tr><td>Amoxicilina</td><td>Antibiótico veterinario</td><td>15/12/2027</td><td>Activo</td><td><AppButton Size="ButtonSize.Small" Variant="ButtonVariant.Secondary" OnClick="MostrarAviso">Editar / Inactivar</AppButton></td></tr><tr><td>Meloxicam</td><td>Antiinflamatorio</td><td>30/06/2027</td><td>Activo</td><td><AppButton Size="ButtonSize.Small" Variant="ButtonVariant.Secondary" OnClick="MostrarAviso">Editar / Inactivar</AppButton></td></tr></tbody></table></div></ChildContent></AppCard></div>
</div>
@code { // Solo demostración visual: no se guardan cambios ni se consulta una base de datos.
 private void MostrarAviso() => Toast.Info("Esta operación se habilitará al integrar el backend Java."); }
