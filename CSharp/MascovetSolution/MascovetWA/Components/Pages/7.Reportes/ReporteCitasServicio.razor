@page "/administrador/reportes"
@page "/administrador/reportes/servicio"
@page "/administrador/reportes/tipo-atencion"
@using System.ComponentModel.DataAnnotations
@inject ToastService Toast

<PageTitle>Reporte de citas por tipo de atención | Mascovet</PageTitle>

<div class="page-header">
    <h1>Reportes</h1>
    <p class="page-subtitle">Consulta y exporta los reportes de atención de la clínica.</p>
</div>

<div class="acciones acciones--barra">
    <AppButton Href="/administrador/reportes/tipo-atencion" Variant="ButtonVariant.Primary" Icon="bar-chart">
        Citas por tipo de atención
    </AppButton>
    <AppButton Href="/administrador/reportes/especialidad" Variant="ButtonVariant.Secondary" Icon="bar-chart">
        Citas por especialidad
    </AppButton>
    <AppButton Href="/administrador/reportes/historial" Variant="ButtonVariant.Secondary" Icon="file-text">Historial clínico</AppButton>
</div>

<EditForm Model="filtro" OnValidSubmit="Generar">
    <DataAnnotationsValidator />

    <div class="seccion">
        <AppCard Title="Reporte de citas por tipo de atención"
                 Subtitle="Cantidad de citas programadas, atendidas y canceladas, agrupadas por tipo de atención.">
            <div class="form-grid">
                <div class="span-3">
                    <AppDatePicker Label="Fecha de inicio" Required="true" @bind-Value="filtro.FechaInicio" />
                </div>
                <div class="span-3">
                    <AppDatePicker Label="Fecha de fin" Required="true" @bind-Value="filtro.FechaFin" />
                </div>
            </div>

            <div class="acciones acciones--sup">
                <AppButton Type="submit" Variant="ButtonVariant.Primary" Icon="bar-chart">Generar reporte</AppButton>
                <AppButton Variant="ButtonVariant.Secondary"
                           Icon="file-text"
                           OnClick="ExportarPdf">
                    Exportar a PDF
                </AppButton>
                <AppButton Variant="ButtonVariant.Tertiary" OnClick="Limpiar">Limpiar</AppButton>
            </div>
        </AppCard>
    </div>
</EditForm>

<AppCard Title="Resultados">
    <AppTable Items="Pagina(resumen, paginaResumen)"
              ColumnCount="5"
              Caption="Citas programadas, atendidas y canceladas por tipo de atención">
        <HeaderContent>
            <th scope="col">Tipo de atención</th>
            <th scope="col">Programadas</th>
            <th scope="col">Atendidas</th>
            <th scope="col">Canceladas</th>
            <th scope="col">Total</th>
        </HeaderContent>
        <RowTemplate Context="fila">
            <td>@fila.TipoAtencion</td>
            <td>@fila.Programadas</td>
            <td>@fila.Atendidas</td>
            <td>@fila.Canceladas</td>
            <td><strong>@(fila.Programadas + fila.Atendidas + fila.Canceladas)</strong></td>
        </RowTemplate>
        <EmptyContent>
            <AppEmptyState Icon="bar-chart"
                           Title="Sin resultados para mostrar"
                           Description="Selecciona un rango de fechas y presiona «Generar reporte»." />
        </EmptyContent>
    </AppTable>

    <AppPagination @bind-CurrentPage="paginaResumen"
                   TotalItems="resumen.Count"
                   PageSize="TamPagina"
                   AriaLabel="Paginación del reporte" />

    @if (hayResultados)
    {
        <p class="total">
            Total de citas en el rango: <strong>@resumen.Sum(f => f.Programadas + f.Atendidas + f.Canceladas)</strong>
        </p>
    }
</AppCard>

@code {

    private const int TamPagina = 10;

    private FiltroModel filtro = new();
    private int paginaResumen = 1;

    // Resultado del reporte (se llenará al conectar con el backend).
    private readonly List<FilaTipoAtencion> resumen = new();
    private bool hayResultados => resumen.Count > 0;

    private static IEnumerable<T> Pagina<T>(IEnumerable<T> fuente, int pagina) =>
        fuente.Skip((Math.Max(1, pagina) - 1) * TamPagina).Take(TamPagina);

    private void Generar()
    {
        paginaResumen = 1;
        Toast.Info("Rango de fechas validado. Falta conectar el servicio del reporte.");
    }

    private void ExportarPdf()
    {
        Toast.Info("Falta conectar la exportación a PDF.");
    }

    private void Limpiar()
    {
        filtro = new FiltroModel();
        resumen.Clear();
        paginaResumen = 1;
    }

    private sealed record FilaTipoAtencion(string TipoAtencion, int Programadas, int Atendidas, int Canceladas);

    private sealed class FiltroModel : IValidatableObject
    {
        [Required(ErrorMessage = "Ingrese la fecha de inicio.")]
        public DateOnly? FechaInicio { get; set; }

        [Required(ErrorMessage = "Ingrese la fecha de fin.")]
        public DateOnly? FechaFin { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (FechaInicio.HasValue && FechaFin.HasValue && FechaInicio > FechaFin)
                yield return new("La fecha de inicio no puede ser posterior a la fecha de fin.", new[] { nameof(FechaFin) });
        }
    }
}
