@inherits LayoutComponentBase
@inject UserContext User
@inject NavigationManager Navigation

<div class="ms-shell">
    <a class="ms-skip-link" href="#main-content">Saltar al contenido principal</a>

    <aside class="ms-sidebar">
        <NavMenu />
    </aside>

    <div class="ms-main">
        <header class="ms-topbar">
            <div>
                <span class="ms-topbar__caption">@Portal</span>
                <p>Tu mascota, nuestra prioridad.</p>
            </div>

            <div class="ms-topbar__user">
                <span class="ms-topbar__avatar" aria-hidden="true">@Inicial</span>
                <span>
                    <strong>@Nombre</strong>
                    <small>@User.Role</small>
                </span>
            </div>
        </header>

        <main id="main-content" class="ms-content" tabindex="-1">
            @Body
        </main>

        <footer class="ms-footer">
            <span>Mascovet · v1.0</span>
            <span>Proyecto académico · Pontificia Universidad Católica del Perú (PUCP)</span>
        </footer>
    </div>
</div>

<AppToastContainer />

@code {
    protected override void OnInitialized()
    {
        // Sin sesión no se muestra nada de la aplicación: vuelve al login.
        if (!User.IsAuthenticated) Navigation.NavigateTo("/", replace: true);
    }
    private string Nombre => string.IsNullOrWhiteSpace(User.Nombre) ? "Usuario" : User.Nombre;
    private string Inicial => Nombre[..1].ToUpperInvariant();

    private string Portal => User.Role switch
    {
        UserRole.Cliente => "PORTAL DEL CLIENTE",
        UserRole.Recepcionista => "PORTAL DE RECEPCIÓN",
        UserRole.Veterinario => "PORTAL DEL VETERINARIO",
        _ => "PANEL DE ADMINISTRACIÓN"
    };
}