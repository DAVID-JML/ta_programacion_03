@page "/recepcion/citas/nueva"
@inject ClienteRestService ClientesREST
@inject MascotaRestService MascotasREST
@inject VeterinarioRestService VeterinariosREST
@inject ReservaCitaRestService ReservaREST
@inject NavigationManager Navigation
@layout MainLayout
@inject ToastService Toast
@using MascovetWA.Servicios.Validaciones

<PageTitle>Registrar cita | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header"><div><h1>Registrar cita</h1><p>Selecciona un cliente, su mascota y el horario de atención.</p></div></header>
    <AppCard Title="Datos de la reserva">
        <div class="form-grid">
            <div class="span-6"><AppSelect TValue="string" Label="Cliente" Required="true" Options="clientes" @bind-Value="idCliente" @bind-Value:after="CambiarCliente" /></div>
            <div class="span-6"><AppSelect TValue="string" Label="Mascota" Required="true" Options="MascotasCliente" @bind-Value="idMascota" /></div>
            <div class="span-12"><p class="ms-muted">Propietario seleccionado: @NombreClienteSeleccionado</p></div>
            <div class="span-4"><AppSelect TValue="string" Label="Especialidad" Options="especialidades" @bind-Value="especialidad" @bind-Value:after="CambiarEspecialidad" /></div>
            <div class="span-4"><AppSelect TValue="string" Label="Veterinario" Options="VeterinariosPorEspecialidad" @bind-Value="veterinario" @bind-Value:after="CambiarVeterinario" /></div>
            <div class="span-4"><AppSelect TValue="string" Label="Tipo de atención" Options="TiposDisponibles" @bind-Value="tipo" /></div>
            <div class="span-6"><AppDatePicker Label="Fecha de atención" Required="true" @bind-Value="fecha" @bind-Value:after="CargarHoras" /></div>
            <div class="span-6"><AppSelect TValue="string" Label="Hora" Required="true" Placeholder="Selecciona un horario" Options="HorasDisponibles" @bind-Value="hora" /></div>
        </div>
        <div class="acciones">
            <AppButton OnClick="Reservar">Registrar cita</AppButton>
            <AppButton Href="/recepcion/disponibilidad" Variant="ButtonVariant.Secondary">Consultar disponibilidad</AppButton>
            <AppButton Href="/recepcion/citas" Variant="ButtonVariant.Tertiary">Cancelar</AppButton>
        </div>
    </AppCard>
</div>
<AppModal @bind-Visible="mostrarHorarioOcupado" Title="Horario no disponible">
    <ChildContent><p>@(string.IsNullOrWhiteSpace(MensajeConflicto) ? "El horario seleccionado no puede reservarse porque ya no está disponible o el veterinario tiene otra cita. Selecciona una fecha u hora distinta." : MensajeConflicto)</p></ChildContent>
    <Actions><AppButton OnClick="() => mostrarHorarioOcupado = false">Aceptar</AppButton></Actions>
</AppModal>
@code {
    private bool mostrarHorarioOcupado;
    private string? MensajeConflicto;
    [SupplyParameterFromQuery(Name="cliente")] private int? ClienteSeleccionado {get;set;}
    private string idCliente="",idMascota="",especialidad="",veterinario="",tipo="CONSULTA",hora="";
    private DateOnly? fecha;
    private List<SelectOption<string>> clientes=new(),veterinarios=new(),especialidades=new();
    private List<MascovetDomain.Mascotas.Mascota> mascotas=new();
    private List<MascovetDomain.Usuarios.Veterinario> veterinariosDatos=new();
    private IEnumerable<SelectOption<string>> VeterinariosPorEspecialidad => veterinariosDatos
        .Where(v=>v.Especialidad?.ToString()==especialidad)
        .Select(v=>new SelectOption<string>(v.IdUsuario.ToString(),$"{v.Nombre} {v.ApellidoPaterno}".Trim()));
    private async Task CambiarEspecialidad()
    {
        veterinario=VeterinariosPorEspecialidad.FirstOrDefault()?.Value??"";
        await CambiarVeterinario();
    }
    private IEnumerable<SelectOption<string>> TiposDisponibles => tipos.Where(t =>
        Enum.TryParse<MascovetDomain.Enums.TipoAtencion>(t.Value,out var valor) &&
        ReglasCitas.Permite(veterinariosDatos.FirstOrDefault(v=>v.IdUsuario.ToString()==veterinario)?.Especialidad,valor));
    private async Task CambiarVeterinario()
    {
        hora="";
        if (!TiposDisponibles.Any(t=>t.Value==tipo)) tipo=TiposDisponibles.FirstOrDefault()?.Value??"";
        await CargarHoras();
    }
    private string NombreClienteSeleccionado => clientes.FirstOrDefault(c => c.Value == idCliente)?.Text ?? "Selecciona un propietario";
    private void CambiarCliente() { idMascota = MascotasCliente.FirstOrDefault()?.Value ?? ""; }
    private IEnumerable<SelectOption<string>> MascotasCliente=>mascotas.Where(m=>m.Activo && m.Cliente?.IdUsuario.ToString()==idCliente)
        .Select(m=>new SelectOption<string>(m.IdMascota.ToString(),m.Nombre??""));
    private readonly List<SelectOption<string>> tipos=[new("CONSULTA","Consulta"),new("CONTROL","Control"),new("CIRUGIA","Cirugía"),new("VACUNACION","Vacunación")];
    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes=(await ClientesREST.ListarTodosAsync()).Where(x=>x.Activo).Select(x=>new SelectOption<string>(x.IdUsuario.ToString(),$"{x.Nombre} {x.ApellidoPaterno}".Trim())).ToList();
            mascotas=await MascotasREST.ListarTodosAsync();
            var vets=(await VeterinariosREST.ListarTodosAsync()).Where(x=>x.Activo).ToList();
            veterinariosDatos=vets;
            veterinarios=vets.Select(x=>new SelectOption<string>(x.IdUsuario.ToString(),$"{x.Nombre} {x.ApellidoPaterno}".Trim())).ToList();
            especialidades=vets.Where(x=>x.Especialidad.HasValue).Select(x=>x.Especialidad!.Value.ToString()).Distinct().Select(x=>new SelectOption<string>(x,x)).ToList();
            idCliente=ClienteSeleccionado?.ToString()??clientes.FirstOrDefault()?.Value??"";
            idMascota=MascotasCliente.FirstOrDefault()?.Value??"";
            veterinario=veterinarios.FirstOrDefault()?.Value??"";especialidad=especialidades.FirstOrDefault()?.Value??"";
            await CambiarEspecialidad();
            
        }
        catch(Exception ex){Toast.Error($"No se pudieron cargar los datos de la reserva: {ex.Message}");}
    }
    
    private List<SelectOption<string>> HorasDisponibles = new();
    private async Task CargarHoras()
    {
        hora = "";
        HorasDisponibles = new();
        if (!fecha.HasValue || !int.TryParse(veterinario, out int idVet)) return;
        try
        {
            var slots = await ReservaREST.ListarDisponiblesAsync(fecha.Value, idVet);
            HorasDisponibles = slots.Select(s => new SelectOption<string>(s.HoraInicio!.Value.ToString("HH:mm"), s.HoraInicio!.Value.ToString("HH:mm"))).ToList();
        }
        catch (Exception ex) { Toast.Error($"No se pudo consultar la disponibilidad: {ex.Message}"); }
    }
    private async Task Reservar()
    {
        if(!int.TryParse(idMascota,out int im)||!int.TryParse(veterinario,out int iv)||!fecha.HasValue||!TimeOnly.TryParse(hora,out var th))
        {Toast.Warning("Completa mascota, veterinario, fecha y hora.");return;}
        if (!TiposDisponibles.Any(x=>x.Value==tipo))
        { Toast.Warning("El veterinario seleccionado no realiza ese tipo de atención.");return; }
        var seleccionada = mascotas.FirstOrDefault(m => m.IdMascota == im);
        if (seleccionada?.Cliente?.IdUsuario is not > 0 || seleccionada.Cliente.IdUsuario.ToString() != idCliente)
        { Toast.Warning("Selecciona una mascota que pertenezca al cliente indicado."); return; }
        if (fecha.Value < DateOnly.FromDateTime(DateTime.Today))
        { Toast.Warning("La fecha no puede estar en el pasado."); return; }
        if (!HorasDisponibles.Any(h => h.Value == hora))
        { Toast.Warning("Selecciona una hora disponible para la fecha y veterinario."); return; }
        try
        {
            var resultado=await ReservaREST.ReservarAsync(new MascovetDomain.Citas.Cita{
                Mascota=new MascovetDomain.Mascotas.Mascota{IdMascota=im, Cliente=new MascovetDomain.Usuarios.Cliente{IdUsuario=seleccionada.Cliente.IdUsuario}},
                Veterinario=new MascovetDomain.Usuarios.Veterinario{IdUsuario=iv},
                Fecha=fecha.Value.ToDateTime(new TimeOnly(12,0)),Hora=th,
                TipoAtencion=Enum.Parse<MascovetDomain.Enums.TipoAtencion>(tipo),Estado=MascovetDomain.Enums.EstadoCita.RESERVADA});
            if(!resultado.Exito){MensajeConflicto=resultado.Mensaje;mostrarHorarioOcupado=true;await CargarHoras();return;}
            Toast.Success("Cita registrada.");Navigation.NavigateTo("/recepcion/citas");
        }
        catch(Exception ex){Toast.Error($"No se pudo registrar la cita: {ex.Message}");}
    }
}
