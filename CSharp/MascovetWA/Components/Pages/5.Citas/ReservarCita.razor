@page "/cliente/reservar"
@inject MascotaRestService MascotasREST
@inject ClienteRestService ClientesREST
@inject VeterinarioRestService VeterinariosREST
@inject ReservaCitaRestService ReservaREST
@inject UserContext User
@inject NavigationManager Navigation
@layout MainLayout
@inject ToastService Toast
@using MascovetWA.Servicios.Validaciones

<PageTitle>Reservar cita | Mascovet</PageTitle>

<div class="reserva-cita">

    <header class="reserva-cita__header">
        <h1>Reservar una cita</h1>
        <p>
            Selecciona tu mascota, el tipo de atención y el horario
            que mejor se adapte a tus necesidades.
        </p>
    </header>

    <div class="reserva-cita__layout">

        <section class="reserva-cita__main"
                 aria-label="Datos de la reserva">

            <AppCard Title="Datos de la cita"
                     Subtitle="Completa los datos para consultar la disponibilidad.">

                <ChildContent>
                    <div class="reserva-cita__fields">

                        <div class="reserva-cita__field">
                            <AppSelect TValue="string"
                                       Id="reserva-mascota"
                                       Label="Mascota"
                                       Placeholder="Selecciona tu mascota"
                                       Required="true"
                                       Options="@OpcionesMascota"
                                       @bind-Value="MascotaSeleccionada" />
                        </div>

                        <div class="reserva-cita__field">
                            <AppSelect TValue="string"
                                       Id="reserva-servicio"
                                       Label="Tipo de atención"
                                       Placeholder="Selecciona el tipo de atención"
                                       Required="true"
                                       Options="@ServiciosDisponibles"
                                       @bind-Value="ServicioSeleccionado" />
                        </div>

                        <div class="reserva-cita__field">
                            <AppSelect TValue="string"
                                       Id="reserva-veterinario"
                                       Label="Veterinario"
                                       Placeholder="Selecciona un veterinario"
                                       Required="true"
                                       Options="@OpcionesVeterinarios"
                                       @bind-Value="VeterinarioSeleccionado" @bind-Value:after="CambiarVeterinario" />
                        </div>

                        <div class="reserva-cita__field">
                            <AppDatePicker Id="reserva-fecha"
                                           Label="Fecha de atención"
                                           Required="true"
                                           Min="@FechaMinima"
                                           @bind-Value="FechaSeleccionada" @bind-Value:after="CargarHoras"
                                           HelpText="Selecciona una fecha a partir de hoy." />
                        </div>

                    </div>
                </ChildContent>

            </AppCard>

            <AppCard Title="Horarios disponibles"
                     Subtitle="Selecciona una hora de atención.">

                <ChildContent>
                    <div class="reserva-cita__availability">
                        <AppSelect TValue="string"
                                   Label="Hora disponible"
                                   Placeholder="Selecciona una hora"
                                   Required="true"
                                   Options="HorasDisponibles"
                                   @bind-Value="HoraSeleccionada" />
                    </div>
                </ChildContent>

            </AppCard>

        </section>

        <aside class="reserva-cita__aside">

            <AppCard Title="Resumen de la reserva"
                     Subtitle="Revisa los datos seleccionados.">

                <ChildContent>
                    <div class="reserva-cita__summary">

                        <div class="reserva-cita__summary-item">
                            <span class="reserva-cita__summary-icon">
                                <AppIcon Name="heart" Size="19" />
                            </span>

                            <div>
                                <span>Mascota</span>
                                <strong>@(string.IsNullOrEmpty(MascotaSeleccionada) ? "Sin seleccionar" : OpcionesMascota.FirstOrDefault(x=>x.Value==MascotaSeleccionada)?.Text ?? "Sin seleccionar")</strong>
                            </div>
                        </div>

                        <div class="reserva-cita__summary-item">
                            <span class="reserva-cita__summary-icon"><AppIcon Name="user" Size="19" /></span>
                            <div>
                                <span>Propietario</span>
                                <strong>@NombrePropietario</strong>
                            </div>
                        </div>
                        <div class="reserva-cita__summary-item">
                            <span class="reserva-cita__summary-icon">
                                <AppIcon Name="calendar" Size="19" />
                            </span>

                            <div>
                                <span>Fecha</span>
                                <strong>
                                    @(FechaSeleccionada?.ToString("dd/MM/yyyy") ?? "Sin seleccionar")
                                </strong>
                            </div>
                        </div>

                        <div class="reserva-cita__summary-item">
                            <span class="reserva-cita__summary-icon">
                                <AppIcon Name="clock" Size="19" />
                            </span>

                            <div>
                                <span>Horario</span>
                                <strong>@(string.IsNullOrEmpty(HoraSeleccionada) ? "Sin seleccionar" : HoraSeleccionada)</strong>
                            </div>
                        </div>

                        <div class="reserva-cita__summary-item">
                            <span class="reserva-cita__summary-icon">
                                <AppIcon Name="check-circle" Size="19" />
                            </span>

                            <div>
                                <span>Estado inicial</span>
                                <strong>Reservada</strong>
                            </div>
                        </div>

                    </div>
                </ChildContent>

                <Footer>
                    <div class="reserva-cita__summary-actions">

                        <AppButton Href="/cliente/citas"
                                   Variant="ButtonVariant.Secondary">
                            Mis citas
                        </AppButton>

                        <AppButton Type="button"
                                   Variant="ButtonVariant.Primary"
                                   Icon="check-circle"
                                   Disabled="@(!DatosCompletos)"
                                   OnClick="ConfirmarReserva">
                            Confirmar reserva
                        </AppButton>

                    </div>
                </Footer>

            </AppCard>

        </aside>

    </div>

    <div class="reserva-cita__footer">
        <AppButton Href="/cliente"
                   Variant="ButtonVariant.Tertiary"
                   Icon="chevron-left">
            Volver al inicio
        </AppButton>
    </div>

</div>

<AppModal @bind-Visible="mostrarHorarioOcupado" Title="Horario no disponible">
    <ChildContent><p>@(string.IsNullOrWhiteSpace(MensajeConflicto) ? "El horario seleccionado no puede reservarse porque ya no está disponible o el veterinario tiene otra cita. Selecciona una fecha u hora distinta." : MensajeConflicto)</p></ChildContent>
    <Actions><AppButton OnClick="() => mostrarHorarioOcupado = false">Aceptar</AppButton></Actions>
</AppModal>
@code {
    private bool mostrarHorarioOcupado;
    private string? MensajeConflicto;
    [SupplyParameterFromQuery(Name="mascotaId")] private int? IdMascota {get;set;}
    private DateOnly? FechaSeleccionada{get;set;}
    private DateOnly FechaMinima=>DateOnly.FromDateTime(DateTime.Today);
    private string MascotaSeleccionada { get; set; } = "";
    private string ServicioSeleccionado { get; set; } = "";
    private string VeterinarioSeleccionado { get; set; } = "";
    private string HoraSeleccionada { get; set; } = "";
    private List<SelectOption<string>> OpcionesMascota=new(),OpcionesVeterinarios=new();
    private List<MascovetDomain.Usuarios.Veterinario> veterinariosDatos=new();
    private IEnumerable<SelectOption<string>> ServiciosDisponibles => Servicios.Where(x =>
        Enum.TryParse<MascovetDomain.Enums.TipoAtencion>(x.Value,out var servicio) &&
        ReglasCitas.Permite(veterinariosDatos.FirstOrDefault(v => v.IdUsuario.ToString()==VeterinarioSeleccionado)?.Especialidad,servicio));
    private async Task CambiarVeterinario()
    {
        HoraSeleccionada="";
        if (!ServiciosDisponibles.Any(s => s.Value==ServicioSeleccionado)) ServicioSeleccionado="";
        await CargarHoras();
    }
    private List<MascovetDomain.Mascotas.Mascota> mascotasCliente = new();
    private MascovetDomain.Usuarios.Cliente? clienteActual;
    private string NombrePropietario => mascotasCliente.Any(m => m.IdMascota.ToString() == MascotaSeleccionada)
        ? clienteActual?.NombreCompleto ?? "Propietario no identificado" : "Sin seleccionar";
    private static readonly List<SelectOption<string>> Servicios=[new("CONSULTA","Consulta"),new("CONTROL","Control"),new("VACUNACION","Vacunación"),new("CIRUGIA","Cirugía")];
    
    private List<SelectOption<string>> HorasDisponibles = new();
    private async Task CargarHoras()
    {
        HoraSeleccionada = "";
        HorasDisponibles = new();
        if (!FechaSeleccionada.HasValue || !int.TryParse(VeterinarioSeleccionado, out int idVet)) return;
        try
        {
            var slots = await ReservaREST.ListarDisponiblesAsync(FechaSeleccionada.Value, idVet);
            HorasDisponibles = slots.Select(s => new SelectOption<string>(s.HoraInicio!.Value.ToString("HH:mm"), s.HoraInicio!.Value.ToString("HH:mm"))).ToList();
        }
        catch (Exception ex) { Toast.Error($"No se pudo consultar la disponibilidad: {ex.Message}"); }
    }
    private bool DatosCompletos=>int.TryParse(MascotaSeleccionada,out _)&&int.TryParse(VeterinarioSeleccionado,out _)
        &&!string.IsNullOrWhiteSpace(ServicioSeleccionado)&&FechaSeleccionada>=FechaMinima
        &&HorasDisponibles.Any(h=>h.Value==HoraSeleccionada)
        && ServiciosDisponibles.Any(s=>s.Value==ServicioSeleccionado);
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var clientes=(await ClientesREST.ListarTodosAsync()).Where(c=>c.Activo&&
                !string.IsNullOrWhiteSpace(User.UsuarioVinculado) &&
                string.Equals(c.NombreUsuario,User.UsuarioVinculado,StringComparison.OrdinalIgnoreCase)).ToList();
            if(clientes.Count!=1)
            {
                Toast.Warning("La cuenta de prueba no corresponde a un único cliente de MySQL. Vincularemos la cuenta al implementar el inicio de sesión.");
                return;
            }
            clienteActual = clientes[0];
            int idCliente=clienteActual.IdUsuario;
            var m=(await MascotasREST.ListarTodosAsync()).Where(m=>m.Activo&&
                m.Cliente?.IdUsuario==idCliente).ToList();
            mascotasCliente = m;
            OpcionesMascota=m.Select(m=>new SelectOption<string>(m.IdMascota.ToString(),m.Nombre??"")).ToList();
            if(IdMascota.HasValue && m.Any(m=>m.IdMascota==IdMascota.Value))MascotaSeleccionada=IdMascota.Value.ToString();
            veterinariosDatos=(await VeterinariosREST.ListarTodosAsync()).Where(v=>v.Activo).ToList();
            OpcionesVeterinarios=veterinariosDatos.Select(v=>new SelectOption<string>(v.IdUsuario.ToString(),$"{v.Nombre} {v.ApellidoPaterno}".Trim())).ToList();
        }
        catch(Exception ex){Toast.Error($"No se pudo cargar disponibilidad: {ex.Message}");}
    }
    private async Task ConfirmarReserva()
    {
        if(!DatosCompletos||!TimeOnly.TryParse(HoraSeleccionada,out var hora)) {Toast.Warning("Selecciona todos los datos y un horario libre.");return;}
        try
        {
            var mascota = mascotasCliente.FirstOrDefault(m => m.IdMascota == int.Parse(MascotaSeleccionada));
            if (mascota?.Cliente?.IdUsuario is not > 0)
            { Toast.Warning("No se pudo identificar al propietario de la mascota seleccionada."); return; }
            var resultado=await ReservaREST.ReservarAsync(new MascovetDomain.Citas.Cita{
                Mascota=new MascovetDomain.Mascotas.Mascota{IdMascota=mascota.IdMascota,Cliente=new MascovetDomain.Usuarios.Cliente{IdUsuario=mascota.Cliente.IdUsuario}},
                Veterinario=new MascovetDomain.Usuarios.Veterinario{IdUsuario=int.Parse(VeterinarioSeleccionado)},
                TipoAtencion=Enum.Parse<MascovetDomain.Enums.TipoAtencion>(ServicioSeleccionado),
                Fecha=FechaSeleccionada!.Value.ToDateTime(new TimeOnly(12,0)),Hora=hora,Estado=MascovetDomain.Enums.EstadoCita.RESERVADA});
            if(!resultado.Exito){MensajeConflicto=resultado.Mensaje;mostrarHorarioOcupado=true;await CargarHoras();return;}
            Toast.Success("Reserva registrada.");Navigation.NavigateTo("/cliente/citas");
        }
        catch(Exception ex){Toast.Error($"No se pudo reservar: {ex.Message}");}
    }
}