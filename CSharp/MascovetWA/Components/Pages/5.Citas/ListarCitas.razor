@page "/cliente/citas"
@inject CitaRestService CitasREST
@inject MascotaRestService MascotasREST
@inject ClienteRestService ClientesREST
@inject VeterinarioRestService VeterinariosREST
@inject ToastService Toast
@using MascovetWA.Servicios.Validaciones
@inject UserContext User
@layout MainLayout

<PageTitle>Mis citas | Mascovet</PageTitle>

<div class="mis-citas">

    <header class="mis-citas__header">
        <div>
            <h1>Mis citas</h1>
            <p>
                Consulta tus citas veterinarias y revisa el estado
                de cada atención.
            </p>
        </div>

        <AppButton Href="/cliente/reservar"
                   Variant="ButtonVariant.Primary"
                   Icon="plus">
            Reservar cita
        </AppButton>
    </header>

    <section class="mis-citas__content"
             aria-label="Listado de citas">

        @if (cargando) { <p role="status">Cargando tus citas...</p> }
        @if (!string.IsNullOrWhiteSpace(error)) { <p class="ms-muted" role="alert">@error</p> }
        @if (!cargando)
        {
        <AppCard Title="Listado de citas"
                 Subtitle="Consulta las fechas, los tipos de atención y el estado de tus reservas.">

            <ChildContent>
                <AppTable TItem="CitaFila"
                          Items="@Pagina(citas, paginaActual)"
                          ColumnCount="7"
                          Caption="Mis citas veterinarias">

                    <HeaderContent>
                        <th scope="col">Fecha</th>
                        <th scope="col">Hora</th>
                        <th scope="col">Mascota</th>
                        <th scope="col">Tipo de atención</th>
                        <th scope="col">Veterinario</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Acciones</th>
                    </HeaderContent>

                    <RowTemplate Context="cita">
                        <td class="mis-citas__date">
                            @cita.Fecha.ToString("dd/MM/yyyy")
                        </td>

                        <td class="mis-citas__time">
                            @cita.Hora.ToString("HH:mm")
                        </td>

                        <td>
                            <span class="mis-citas__pet">
                                <AppIcon Name="@ObtenerIconoEspecie(cita.Especie)"
                                         Size="18" />
                                <span>@cita.Mascota</span>
                            </span>
                        </td>

                        <td>@cita.Servicio</td>

                        <td>@cita.Veterinario</td>

                        <td>
                            <AppBadge Variant="@VarianteEstado(cita.Estado)"
                                      ShowIcon="false">
                                @cita.Estado
                            </AppBadge>
                        </td>
                        <td>
                            @if (cita.Estado == "RESERVADA")
                            {
                                <AppButton Href="@($"/cliente/citas/{cita.Id}/reprogramar")" Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Reprogramar</AppButton>
                                <AppButton Href="@($"/cliente/citas/{cita.Id}/cancelar")" Variant="ButtonVariant.Danger" Size="ButtonSize.Small">Cancelar</AppButton>
                            }
                            else if (cita.Estado == "CONFIRMADA")
                            {
                                <AppButton Href="@($"/cliente/citas/{cita.Id}/cancelar")" Variant="ButtonVariant.Danger" Size="ButtonSize.Small">Cancelar</AppButton>
                            }
                            else { <span class="ms-muted">Sin acciones disponibles</span> }
                        </td>
                    </RowTemplate>

                    <EmptyContent>
                        <AppEmptyState Icon="calendar"
                                       Title="No hay citas para mostrar"
                                       Description="Aquí aparecerán tus citas cuando se cargue la información de tu cuenta.">

                            <AppButton Href="/cliente/reservar"
                                       Variant="ButtonVariant.Secondary"
                                       Icon="plus">
                                Reservar una cita
                            </AppButton>

                        </AppEmptyState>
                    </EmptyContent>

                </AppTable>
            </ChildContent>

            <Footer>
                <div class="mis-citas__pagination">
                    <AppPagination @bind-CurrentPage="paginaActual"
                                   TotalItems="@citas.Count"
                                   PageSize="@TamPagina"
                                   AriaLabel="Paginación de mis citas" />
                </div>
            </Footer>

        </AppCard>
        }

    </section>

</div>

@code {
    private const int TamPagina=10;
    private int paginaActual=1;
    private List<CitaFila> citas=new();
    private bool cargando = true;
    private string error = "";
    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        try
        {
            // Vinculación temporal de la cuenta de prueba mediante nombre de usuario del SQL.
            var clientes = await ClientesREST.ListarTodosAsync();
            var propios = clientes.Where(c => c.Activo &&
                !string.IsNullOrWhiteSpace(User.UsuarioVinculado) &&
                string.Equals(c.NombreUsuario, User.UsuarioVinculado, StringComparison.OrdinalIgnoreCase)).ToList();
            if (propios.Count != 1)
            {
                error = "No se encontró un cliente único asociado a la cuenta de prueba. No se muestran citas ajenas.";
                return;
            }
            int idCliente = propios[0].IdUsuario;
            var mascotasTask = MascotasREST.ListarTodosAsync();
            var veterinariosTask = VeterinariosREST.ListarTodosAsync();
            var citasTask = CitasREST.ListarTodosAsync();
            await Task.WhenAll(mascotasTask, veterinariosTask, citasTask);
            var mascotas = await mascotasTask;
            var ids = mascotas.Where(m => m.Cliente?.IdUsuario == idCliente).Select(m => m.IdMascota).ToHashSet();
            var veterinarios = await veterinariosTask;
            var todas = await citasTask;
            citas = todas.Where(c => c.Activo && c.Mascota is not null && ids.Contains(c.Mascota.IdMascota))
                .Select(c =>
                {
                    var mascota = mascotas.FirstOrDefault(m => m.IdMascota == c.Mascota?.IdMascota);
                    var vet = veterinarios.FirstOrDefault(v => v.IdUsuario == c.Veterinario?.IdUsuario);
                    return new CitaFila(c.IdCita, DateOnly.FromDateTime(c.Fecha ?? DateTime.Today), c.Hora ?? TimeOnly.MinValue,
                        mascota?.Nombre ?? "Mascota", mascota?.Especie?.ToString() ?? "", c.TipoAtencion?.ToString() ?? "",
                        vet?.NombreCompleto ?? "Veterinario no identificado", c.Estado?.ToString() ?? "");
                }).OrderBy(c=>c.Estado switch { "CONFIRMADA"=>0, "RESERVADA"=>1, "ATENDIDA"=>2, "CANCELADA"=>3, _=>4})
                  .ThenBy(c=>c.Fecha).ThenBy(c=>c.Hora).ToList();
        }
        catch (Exception ex) { error = $"No se pudieron cargar tus citas: {ex.Message}"; Toast.Error(error); }
        finally { cargando = false; }
    }
    private static IEnumerable<T> Pagina<T>(IEnumerable<T> fuente,int pagina)=>fuente.Skip((Math.Max(1,pagina)-1)*TamPagina).Take(TamPagina);
    private static SemanticVariant VarianteEstado(string estado)=>estado switch
    {"RESERVADA"=>SemanticVariant.Warning,"CONFIRMADA"=>SemanticVariant.Success,"ATENDIDA"=>SemanticVariant.Info,"CANCELADA"=>SemanticVariant.Error,_=>SemanticVariant.Neutral};
    private static string ObtenerIconoEspecie(string especie)=>especie.Trim().ToLowerInvariant() switch {"gato"=>"cat","perro"=>"dog",_=>"paw-print"};
    private sealed record CitaFila(int Id,DateOnly Fecha,TimeOnly Hora,string Mascota,string Especie,string Servicio,string Veterinario,string Estado);
}
