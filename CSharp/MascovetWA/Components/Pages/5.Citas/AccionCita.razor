@page "/cliente/citas/{Id:int}/reprogramar"
@inject CitaRestService CitasREST
@inject MascotaRestService MascotasREST
@inject VeterinarioRestService VeterinariosREST
@inject HorarioAtencionRestService HorariosREST
@page "/cliente/citas/{Id:int}/cancelar"
@page "/recepcion/citas/{Id:int}/reprogramar"
@page "/recepcion/citas/{Id:int}/cancelar"
@layout MainLayout
@inject NavigationManager Navigation
@inject ToastService Toast
@using MascovetWA.Servicios.Validaciones

<PageTitle>@Titulo | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header"><div><h1>@Titulo</h1><p>Revisa los datos de la cita antes de continuar.</p></div></header>
    @if (Cita is null)
    {
        <AppCard Title="Cita no encontrada"><p>No se encontró la cita seleccionada.</p></AppCard>
    }
    else
    {
        <AppCard Title="Cita seleccionada">
            <div class="ms-detail-grid">
                <div><span>Código</span><strong>@Id</strong></div><div><span>Mascota</span><strong>@Cita.Mascota</strong></div>
                <div><span>Veterinario</span><strong>@Cita.Veterinario</strong></div><div><span>Tipo de atención</span><strong>@Cita.Tipo</strong></div>
                <div><span>Fecha y hora actual</span><strong>@Cita.FechaHora</strong></div><div><span>Estado</span><strong>@Cita.Estado</strong></div>
            </div>
        </AppCard>
        @if (Reprogramar)
        {
            <AppCard Title="Nuevo horario">
                <div class="form-grid">
                    <div class="span-6"><AppDatePicker Label="Nueva fecha" Required="true" @bind-Value="fecha" @bind-Value:after="ActualizarHorario" /></div>
                    <div class="span-6"><AppSelect TValue="string" Label="Nueva hora disponible" Required="true" Placeholder="Selecciona una hora" Options="HorasDisponibles" @bind-Value="hora" /></div>
                </div>
                @if (!string.IsNullOrWhiteSpace(errorDisponibilidad))
                {
                    <p class="ms-small-note" role="alert">@errorDisponibilidad</p>
                }
                else if (HorasDisponibles.Count == 0)
                {
                    <p class="ms-muted">No hay horas disponibles para esta fecha y veterinario. Selecciona otra fecha.</p>
                }
                <div class="acciones"><AppButton OnClick="Guardar">Reprogramar cita</AppButton><AppButton Href="@Volver" Variant="ButtonVariant.Secondary">Cancelar</AppButton></div>
            </AppCard>
        }
        else
        {
            <AppCard Title="Motivo de cancelación">
                <AppTextArea TValue="string" Label="Motivo" Required="true" @bind-Value="motivo" Rows="3" />
                <div class="acciones"><AppButton Variant="ButtonVariant.Danger" OnClick="Guardar">Cancelar cita</AppButton><AppButton Href="@Volver" Variant="ButtonVariant.Secondary">Volver</AppButton></div>
            </AppCard>
        }
    }
</div>
@code {
    [Parameter] public int Id { get; set; }
    private bool EsCliente => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("cliente/",StringComparison.OrdinalIgnoreCase);
    private bool Reprogramar => Navigation.ToBaseRelativePath(Navigation.Uri).EndsWith("reprogramar",StringComparison.OrdinalIgnoreCase);
    private string Titulo => Reprogramar ? "Reprogramar cita" : "Cancelar cita";
    private string Volver => EsCliente ? "/cliente/citas" : "/recepcion/citas";
    private DateOnly? fecha;private string hora="",motivo="";
    private List<MascovetDomain.Citas.HorarioAtencion> horarios = new();
    private List<MascovetDomain.Citas.Cita> citasOcupadas = new();
    private string? errorDisponibilidad;

    private List<SelectOption<string>> HorasDisponibles
    {
        get
        {
            if (!Reprogramar || !fecha.HasValue || registro?.Veterinario?.IdUsuario is not > 0)
                return new();
            int vet = registro.Veterinario.IdUsuario;
            int diaSemana = ((int)fecha.Value.DayOfWeek + 6) % 7;
            var horas = horarios.Where(h => h.Activo && h.Veterinario?.IdUsuario == vet &&
                    h.Dia.HasValue && (int)h.Dia.Value == diaSemana &&
                    h.HoraInicio.HasValue && h.HoraFin.HasValue)
                .SelectMany(h => Enumerable.Range(0, Math.Max(0,
                    (int)(h.HoraFin!.Value.ToTimeSpan() - h.HoraInicio!.Value.ToTimeSpan()).TotalMinutes / 30))
                    .Select(i => h.HoraInicio!.Value.AddMinutes(i * 30)))
                .Distinct().OrderBy(h => h)
                .Where(h => fecha.Value.ToDateTime(h) > DateTime.Now)
                .Where(h => !citasOcupadas.Any(c => c.IdCita != Id && c.Activo &&
                    (c.Estado is MascovetDomain.Enums.EstadoCita.RESERVADA or MascovetDomain.Enums.EstadoCita.CONFIRMADA) &&
                    c.Veterinario?.IdUsuario == vet && c.Fecha.HasValue &&
                    DateOnly.FromDateTime(c.Fecha.Value) == fecha.Value && c.Hora == h))
                .Select(h => new SelectOption<string>(h.ToString("HH:mm"), h.ToString("HH:mm")));
            return horas.ToList();
        }
    }

    private void ActualizarHorario() => hora = "";
    private MascovetDomain.Citas.Cita? registro;
    private sealed record CitaFila(string Mascota,string Veterinario,string Tipo,string FechaHora,string Estado);
    private CitaFila? Cita;
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            registro=await CitasREST.BuscarPorIdAsync(Id);
            if(registro is null){Cita=null;return;}
            var mascota = (await MascotasREST.ListarTodosAsync()).FirstOrDefault(x => x.IdMascota == registro.Mascota?.IdMascota);
            var vet = (await VeterinariosREST.ListarTodosAsync()).FirstOrDefault(x => x.IdUsuario == registro.Veterinario?.IdUsuario);
            Cita=new(mascota?.Nombre ?? registro.Mascota?.Nombre ?? "Mascota sin nombre",vet?.NombreCompleto ?? "Veterinario sin nombre",
                registro.TipoAtencion?.ToString()??"",$"{registro.Fecha:dd/MM/yyyy} {registro.Hora:HH:mm}",registro.Estado?.ToString()??"");
            fecha=registro.Fecha.HasValue?DateOnly.FromDateTime(registro.Fecha.Value):null;
            hora="";motivo=registro.MotivoCancelacion??"";
            if (Reprogramar)
            {
                try
                {
                    var horariosTask = HorariosREST.ListarTodosAsync();
                    var citasTask = CitasREST.ListarTodosAsync();
                    await Task.WhenAll(horariosTask, citasTask);
                    horarios = await horariosTask;
                    citasOcupadas = await citasTask;
                    errorDisponibilidad = null;
                }
                catch (Exception ex)
                {
                    errorDisponibilidad = $"No se pudo consultar la disponibilidad: {ex.Message}";
                    horarios.Clear();
                    citasOcupadas.Clear();
                }
            }
        }
        catch(Exception ex){Toast.Error($"No se pudo consultar la cita: {ex.Message}");Cita=null;}
    }
    private async Task Guardar()
    {
        if(registro is null)return;
        if(registro.Estado is MascovetDomain.Enums.EstadoCita.CANCELADA or MascovetDomain.Enums.EstadoCita.ATENDIDA)
        {Toast.Warning("La cita ya no admite cambios.");return;}
        if(Reprogramar && (!fecha.HasValue||!TimeOnly.TryParse(hora,out _))){Toast.Warning("Selecciona una fecha y una hora disponible.");return;}
        if(Reprogramar && (!string.IsNullOrWhiteSpace(errorDisponibilidad) || !HorasDisponibles.Any(h => h.Value == hora)))
        {Toast.Warning("El horario seleccionado no está disponible para el veterinario.");return;}
        if(!Reprogramar && string.IsNullOrWhiteSpace(motivo)){Toast.Warning("Ingresa el motivo de cancelación.");return;}
        if(Reprogramar && registro.Estado!=MascovetDomain.Enums.EstadoCita.RESERVADA)
        {Toast.Warning("Java solo permite reprogramar citas en estado RESERVADA.");return;}
        if(Reprogramar && fecha.HasValue && TimeOnly.TryParse(hora, out var horaNueva)
            && fecha.Value.ToDateTime(horaNueva) <= DateTime.Now)
        {Toast.Warning("La nueva fecha y hora deben ser futuras.");return;}
        try
        {
            var mascota = (await MascotasREST.ListarTodosAsync()).FirstOrDefault(x => x.IdMascota == registro.Mascota?.IdMascota);
            if (mascota?.Cliente?.IdUsuario is not > 0)
            { Toast.Warning("No se encontró el propietario de la mascota para actualizar la cita."); return; }
            registro.Mascota = new MascovetDomain.Mascotas.Mascota
            { IdMascota = mascota.IdMascota, Cliente = new MascovetDomain.Usuarios.Cliente { IdUsuario = mascota.Cliente.IdUsuario } };
            if(Reprogramar)
            {
                // Fecha es DATE en MySQL, pero Java la recibe como java.util.Date.
                // Enviar la fecha al mediodía evita que una diferencia de zona horaria
                // cambie el día utilizado por el BO al validar el horario del veterinario.
                registro.Fecha=fecha!.Value.ToDateTime(new TimeOnly(12, 0));
                registro.Hora=TimeOnly.Parse(hora);
            }
            else
            {
                // Cambiar solo estado: conservar la fecha de reserva y normalizar DATE.
                if (registro.Fecha.HasValue) registro.Fecha=ReglasCitas.FechaParaRest(registro.Fecha.Value);
                registro.Estado=MascovetDomain.Enums.EstadoCita.CANCELADA;
                registro.MotivoCancelacion=motivo;
            }
            int result=await CitasREST.ModificarAsync(registro);
            if(result<=0){Toast.Warning("El servidor no confirmó el cambio. Verifica la disponibilidad.");return;}
            Toast.Success(Reprogramar?"Cita reprogramada.":"Cita cancelada.");Navigation.NavigateTo(Volver);
        }
        catch(Exception ex){Toast.Error($"No se pudo actualizar la cita: {ex.Message}");}
    }
}
