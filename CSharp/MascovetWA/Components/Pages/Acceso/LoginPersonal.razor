@page "/autentificar-personal"
@layout AuthLayout

@using System.Text.Json
@using System.ComponentModel.DataAnnotations

@inject AuthRestService AuthRest
@inject UserContext User
@inject NavigationManager Navigation

<PageTitle>Acceso del personal | Mascovet</PageTitle>

<main class="login-page">
    <section class="login-panel" aria-labelledby="login-title">

        <header class="login-brand">
            <div class="login-logo" aria-hidden="true">
                <AppIcon Name="paw-print" Size="28" />
            </div>

            <h1>Mascovet</h1>
            <p class="login-tagline">
                Cuidamos a quienes más quieres.
            </p>
        </header>

        <div class="login-heading">
            <h2 id="login-title">Acceso del personal</h2>
            <p>Ingresa tus credenciales para acceder al sistema.</p>
        </div>

        <EditForm Model="@modelo" OnValidSubmit="@IniciarSesion">
            <DataAnnotationsValidator />

            <div class="login-fields">
                <AppInput TValue="string"
                          Label="Nombre de usuario"
                          Type="text"
                          Placeholder="Ingresa tu nombre de usuario"
                          Required="true"
                          @bind-Value="modelo.Usuario"
                          autocomplete="username" />

                <AppInput TValue="string"
                          Label="Contraseña"
                          Type="password"
                          Placeholder="Ingresa tu contraseña"
                          Required="true"
                          @bind-Value="modelo.Contrasena"
                          autocomplete="current-password" />
            </div>

            <div class="login-submit">
                <AppButton Type="submit"
                           Variant="ButtonVariant.Primary"
                           Size="ButtonSize.Medium"
                           Disabled="@enviando"
                           Loading="@enviando">
                    Iniciar sesión
                </AppButton>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <p class="login-feedback" role="status">
                    @mensaje
                </p>
            }
        </EditForm>

        <footer class="login-footer">
            <span>¿Eres cliente?</span>
            <a href="/">Ingresar como cliente</a>
        </footer>

    </section>

    <p class="login-copyright">
        © 2026 Mascovet. Todos los derechos reservados.
    </p>
</main>

@code {
    private LoginModel modelo = new();

    private bool enviando;
    private string mensaje = string.Empty;

    private async Task IniciarSesion()
    {
        if (enviando)
            return;

        enviando = true;
        mensaje = string.Empty;

        try
        {
            var nombreUsuario = modelo.Usuario.Trim();

            // El personal ingresa mediante nombre de usuario.
            var sesion = await AuthRest.AutenticarPersonalAsync(
                nombreUsuario,
                modelo.Contrasena
            );

            // El backend devuelve null cuando responde 401.
            if (sesion is null)
            {
                mensaje = "Nombre de usuario o contraseña incorrectos.";
                modelo.Contrasena = string.Empty;
                return;
            }

            // Convertimos el rol recibido del backend al enum de Blazor.
            if (!Enum.TryParse<UserRole>(
                    sesion.Rol,
                    ignoreCase: true,
                    out var rol)
                || !Enum.IsDefined(typeof(UserRole), rol))
            {
                mensaje = "El servidor devolvió un rol que la aplicación no reconoce.";
                return;
            }

            // Evitamos que un cliente ingrese mediante el acceso del personal.
            if (rol == UserRole.Cliente)
            {
                mensaje = "Esta página es exclusiva para el personal de Mascovet.";
                return;
            }

            // Actualizamos el contexto de usuario de Blazor.
            User.SignIn(
                rol,
                sesion.Nombre,
                sesion.NombreUsuario,
                sesion.IdUsuario
            );

            // Redirigimos al dashboard correspondiente.
            Navigation.NavigateTo(NavCatalog.HomeFor(rol));
        }
        catch (HttpRequestException)
        {
            mensaje = "No se pudo conectar con el servidor. Intenta nuevamente.";
        }
        catch (JsonException)
        {
            mensaje = "El servidor devolvió una respuesta que no se pudo interpretar.";
        }
        catch (InvalidOperationException)
        {
            mensaje = "El servidor devolvió una respuesta de autenticación vacía.";
        }
        finally
        {
            enviando = false;
        }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Ingresa tu nombre de usuario.")]
        public string Usuario { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa tu contraseña.")]
        public string Contrasena { get; set; } = string.Empty;
    }
}
