@page "/"
@layout AuthLayout
@using System.Text.Json
@inject AuthRestService AuthRest
@inject UserContext User
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión | Mascovet</PageTitle>

<main class="login-page">
    <section class="login-panel" aria-labelledby="login-title">

        <header class="login-brand">
            <div class="login-logo" aria-hidden="true">
                <AppIcon Name="paw-print" Size="28" />
            </div>

            <h1>Mascovet</h1>
            <p class="login-tagline">
                Cuidamos a quienes más quieres.
            </p>
        </header>

        <div class="login-heading">
            <h2 id="login-title">¡Bienvenido!</h2>
            <p>Ingresa tus datos para acceder a tu cuenta.</p>
        </div>

        <EditForm Model="@modelo" OnValidSubmit="@IniciarSesion">
            <DataAnnotationsValidator />

            <div class="login-fields">
                <AppInput TValue="string"
                          Label="Usuario o correo electrónico"
                          Type="text"
                          Placeholder="usuario o nombre@correo.com"
                          Required="true"
                          @bind-Value="modelo.Usuario"
                          autocomplete="username" />

                <AppInput TValue="string"
                          Label="Contraseña"
                          Type="password"
                          Placeholder="Ingresa tu contraseña"
                          Required="true"
                          @bind-Value="modelo.Contrasena"
                          autocomplete="current-password" />
            </div>

            <div class="login-options">
                <a href="#"
                   @onclick="AbrirModalRecuperacion"
                   @onclick:preventDefault="true">
                    ¿Olvidaste tu contraseña?
                </a>
            </div>

            <div class="login-submit">
                <AppButton Type="submit"
                           Variant="ButtonVariant.Primary"
                           Size="ButtonSize.Medium"
                           Disabled="@enviando"
                           Loading="@enviando">
                    Iniciar sesión
                </AppButton>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <p class="login-feedback" role="status">
                    @mensaje
                </p>
            }
        </EditForm>

        <footer class="login-footer">
            <span>¿Todavía no tienes una cuenta?</span>
            <a href="/registro">Crear una cuenta</a>
        </footer>
    </section>

    <p class="login-copyright">
        © 2026 Mascovet. Todos los derechos reservados.
    </p>

    <AppModal @bind-Visible="mostrarModalRecuperacion"
              Title="Recuperar contraseña"
              ConfirmText="Enviar instrucciones"
              CancelText="Cancelar"
              OnConfirm="EnviarSolicitudRecuperacion">

        <p>Ingresa tu correo electrónico para recuperar tu cuenta.</p>

        <AppInput TValue="string"
                  Label="Correo electrónico"
                  Type="email"
                  Placeholder="nombre@correo.com"
                  Required="true"
                  @bind-Value="correoRecuperacion"
                  autocomplete="email" />

        @if (!string.IsNullOrWhiteSpace(errorRecuperacion))
        {
            <p class="login-feedback">
                @errorRecuperacion
            </p>
        }
    </AppModal>
</main>

@code {
    private LoginModel modelo = new();

    private bool enviando;
    private string mensaje = string.Empty;

    private bool mostrarModalRecuperacion;
    private string correoRecuperacion = string.Empty;
    private string errorRecuperacion = string.Empty;

    private void AbrirModalRecuperacion()
    {
        errorRecuperacion = string.Empty;
        mostrarModalRecuperacion = true;
    }

    private void EnviarSolicitudRecuperacion()
    {
        if (!new EmailAddressAttribute().IsValid(correoRecuperacion))
        {
            errorRecuperacion = "Ingresa un correo electrónico válido.";
            return;
        }

        mostrarModalRecuperacion = false;
        mensaje = "El servicio de recuperación de contraseña todavía no está conectado.";
    }

    private async Task IniciarSesion()
    {
        if (enviando)
            return;

        enviando = true;
        mensaje = string.Empty;

        try
        {
            var identificador = modelo.Usuario.Trim();

            AuthRestService.SesionLogin? sesion;

            // Los clientes ingresan con correo.
            // El personal ingresa con nombre de usuario.
            if (identificador.Contains('@'))
            {
                sesion = await AuthRest.AutenticarAsync(
                    identificador,
                    modelo.Contrasena
                );
            }
            else
            {
                sesion = await AuthRest.AutenticarPersonalAsync(
                    identificador,
                    modelo.Contrasena
                );
            }

            // El backend devuelve null cuando responde 401.
            if (sesion is null)
            {
                mensaje = "Usuario o contraseña incorrectos.";
                modelo.Contrasena = string.Empty;
                return;
            }

            // Convertimos el rol recibido del backend al enum de Blazor.
            if (!Enum.TryParse<UserRole>(
                    sesion.Rol,
                    ignoreCase: true,
                    out var rol)
                || !Enum.IsDefined(typeof(UserRole), rol))
            {
                mensaje = "El servidor devolvió un rol que la aplicación no reconoce.";
                return;
            }

            // Actualizamos el contexto de usuario de Blazor.
            User.SignIn(rol, sesion.Nombre);

            // Redirigimos al dashboard correspondiente.
            Navigation.NavigateTo(NavCatalog.HomeFor(rol));
        }
        catch (HttpRequestException)
        {
            mensaje = "No se pudo conectar con el servidor. Intenta nuevamente.";
        }
        catch (JsonException)
        {
            mensaje = "El servidor devolvió una respuesta que no se pudo interpretar.";
        }
        catch (InvalidOperationException)
        {
            mensaje = "El servidor devolvió una respuesta de autenticación vacía.";
        }
        finally
        {
            enviando = false;
        }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Ingresa tu usuario o correo electrónico.")]
        public string Usuario { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa tu contraseña.")]
        public string Contrasena { get; set; } = string.Empty;
    }
}