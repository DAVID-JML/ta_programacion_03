@page "/veterinario/vacunas"
@inject CitaRestService CitasREST
@inject MascotaRestService MascotasREST
@inject ClienteRestService ClientesREST
@inject VacunaRestService VacunasREST
@inject VacunacionRestService VacunacionesREST
@using System.ComponentModel.DataAnnotations
@inject ToastService Toast
@using MascovetWA.Servicios.Validaciones

<PageTitle>Vacunación | Mascovet</PageTitle>

<div class="page-header">
    <h1>Gestionar vacunaciones</h1>
    <p class="page-subtitle">Registra, modifica y anula las vacunaciones aplicadas a la mascota.</p>
</div>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="seccion">
        <AppCard Title="Información de la cita y la mascota">
            <div class="form-grid form-grid--end">
                <div class="span-4">
                    <AppInput TValue="string"
                              Label="ID de la cita"
                              Placeholder="Seleccione una cita"
                              Required="true"
                              Disabled="true"
                              @bind-Value="modelo.IdCita" />
                </div>
                <div class="span-auto">
                    <AppButton Variant="ButtonVariant.Secondary"
                               Icon="search"
                               OnClick="AbrirModalCita">
                        Buscar cita
                    </AppButton>
                </div>
            </div>

            <div class="form-grid">
                <div class="span-6">
                    <AppInput TValue="string" Label="Mascota" Disabled="true" @bind-Value="modelo.Mascota" />
                </div>
                <div class="span-6">
                    <AppInput TValue="string" Label="Dueño" Disabled="true" @bind-Value="modelo.Dueno" />
                </div>
            </div>
        </AppCard>
    </div>

    <div class="seccion">
        <AppCard Title="@(EditandoId.HasValue ? "Modificar vacunación" : "Registro de vacunación")">
            <div class="form-grid">
                <div class="span-6">
                    <AppSelect TValue="int?"
                               Label="Vacuna aplicada"
                               Placeholder="Seleccione una vacuna"
                               Required="true"
                               Options="vacunas"
                               Disabled="@EditandoId.HasValue"
                               @bind-Value="modelo.IdVacuna" />
                </div>
                <div class="span-6">
                    <AppInput TValue="string"
                              Label="Dosis"
                              Placeholder="Ingrese la dosis aplicada"
                              Required="true"
                              maxlength="200"
                              @bind-Value="modelo.Dosis" />
                </div>
            </div>

            <div class="form-grid">
                <div class="span-3">
                    <AppDatePicker Label="Fecha de aplicación" Required="true" @bind-Value="modelo.FechaAplicacion" />
                </div>
                <div class="span-3">
                    <AppDatePicker Label="Fecha de próxima dosis" Required="true" @bind-Value="modelo.ProximaDosis" />
                </div>
                <div class="span-3">
                    <AppInput TValue="string" Type="time" Label="Hora de inicio" Required="true" @bind-Value="modelo.HoraInicio" />
                </div>
                <div class="span-3">
                    <AppInput TValue="string" Type="time" Label="Hora de fin" Required="true" @bind-Value="modelo.HoraFin" />
                </div>
            </div>

            <div class="form-grid">
                <div class="span-12">
                    <AppTextArea TValue="string"
                                 Label="Observaciones"
                                 Rows="3"
                                 maxlength="255"
                                 HelpText="Máximo 255 caracteres."
                                 @bind-Value="modelo.Observaciones" />
                </div>
            </div>

            <div class="acciones acciones--fin acciones--sup">
                <AppButton Variant="ButtonVariant.Tertiary" OnClick="Limpiar">Limpiar</AppButton>
                <AppButton Type="submit" Variant="ButtonVariant.Primary" Disabled="@(!EditandoId.HasValue && !CitaPermiteRegistrar)">
                    @(EditandoId.HasValue ? "Guardar cambios" : "Guardar vacunación")
                </AppButton>
            </div>
        </AppCard>
    </div>
</EditForm>
@if (int.TryParse(modelo.IdCita,out var idCitaVac) && !CitaPermiteRegistrar && !EditandoId.HasValue)
{ <p class="ms-small-note">Esta cita no está confirmada o ya cuenta con una vacunación; solo puedes consultar, editar o anular registros existentes.</p> }

<div class="seccion">
    <AppCard Title="Vacunaciones registradas de la mascota">
        <AppTable Items="Pagina(VacunacionesMascota, paginaVacunaciones)"
                  ColumnCount="6"
                  Caption="Vacunaciones registradas de la mascota">
            <HeaderContent>
                <th scope="col">Vacuna</th>
                <th scope="col">Dosis</th>
                <th scope="col">Fecha de aplicación</th>
                <th scope="col">Próxima dosis</th>
                <th scope="col">Estado</th>
                <th scope="col">Acciones</th>
            </HeaderContent>
            <RowTemplate Context="v">
                <td>@v.Vacuna</td>
                <td>@v.Dosis</td>
                <td>@v.FechaAplicacion.ToString("dd/MM/yyyy")</td>
                <td>@(v.ProximaDosis?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td>
                    <AppBadge Variant="@(v.Anulada ? SemanticVariant.Neutral : SemanticVariant.Success)">
                        @(v.Anulada ? "Anulada" : "Vigente")
                    </AppBadge>
                </td>
                <td>
                    <div class="acciones-fila">
                        <AppButton Size="ButtonSize.Small"
                                   Variant="ButtonVariant.Secondary"
                                   Disabled="@v.Anulada"
                                   OnClick="() => Editar(v)">
                            Editar
                        </AppButton>
                        <AppButton Size="ButtonSize.Small"
                                   Variant="ButtonVariant.Danger"
                                   Disabled="@v.Anulada"
                                   OnClick="() => SolicitarAnulacion(v)">
                            Anular
                        </AppButton>
                    </div>
                </td>
            </RowTemplate>
            <EmptyContent>
                <AppEmptyState Icon="inbox"
                               Title="Sin vacunaciones registradas"
                               Description="Selecciona una cita para ver las vacunaciones de la mascota." />
            </EmptyContent>
        </AppTable>

        <AppPagination @bind-CurrentPage="paginaVacunaciones"
                       TotalItems="VacunacionesMascota.Count()"
                       PageSize="TamPagina"
                       AriaLabel="Paginación de vacunaciones" />
    </AppCard>
</div>

<AppButton Href="/veterinario/atencion" Variant="ButtonVariant.Secondary">Regresar</AppButton>

<AppModal @bind-Visible="mostrarModalCita" Title="Búsqueda de cita">
    <ChildContent>
        <AppFilterBar SearchText="@textoBusquedaCita"
                      SearchTextChanged="BuscarCita"
                      SearchLabel="ID de cita o nombre de mascota"
                      SearchPlaceholder="Buscar cita o mascota…" />

        <AppTable Items="Pagina(CitasFiltradas, paginaCitas)"
                  ColumnCount="6"
                  Caption="Citas disponibles">
            <HeaderContent>
                <th scope="col">ID</th>
                <th scope="col">Fecha</th>
                <th scope="col">Hora</th>
                <th scope="col">Mascota</th>
                <th scope="col">Tipo de atención</th>
                <th scope="col">Acciones</th>
            </HeaderContent>
            <RowTemplate Context="cita">
                <td>@cita.Id</td>
                <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@cita.Hora.ToString("HH:mm")</td>
                <td>@cita.Mascota</td>
                <td>@cita.TipoAtencion</td>
                <td>
                    <AppButton Size="ButtonSize.Small"
                               Variant="ButtonVariant.Secondary"
                               OnClick="() => SeleccionarCita(cita)">
                        Seleccionar
                    </AppButton>
                </td>
            </RowTemplate>
            <EmptyContent>
                <AppEmptyState Icon="calendar"
                               Title="No se encontraron citas"
                               Description="Prueba con otro ID de cita o con el nombre de la mascota." />
            </EmptyContent>
        </AppTable>

        <AppPagination @bind-CurrentPage="paginaCitas"
                       TotalItems="CitasFiltradas.Count()"
                       PageSize="TamPagina"
                       AriaLabel="Paginación de citas" />

    </ChildContent>

    <Actions>
        <AppButton Variant="ButtonVariant.Tertiary" OnClick="CerrarModalCita">Cerrar</AppButton>
    </Actions>
</AppModal>

<AppModal @bind-Visible="mostrarModalAnular"
          Title="Confirmar anulación"
          ConfirmText="Anular"
          ConfirmVariant="ButtonVariant.Danger"
          OnConfirm="ConfirmarAnulacion">
    <p>¿Está seguro de anular el registro de vacunación seleccionado?</p>
    @if (vacunacionSeleccionada is not null)
    {
        <p class="texto-secundario">
            @vacunacionSeleccionada.Vacuna · aplicada el @vacunacionSeleccionada.FechaAplicacion.ToString("dd/MM/yyyy")
        </p>
    }
</AppModal>

@code {

    [SupplyParameterFromQuery(Name = "cita")] private int? IdCitaSeleccionada { get; set; }
    [SupplyParameterFromQuery(Name = "mascota")] private int? IdMascotaSeleccionada { get; set; }
    protected override async Task OnInitializedAsync()
    {
        await Cargar();
        if(IdCitaSeleccionada.HasValue)
        {
            var cita=citas.FirstOrDefault(c=>c.Id==IdCitaSeleccionada.Value);
            if(cita is not null)SeleccionarCita(cita);
        }
        else if(IdMascotaSeleccionada.HasValue)
        {
            var cita=citas.Where(c=>c.IdMascota==IdMascotaSeleccionada.Value &&
                vacunaciones.Any(v=>v.IdCita==c.Id)).OrderByDescending(c=>c.Fecha).FirstOrDefault()
                ?? citas.FirstOrDefault(c=>c.IdMascota==IdMascotaSeleccionada.Value);
            if(cita is not null) SeleccionarCita(cita);
        }
    }
    private async Task Cargar()
    {
        try
        {
            var catalogoVacunas = await VacunasREST.ListarTodosAsync();
            vacunas=catalogoVacunas.Where(v=>v.Activo)
                .Select(v=>new SelectOption<int?>((int?)v.IdVacuna,v.Nombre??"Vacuna sin nombre")).ToList();
            var mascotas = await MascotasREST.ListarTodosAsync();
            var clientes = await ClientesREST.ListarTodosAsync();
            // Se conservan las citas históricas para consultar vacunas previas,
            // pero solo se permiten citas CONFIRMADAS para nuevos registros.
            citas=(await CitasREST.ListarTodosAsync())
                .Where(c=>c.TipoAtencion == MascovetDomain.Enums.TipoAtencion.VACUNACION)
                .Select(c=>
                {
                    var mascota = mascotas.FirstOrDefault(m => m.IdMascota == c.Mascota?.IdMascota);
                    var cliente = clientes.FirstOrDefault(x => x.IdUsuario == mascota?.Cliente?.IdUsuario);
                    return new CitaBusqueda(c.IdCita, c.Mascota?.IdMascota ?? 0,
                        DateOnly.FromDateTime(c.Fecha ?? DateTime.Today), c.Hora ?? TimeOnly.MinValue,
                        mascota?.Nombre ?? "Mascota sin nombre", cliente?.NombreCompleto ?? "Propietario no identificado",
                        c.TipoAtencion?.ToString() ?? "VACUNACION",
                        c.Activo && c.Estado == MascovetDomain.Enums.EstadoCita.CONFIRMADA);
                }).ToList();
            vacunaciones=(await VacunacionesREST.ListarTodosAsync()).Select(v=>
            {
                var vacunaAsociada = v.Vacunas.FirstOrDefault();
                int idVacuna = vacunaAsociada?.IdVacuna ?? 0;
                string? nombreVacuna = vacunaAsociada?.Nombre;
                if (string.IsNullOrWhiteSpace(nombreVacuna) && idVacuna > 0)
                    nombreVacuna = catalogoVacunas.FirstOrDefault(x => x.IdVacuna == idVacuna)?.Nombre;
                // Sin una asociación en VACUNACION_VACUNA no podemos deducir qué vacuna se aplicó.
                if (string.IsNullOrWhiteSpace(nombreVacuna))
                    nombreVacuna = idVacuna > 0 ? $"Vacuna #{idVacuna}" : "Vacuna sin asociar";

                return new VacunacionFila(v.IdAtencion, v.Cita?.IdCita ?? 0,
                    idVacuna, nombreVacuna, v.Dosis ?? "",
                    DateOnly.FromDateTime(v.FechaAplicacion ?? DateTime.Today),
                    v.FechaProximaDosis.HasValue ? DateOnly.FromDateTime(v.FechaProximaDosis.Value) : null,
                    !v.Activo);
            }).ToList();
        }
        catch(Exception ex){Toast.Error($"No se pudieron cargar las vacunaciones: {ex.Message}");}
    }
    private const int TamPagina = 5;

    private VacunacionModel modelo = new();
    private int? EditandoId => modelo.IdVacunacion;

    private List<SelectOption<int?>> vacunas = new();
    private List<VacunacionFila> vacunaciones = new();
    private IEnumerable<VacunacionFila> VacunacionesMascota
    {
        get
        {
            if (!int.TryParse(modelo.IdCita, out int idCita)) return Enumerable.Empty<VacunacionFila>();
            var cita = citas.FirstOrDefault(c => c.Id == idCita);
            if (cita is null) return Enumerable.Empty<VacunacionFila>();
            var idsCitas = citas.Where(c => c.IdMascota == cita.IdMascota).Select(c => c.Id).ToHashSet();
            return vacunaciones.Where(v => idsCitas.Contains(v.IdCita))
                .OrderBy(v=>v.Anulada).ThenByDescending(v=>v.FechaAplicacion);
        }
    }
    private List<CitaBusqueda> citas = new();
    private bool CitaPermiteRegistrar => int.TryParse(modelo.IdCita,out int id) &&
        citas.Any(c=>c.Id==id && c.Confirmada) && !vacunaciones.Any(v=>v.IdCita==id && !v.Anulada);

    private bool mostrarModalCita;
    private bool mostrarModalAnular;
    private VacunacionFila? vacunacionSeleccionada;

    private string? textoBusquedaCita;
    private int paginaCitas = 1;
    private int paginaVacunaciones = 1;

    private IEnumerable<CitaBusqueda> CitasFiltradas =>
        citas.Where(c => (c.Confirmada || vacunaciones.Any(v => v.IdCita == c.Id)) &&
            Coincide(textoBusquedaCita, c.Id.ToString(), c.Mascota, c.Dueno))
            .OrderBy(c=>c.Confirmada?0:1).ThenBy(c=>c.Fecha).ThenBy(c=>c.Hora);

    private static IEnumerable<T> Pagina<T>(IEnumerable<T> fuente, int pagina) =>
        fuente.Skip((Math.Max(1, pagina) - 1) * TamPagina).Take(TamPagina);

    private static bool Coincide(string? texto, params string[] campos) =>
        string.IsNullOrWhiteSpace(texto) ||
        campos.Any(c => c.Contains(texto.Trim(), StringComparison.OrdinalIgnoreCase));

    private void AbrirModalCita() => mostrarModalCita = true;
    private void CerrarModalCita() => mostrarModalCita = false;

    private void BuscarCita(string? texto)
    {
        textoBusquedaCita = texto;
        paginaCitas = 1;
    }

    private void LimpiarBusquedaCita() => BuscarCita(string.Empty);

    private void SeleccionarCita(CitaBusqueda cita)
    {
        modelo.IdCita = cita.Id.ToString();
        modelo.Mascota = cita.Mascota;
        modelo.Dueno = cita.Dueno;
        mostrarModalCita = false;
        paginaVacunaciones = 1;
    }

    private async Task Editar(VacunacionFila v)
    {
        try
        {
            // Al editar una vacuna de otra cita histórica, seleccionamos su cita primero.
            var citaAsociada=citas.FirstOrDefault(c=>c.Id==v.IdCita);
            if (citaAsociada is not null) SeleccionarCita(citaAsociada);
            var registro = await VacunacionesREST.BuscarPorIdAsync(v.Id);
            if (registro is null)
            {
                Toast.Warning("No se encontró la vacunación seleccionada.");
                return;
            }
            modelo.IdVacunacion = v.Id;
            modelo.IdVacuna = v.IdVacuna;
            modelo.Dosis = v.Dosis;
            modelo.FechaAplicacion = v.FechaAplicacion;
            modelo.ProximaDosis = v.ProximaDosis;
            modelo.HoraInicio = registro.HoraInicio?.ToString("HH:mm") ?? "";
            modelo.HoraFin = registro.HoraFin?.ToString("HH:mm") ?? "";
            modelo.Observaciones = registro.Observaciones ?? "";
        }
        catch (Exception ex)
        {
            Toast.Error($"No se pudo consultar la vacunación: {ex.Message}");
        }
    }

    private void Limpiar()
    {
        var cita = (modelo.IdCita, modelo.Mascota, modelo.Dueno);
        modelo = new VacunacionModel
        {
            IdCita = cita.IdCita,
            Mascota = cita.Mascota,
            Dueno = cita.Dueno
        };
    }

    private void SolicitarAnulacion(VacunacionFila v)
    {
        vacunacionSeleccionada = v;
        mostrarModalAnular = true;
    }

    private async Task ConfirmarAnulacion()
    {
        mostrarModalAnular=false;
        if(vacunacionSeleccionada is null)return;
        try
        {
            int result=await VacunacionesREST.EliminarAsync(vacunacionSeleccionada.Id);
            if(result>0){Toast.Success("Vacunación anulada.");await Cargar();}
            else Toast.Warning("No se confirmó la anulación.");
        }
        catch(Exception ex){Toast.Error($"No se pudo anular la vacunación: {ex.Message}");}
        vacunacionSeleccionada=null;
    }

    private async Task Guardar()
    {
        if(!int.TryParse(modelo.IdCita,out int idCita)||!modelo.IdVacuna.HasValue||!modelo.FechaAplicacion.HasValue||
            !TimeOnly.TryParse(modelo.HoraInicio,out var ini)||!TimeOnly.TryParse(modelo.HoraFin,out var fin))
        {Toast.Warning("Completa cita, vacuna, fechas y horas.");return;}
        // Java solo admite registrar vacunaciones en citas CONFIRMADAS.
        if (!modelo.IdVacunacion.HasValue && !CitaPermiteRegistrar)
        {
            Toast.Warning("Selecciona una cita de vacunación confirmada.");
            return;
        }
        if (!modelo.ProximaDosis.HasValue || modelo.ProximaDosis.Value < modelo.FechaAplicacion.Value)
        {
            Toast.Warning("La próxima dosis debe ser igual o posterior a la aplicación.");
            return;
        }
        if (ini >= fin)
        {
            Toast.Warning("La hora de inicio debe ser anterior a la de fin.");
            return;
        }
        try
        {
            var v=modelo.IdVacunacion.HasValue ? await VacunacionesREST.BuscarPorIdAsync(modelo.IdVacunacion.Value)
                ?? new MascovetDomain.AtencionesMedicas.Vacunacion() : new MascovetDomain.AtencionesMedicas.Vacunacion();
            v.Cita=new MascovetDomain.Citas.Cita{IdCita=idCita};v.Dosis=modelo.Dosis;
            v.FechaAplicacion=modelo.FechaAplicacion.Value.ToDateTime(TimeOnly.MinValue);
            v.FechaProximaDosis=modelo.ProximaDosis?.ToDateTime(TimeOnly.MinValue);
            v.HoraInicio=ini;v.HoraFin=fin;v.Observaciones=modelo.Observaciones;
            // No cambiamos la vacuna de un registro existente: el UPDATE Java
            // solo modifica los datos de la vacunación, no la tabla asociativa.
            if (modelo.IdVacunacion.HasValue &&
                v.Vacunas.FirstOrDefault()?.IdVacuna != modelo.IdVacuna.Value)
            {
                Toast.Warning("La vacuna asociada no se puede cambiar desde este formulario.");
                return;
            }
            // Al asociar una vacuna EXISTENTE, el DAO Java utiliza su ID.
            // No se debe llamar a insertarConVacunas (ese método valida nombre y descripción).
            if (!modelo.IdVacunacion.HasValue)
            {
                v.AgregarVacuna(new MascovetDomain.AtencionesMedicas.Vacuna
                {
                    IdVacuna = modelo.IdVacuna.Value
                });
            }
            int result = modelo.IdVacunacion.HasValue
                ? await VacunacionesREST.ModificarAsync(v)
                : await VacunacionesREST.InsertarAsync(v);
            if(result<=0){Toast.Warning("No se confirmó el registro de vacunación.");return;}
            Toast.Success("Vacunación guardada.");
            // Si es una nueva vacunación, la cita se marca ATENDIDA.
            if (!modelo.IdVacunacion.HasValue)
            {
                try
                {
                    var citaReal=await CitasREST.BuscarPorIdAsync(idCita);
                    var m=await MascotasREST.BuscarPorIdAsync(citaReal?.Mascota?.IdMascota??0);
                    if (citaReal is not null && m?.Cliente?.IdUsuario is > 0)
                    {
                        citaReal.Mascota=new MascovetDomain.Mascotas.Mascota
                        { IdMascota=m.IdMascota,Cliente=new MascovetDomain.Usuarios.Cliente{IdUsuario=m.Cliente.IdUsuario}};
                        if (citaReal.Fecha.HasValue) citaReal.Fecha=ReglasCitas.FechaParaRest(citaReal.Fecha.Value);
                        citaReal.Estado=MascovetDomain.Enums.EstadoCita.ATENDIDA;
                        if (await CitasREST.ModificarAsync(citaReal)<=0)
                            Toast.Warning("Vacunación guardada, pero la cita no pasó a ATENDIDA.");
                    }
                    else Toast.Warning("Vacunación guardada, pero faltan datos para actualizar la cita.");
                }
                catch (Exception ex) {Toast.Warning($"Vacunación guardada; no se pudo actualizar la cita: {ex.Message}");}
            }
            Limpiar();await Cargar();
        }
        catch(Exception ex){Toast.Error($"No se pudo guardar la vacunación: {ex.Message}");}
    }

    private sealed record CitaBusqueda(int Id, int IdMascota, DateOnly Fecha, TimeOnly Hora, string Mascota, string Dueno, string TipoAtencion, bool Confirmada);

    private sealed record VacunacionFila(int Id, int IdCita, int IdVacuna, string Vacuna, string Dosis,
                                         DateOnly FechaAplicacion, DateOnly? ProximaDosis, bool Anulada);

    private sealed class VacunacionModel : IValidatableObject
    {
        public int? IdVacunacion { get; set; }

        [Required(ErrorMessage = "Seleccione una cita.")]
        public string IdCita { get; set; } = string.Empty;
        public string Mascota { get; set; } = string.Empty;
        public string Dueno { get; set; } = string.Empty;

        [Required(ErrorMessage = "Seleccione la vacuna aplicada.")]
        public int? IdVacuna { get; set; }

        [Required(ErrorMessage = "Ingrese la dosis aplicada.")]
        [StringLength(200, ErrorMessage = "La dosis no debe exceder los 200 caracteres.")]
        public string Dosis { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingrese la fecha de aplicación.")]
        public DateOnly? FechaAplicacion { get; set; }

        [Required(ErrorMessage = "Ingrese la fecha de próxima dosis.")]
        public DateOnly? ProximaDosis { get; set; }

        [Required(ErrorMessage = "Ingrese la hora de inicio.")]
        public string HoraInicio { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingrese la hora de fin.")]
        public string HoraFin { get; set; } = string.Empty;

        [StringLength(255, ErrorMessage = "Las observaciones no deben exceder los 255 caracteres.")]
        public string Observaciones { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (string.CompareOrdinal(HoraInicio, HoraFin) >= 0)
                yield return new("La hora de inicio debe ser anterior a la hora de fin.", new[] { nameof(HoraFin) });

            if (FechaAplicacion.HasValue && ProximaDosis.HasValue && ProximaDosis <= FechaAplicacion)
                yield return new("La próxima dosis debe ser posterior a la fecha de aplicación.", new[] { nameof(ProximaDosis) });
        }
    }
}
