@page "/veterinario/agenda"
@inject CitaRestService CitasREST
@inject MascotaRestService MascotasREST
@inject VeterinarioRestService VeterinariosREST
@inject UserContext User
@inject ToastService Toast
@inject ConsultaRestService ConsultasREST
@inject ControlRestService ControlesREST
@inject CirugiaRestService CirugiasREST
@inject VacunacionRestService VacunacionesREST
@using MascovetWA.Servicios.Validaciones
@layout MainLayout

<PageTitle>Agenda médica | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div><h1>Agenda médica</h1><p>Citas asignadas al veterinario y acceso directo a la atención de cada mascota.</p></div>
        <AppButton Href="/veterinario/historias" Variant="ButtonVariant.Secondary">Consultar historias clínicas</AppButton>
    </header>
    <AppCard Title="Citas registradas">
        @if (!string.IsNullOrWhiteSpace(errorCarga))
        {
            <p role="alert">@errorCarga</p>
            <div class="acciones"><AppButton Variant="ButtonVariant.Secondary" OnClick="Cargar">Reintentar consulta</AppButton></div>
        }
        <AppTable Items="Citas" Caption="Agenda del veterinario" ColumnCount="7">
            <HeaderContent><th>Fecha</th><th>Hora</th><th>Mascota</th><th>Tipo de atención</th><th>Estado</th><th>Ficha</th><th>Acciones</th></HeaderContent>
            <RowTemplate Context="c">
                <td>@c.Fecha</td><td>@c.Hora</td><td>@c.Mascota</td><td>@c.Tipo</td>
                <td><AppBadge Variant="@(c.Estado == "CONFIRMADA" ? SemanticVariant.Success : SemanticVariant.Info)" ShowIcon="false">@c.Estado</AppBadge></td>
                <td><div class="ms-inline-actions">
                    <AppButton Href="@($"/veterinario/mascotas/{c.IdMascota}")" Variant="ButtonVariant.Tertiary" Size="ButtonSize.Small">Ver ficha</AppButton>
                    <AppButton Href="@($"/veterinario/mascotas/{c.IdMascota}/cartilla")" Variant="ButtonVariant.Tertiary" Size="ButtonSize.Small">Cartilla</AppButton>
                </div></td>
                <td>
                    @if (c.Estado == "CONFIRMADA")
                    {
                        @if (c.Tipo == "VACUNACION")
                        {
                            <AppButton Href="@($"/veterinario/vacunas?cita={c.Id}")" Size="ButtonSize.Small">Registrar vacunación</AppButton>
                        }
                        else
                        {
                            <AppButton Href="@($"/veterinario/atencion?cita={c.Id}")" Size="ButtonSize.Small">Registrar atención</AppButton>
                        }
                    }
                    else if (c.Estado == "ATENDIDA" && c.IdAtencion.HasValue)
                    {
                        <div class="ms-inline-actions">
                            <AppButton Href="@($"/veterinario/atenciones/ver/{c.IdAtencion}?tipo={Uri.EscapeDataString(c.Tipo)}")" Variant="ButtonVariant.Tertiary" Size="ButtonSize.Small">Ver atención</AppButton>
                            @if (c.Tipo == "VACUNACION")
                            { <AppButton Href="@($"/veterinario/vacunas?cita={c.Id}")" Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Editar / Anular vacuna</AppButton> }
                            else
                            { <AppButton Href="@($"/veterinario/atencion/{c.IdAtencion}?tipo={c.Tipo}")" Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Editar atención</AppButton> }
                        </div>
                    }
                    else if (c.Estado == "ATENDIDA")
                    { <span class="ms-muted">No se encontró una atención registrada para esta cita.</span> }
                    else { <span class="ms-muted">@(c.Estado == "CANCELADA" ? "Cancelada" : "Pendiente de confirmación")</span> }
                </td>
            </RowTemplate>
        </AppTable>
    </AppCard>
</div>
@code {
    private sealed record AgendaFila(int Id,int IdMascota,string Fecha,string Hora,string Mascota,string Tipo,string Estado,int? IdAtencion);
    private List<AgendaFila> Citas = new();
    private string errorCarga = "";
    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        errorCarga = "";
        try
        {
            // En esta entrega, la cuenta de prueba se vincula por el nombre de usuario con un veterinario del SQL.
            // Sin esa vinculación nunca mostramos citas de otros médicos como si fueran propias.
            var propios = (await VeterinariosREST.ListarTodosAsync()).Where(v => v.Activo &&
                !string.IsNullOrWhiteSpace(User.UsuarioVinculado) &&
                string.Equals(v.NombreUsuario, User.UsuarioVinculado, StringComparison.OrdinalIgnoreCase)).ToList();
            if (propios.Count != 1)
            {
                Citas.Clear();
                errorCarga = "La cuenta de prueba no está asociada a un veterinario único en MySQL.";
                return;
            }
            int idVeterinario = propios[0].IdUsuario;
            var citas = await CitasREST.ListarTodosAsync();
            // Una falla al consultar mascotas no debe ocultar las citas que sí devolvió Java.
            List<MascovetDomain.Mascotas.Mascota> mascotas = new();
            try { mascotas = await MascotasREST.ListarTodosAsync(); }
            catch (Exception ex) { Toast.Warning($"No se pudieron consultar los nombres de mascotas: {ex.Message}"); }
            var atencionesPorCita = new Dictionary<int,int>();
            // Cada recurso tiene su propio contador de IDs; se asocia por cita.
            try { foreach (var a in await ConsultasREST.ListarTodosAsync()) if(a.Activo && a.Cita?.IdCita is > 0) atencionesPorCita[a.Cita.IdCita]=a.IdAtencion; }
            catch (Exception ex) { Toast.Warning($"No se cargaron consultas: {ex.Message}"); }
            try { foreach (var a in await ControlesREST.ListarTodosAsync()) if(a.Activo && a.Cita?.IdCita is > 0) atencionesPorCita[a.Cita.IdCita]=a.IdAtencion; }
            catch (Exception ex) { Toast.Warning($"No se cargaron controles: {ex.Message}"); }
            try { foreach (var a in await CirugiasREST.ListarTodosAsync()) if(a.Activo && a.Cita?.IdCita is > 0) atencionesPorCita[a.Cita.IdCita]=a.IdAtencion; }
            catch (Exception ex) { Toast.Warning($"No se cargaron cirugías: {ex.Message}"); }
            try { foreach (var a in await VacunacionesREST.ListarTodosAsync()) if(a.Activo && a.Cita?.IdCita is > 0) atencionesPorCita[a.Cita.IdCita]=a.IdAtencion; }
            catch (Exception ex) { Toast.Warning($"No se cargaron vacunaciones: {ex.Message}"); }
            Citas = citas.Where(c => c.Activo && c.Veterinario?.IdUsuario == idVeterinario)
                .OrderBy(c=>ReglasCitas.Prioridad(c.Estado)).ThenBy(c => c.Fecha).ThenBy(c => c.Hora)
                .Select(c =>
                {
                    int idMascota = c.Mascota?.IdMascota ?? 0;
                    var mascota = mascotas.FirstOrDefault(m => m.IdMascota == idMascota);
                    string nombre = mascota?.Nombre ?? (idMascota > 0 ? $"Mascota #{idMascota}" : "Sin mascota asociada");
                    return new AgendaFila(c.IdCita, idMascota, c.Fecha?.ToString("dd/MM/yyyy") ?? "",
                        c.Hora?.ToString("HH:mm") ?? "", nombre,
                        c.TipoAtencion?.ToString() ?? "", c.Estado?.ToString() ?? "",
                        atencionesPorCita.TryGetValue(c.IdCita,out var idAtencion) ? (int?)idAtencion : null);
                }).ToList();
        }
        catch (Exception ex)
        {
            errorCarga = $"No se pudo cargar la agenda desde REST: {ex.Message}";
            Toast.Error(errorCarga);
        }
    }
}
