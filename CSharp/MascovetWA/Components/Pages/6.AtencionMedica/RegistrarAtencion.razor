@page "/veterinario/atencion"
@inject CitaRestService CitasREST
@inject MascotaRestService MascotasREST
@inject ClienteRestService ClientesREST
@inject ConsultaRestService ConsultasREST
@inject ControlRestService ControlesREST
@inject CirugiaRestService CirugiasREST
@inject NavigationManager Navigation
@page "/veterinario/atencion/{IdAtencion:int}"
@using System.ComponentModel.DataAnnotations
@inject ToastService Toast
@using MascovetWA.Servicios.Validaciones

<PageTitle>@Titulo | Mascovet</PageTitle>

<div class="page-header">
    <h1>@Titulo</h1>
    <p class="page-subtitle">Registra una consulta, control o cirugía realizada a la mascota.</p>
</div>

<EditForm Model="modelo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="seccion">
        <AppCard Title="Información de la cita">
            <div class="form-grid form-grid--end">
                <div class="span-4">
                    <AppInput TValue="string"
                              Label="ID de la cita"
                              Placeholder="Seleccione una cita"
                              Required="true"
                              Disabled="true"
                              @bind-Value="modelo.IdCita" />
                </div>
                <div class="span-auto">
                    <AppButton Variant="ButtonVariant.Secondary"
                               Icon="search"
                               Disabled="@EsEdicion"
                               OnClick="AbrirModalCita">
                        Buscar cita
                    </AppButton>
                </div>
            </div>

            <div class="form-grid">
                <div class="span-6">
                    <AppInput TValue="string" Label="Mascota" Disabled="true" @bind-Value="modelo.Mascota" />
                </div>
                <div class="span-6">
                    <AppInput TValue="string" Label="Dueño" Disabled="true" @bind-Value="modelo.Dueno" />
                </div>
            </div>
        </AppCard>
    </div>

    <div class="seccion">
        <AppCard Title="Datos generales de la atención">
            <div class="form-grid">
                <div class="span-4">
                    <AppSelect TValue="string"
                               Label="Tipo de atención"
                               Required="true"
                               Disabled="@EsEdicion"
                               Options="tiposAtencion"
                               @bind-Value="modelo.Tipo" />
                </div>
                <div class="span-3">
                    <AppInput TValue="string" Type="time" Label="Hora de inicio" Required="true" @bind-Value="modelo.HoraInicio" />
                </div>
                <div class="span-3">
                    <AppInput TValue="string" Type="time" Label="Hora de fin" Required="true" @bind-Value="modelo.HoraFin" />
                </div>
                <div class="span-2">
                    <AppInput TValue="double"
                              Type="number"
                              Label="Peso actual (kg)"
                              step="0.01"
                              min="0"
                              @bind-Value="modelo.PesoActual" />
                </div>
            </div>

            <div class="form-grid">
                <div class="span-6">
                    <AppTextArea TValue="string"
                                 Label="Alergias"
                                 Rows="3"
                                 maxlength="500"
                                 HelpText="Máximo 500 caracteres."
                                 @bind-Value="modelo.Alergias" />
                </div>
                <div class="span-6">
                    <AppTextArea TValue="string"
                                 Label="Observaciones"
                                 Rows="3"
                                 maxlength="255"
                                 HelpText="Máximo 255 caracteres."
                                 @bind-Value="modelo.Observaciones" />
                </div>
            </div>
        </AppCard>
    </div>

    <div class="seccion">
        @if (EsConsulta)
        {
            <AppCard Title="Detalle de la consulta">
                <div class="form-grid">
                    <div class="span-12">
                        <AppTextArea TValue="string" Label="Motivo de consulta" Required="true" Rows="2"
                                     maxlength="400" HelpText="Máximo 400 caracteres."
                                     @bind-Value="modelo.MotivoConsulta" />
                    </div>
                    <div class="span-6">
                        <AppTextArea TValue="string" Label="Diagnóstico" Required="true" Rows="4"
                                     maxlength="400" HelpText="Máximo 400 caracteres."
                                     @bind-Value="modelo.Diagnostico" />
                    </div>
                    <div class="span-6">
                        <AppTextArea TValue="string" Label="Tratamiento" Required="true" Rows="4"
                                     maxlength="400" HelpText="Máximo 400 caracteres."
                                     @bind-Value="modelo.Tratamiento" />
                    </div>
                </div>
            </AppCard>
        }
        else if (EsControl)
        {
            <AppCard Title="Detalle del control">
                <div class="form-grid">
                    <div class="span-6">
                        <AppTextArea TValue="string" Label="Evolución" Required="true" Rows="4"
                                     maxlength="500" HelpText="Máximo 500 caracteres."
                                     @bind-Value="modelo.Evolucion" />
                    </div>
                    <div class="span-6">
                        <AppTextArea TValue="string" Label="Indicaciones" Required="true" Rows="4"
                                     maxlength="500" HelpText="Máximo 500 caracteres."
                                     @bind-Value="modelo.Indicaciones" />
                    </div>
                </div>
            </AppCard>
        }
        else
        {
            <AppCard Title="Detalle de la cirugía">
                <div class="form-grid">
                    <div class="span-6">
                        <AppTextArea TValue="string" Label="Procedimiento" Required="true" Rows="4"
                                     maxlength="500" HelpText="Máximo 500 caracteres."
                                     @bind-Value="modelo.Procedimiento" />
                    </div>
                    <div class="span-6">
                        <AppTextArea TValue="string" Label="Indicaciones postoperatorias" Required="true" Rows="4"
                                     maxlength="500" HelpText="Máximo 500 caracteres."
                                     @bind-Value="modelo.IndicacionesPostoperatorias" />
                    </div>
                </div>
            </AppCard>
        }
    </div>

    <div class="acciones acciones--entre">
        <AppButton Href="/veterinario/agenda" Variant="ButtonVariant.Secondary">Regresar</AppButton>

        <div class="acciones">
            <AppButton Href="@HrefReceta" Variant="ButtonVariant.Tertiary">Generar receta</AppButton>
            <AppButton Type="submit" Variant="ButtonVariant.Primary" Disabled="@guardando" Loading="@guardando">@(EsEdicion ? "Guardar cambios" : "Guardar atención")</AppButton>
        </div>
    </div>
</EditForm>

<AppModal @bind-Visible="mostrarModalCita" Title="Búsqueda de cita">
    <ChildContent>
        <AppFilterBar SearchText="@textoBusquedaCita"
                      SearchTextChanged="BuscarCita"
                      SearchLabel="ID de cita o nombre de mascota"
                      SearchPlaceholder="Buscar cita o mascota…" />

        <AppTable Items="Pagina(CitasFiltradas, paginaCitas)"
                  ColumnCount="6"
                  Caption="Citas disponibles para registrar la atención">
            <HeaderContent>
                <th scope="col">ID</th>
                <th scope="col">Fecha</th>
                <th scope="col">Hora</th>
                <th scope="col">Mascota</th>
                <th scope="col">Tipo de atención</th>
                <th scope="col">Acciones</th>
            </HeaderContent>
            <RowTemplate Context="cita">
                <td>@cita.Id</td>
                <td>@cita.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@cita.Hora.ToString("HH:mm")</td>
                <td>@cita.Mascota</td>
                <td>@cita.Servicio</td>
                <td>
                    <AppButton Size="ButtonSize.Small"
                               Variant="ButtonVariant.Secondary"
                               OnClick="() => SeleccionarCita(cita)">
                        Seleccionar
                    </AppButton>
                </td>
            </RowTemplate>
            <EmptyContent>
                <AppEmptyState Icon="calendar"
                               Title="No se encontraron citas"
                               Description="Prueba con otro ID de cita o con el nombre de la mascota." />
            </EmptyContent>
        </AppTable>

        <AppPagination @bind-CurrentPage="paginaCitas"
                       TotalItems="CitasFiltradas.Count()"
                       PageSize="TamPagina"
                       AriaLabel="Paginación de citas" />

    </ChildContent>

    <Actions>
        <AppButton Variant="ButtonVariant.Tertiary" OnClick="CerrarModalCita">Cerrar</AppButton>
    </Actions>
</AppModal>

@code {

    [Parameter]
    public int? IdAtencion { get; set; }

    [SupplyParameterFromQuery(Name = "cita")] private int? IdCitaSeleccionada { get; set; }
    [SupplyParameterFromQuery(Name = "tipo")] private string? TipoEdicion { get; set; }
    private bool guardando;
    private HashSet<int> citasYaAtendidas=new();
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var datos = await CitasREST.ListarTodosAsync();
            var mascotas = await MascotasREST.ListarTodosAsync();
            var clientes = await ClientesREST.ListarTodosAsync();
            citas = datos.Where(c => c.Activo &&
                c.TipoAtencion is MascovetDomain.Enums.TipoAtencion.CONSULTA or
                    MascovetDomain.Enums.TipoAtencion.CONTROL or MascovetDomain.Enums.TipoAtencion.CIRUGIA)
                .Select(c=>
                {
                    var mascota = mascotas.FirstOrDefault(m => m.IdMascota == c.Mascota?.IdMascota);
                    var cliente = clientes.FirstOrDefault(x => x.IdUsuario == mascota?.Cliente?.IdUsuario);
                    return new CitaBusqueda(c.IdCita, DateOnly.FromDateTime(c.Fecha ?? DateTime.Today),
                        c.Hora ?? TimeOnly.MinValue, mascota?.Nombre ?? "Mascota sin nombre",
                        cliente?.NombreCompleto ?? "Propietario no identificado",
                        c.Estado==MascovetDomain.Enums.EstadoCita.CONFIRMADA,
                        c.TipoAtencion switch { MascovetDomain.Enums.TipoAtencion.CONSULTA => "Consulta",
                            MascovetDomain.Enums.TipoAtencion.CONTROL => "Control",
                            MascovetDomain.Enums.TipoAtencion.CIRUGIA => "Cirugia", _ => "Vacunación" });
                }).OrderBy(c=>c.Fecha).ThenBy(c=>c.Hora).ToList();
            try
            {
                citasYaAtendidas=(await ConsultasREST.ListarTodosAsync()).Where(a=>a.Activo && a.Cita is not null).Select(a=>a.Cita!.IdCita)
                    .Concat((await ControlesREST.ListarTodosAsync()).Where(a=>a.Activo && a.Cita is not null).Select(a=>a.Cita!.IdCita))
                    .Concat((await CirugiasREST.ListarTodosAsync()).Where(a=>a.Activo && a.Cita is not null).Select(a=>a.Cita!.IdCita))
                    .ToHashSet();
            }
            catch(Exception ex) { Toast.Warning($"No se pudieron comprobar todas las atenciones existentes: {ex.Message}"); }
            if(IdCitaSeleccionada.HasValue)
            {
                var cita=citas.FirstOrDefault(x=>x.Id==IdCitaSeleccionada.Value);
                if(cita is not null)SeleccionarCita(cita);
            }
            if(IdAtencion.HasValue)
            {
                // Edición del tipo de atención identificado por su recurso correspondiente.
                var consultas=await ConsultasREST.ListarTodosAsync();
                var consulta=consultas.FirstOrDefault(x=>x.IdAtencion==IdAtencion.Value &&
                    (string.IsNullOrWhiteSpace(TipoEdicion) || TipoEdicion.Equals("CONSULTA",StringComparison.OrdinalIgnoreCase)));
                if(consulta is not null){modelo.Tipo="Consulta";CargarAtencion(consulta);modelo.MotivoConsulta=consulta.MotivoConsulta??"";modelo.Diagnostico=consulta.Diagnostico??"";modelo.Tratamiento=consulta.Tratamiento??"";}
                else
                {
                    var control=(await ControlesREST.ListarTodosAsync()).FirstOrDefault(x=>x.IdAtencion==IdAtencion.Value);
                    if(control is not null && (string.IsNullOrWhiteSpace(TipoEdicion) || TipoEdicion.Equals("CONTROL",StringComparison.OrdinalIgnoreCase))){modelo.Tipo="Control";CargarAtencion(control);modelo.Evolucion=control.Evolucion??"";modelo.Indicaciones=control.Indicaciones??"";}
                    else
                    {
                        var cirugia=(await CirugiasREST.ListarTodosAsync()).FirstOrDefault(x=>x.IdAtencion==IdAtencion.Value);
                        if(cirugia is not null && (string.IsNullOrWhiteSpace(TipoEdicion) || TipoEdicion.Equals("CIRUGIA",StringComparison.OrdinalIgnoreCase))){modelo.Tipo="Cirugia";CargarAtencion(cirugia);modelo.Procedimiento=cirugia.Procedimiento??"";modelo.IndicacionesPostoperatorias=cirugia.IndicacionesPostOperatorias??"";}
                    }
                }
            }
        }
        catch(Exception ex){Toast.Error($"No se pudieron cargar las citas: {ex.Message}");}
    }
    private void CargarAtencion(MascovetDomain.AtencionesMedicas.AtencionMedica a)
    {
        modelo.IdCita=a.Cita?.IdCita.ToString()??"";
        var cita = citas.FirstOrDefault(c => c.Id == a.Cita?.IdCita);
        modelo.Mascota=cita?.Mascota ?? a.Cita?.Mascota?.Nombre ?? "";
        modelo.Dueno=cita?.Dueno ?? a.Cita?.Mascota?.Cliente?.Nombre ?? "";modelo.HoraInicio=a.HoraInicio?.ToString("HH:mm")??"";
        modelo.HoraFin=a.HoraFin?.ToString("HH:mm")??"";modelo.PesoActual=a.PesoActual;
        modelo.Observaciones=a.Observaciones??"";modelo.Alergias=a.Alergias??"";
    }

    private const int TamPagina = 5;

    private bool EsEdicion => IdAtencion.HasValue;
    private string Titulo => EsEdicion ? "Editar atención médica" : "Registrar atención médica";

    private string HrefReceta => ultimoIdAtencion.HasValue ? $"/veterinario/recetas?atencion={ultimoIdAtencion}" : "/veterinario/recetas";
    private int? ultimoIdAtencion;
    private bool EsConsulta => modelo.Tipo == "Consulta";
    private bool EsControl => modelo.Tipo == "Control";

    private AtencionModel modelo = new();

    private readonly List<SelectOption<string>> tiposAtencion = new()
    {
        new("Consulta", "Consulta"),
        new("Control", "Control"),
        new("Cirugia", "Cirugía")
    };

    private List<CitaBusqueda> citas = new();
    private bool mostrarModalCita;
    private string? textoBusquedaCita;
    private int paginaCitas = 1;

    private IEnumerable<CitaBusqueda> CitasFiltradas =>
        citas.Where(c=>c.Confirmada && !citasYaAtendidas.Contains(c.Id) &&
            Coincide(textoBusquedaCita, c.Id.ToString(), c.Mascota, c.Dueno));

    private static IEnumerable<T> Pagina<T>(IEnumerable<T> fuente, int pagina) =>
        fuente.Skip((Math.Max(1, pagina) - 1) * TamPagina).Take(TamPagina);

    private static bool Coincide(string? texto, params string[] campos) =>
        string.IsNullOrWhiteSpace(texto) ||
        campos.Any(c => c.Contains(texto.Trim(), StringComparison.OrdinalIgnoreCase));

    private void AbrirModalCita() => mostrarModalCita = true;
    private void CerrarModalCita() => mostrarModalCita = false;

    private void BuscarCita(string? texto)
    {
        textoBusquedaCita = texto;
        paginaCitas = 1;
    }

    private void LimpiarBusquedaCita() => BuscarCita(string.Empty);

    private void SeleccionarCita(CitaBusqueda cita)
    {
        modelo.IdCita = cita.Id.ToString();
        modelo.Mascota = cita.Mascota;
        modelo.Dueno = cita.Dueno;
        modelo.Tipo = cita.Servicio;
        mostrarModalCita = false;
    }

    private async Task Guardar()
    {
        if (guardando) return;
        if(!int.TryParse(modelo.IdCita,out int idCita) || !TimeOnly.TryParse(modelo.HoraInicio,out var inicio) ||
            !TimeOnly.TryParse(modelo.HoraFin,out var fin)) {Toast.Warning("Selecciona cita y horas válidas.");return;}
        if (!EsEdicion && (!citas.Any(c=>c.Id==idCita && c.Confirmada) || citasYaAtendidas.Contains(idCita)))
        { Toast.Warning("Esta cita no está confirmada o ya tiene una atención registrada."); return; }
        guardando=true;
        try
        {
            var cita=new MascovetDomain.Citas.Cita{IdCita=idCita};
            MascovetDomain.AtencionesMedicas.AtencionMedica a=modelo.Tipo switch
            {
                "Consulta"=>new MascovetDomain.AtencionesMedicas.Consulta{MotivoConsulta=modelo.MotivoConsulta,Diagnostico=modelo.Diagnostico,Tratamiento=modelo.Tratamiento},
                "Control"=>new MascovetDomain.AtencionesMedicas.Control{Evolucion=modelo.Evolucion,Indicaciones=modelo.Indicaciones},
                _=>new MascovetDomain.AtencionesMedicas.Cirugia{Procedimiento=modelo.Procedimiento,IndicacionesPostOperatorias=modelo.IndicacionesPostoperatorias}
            };
            a.IdAtencion=IdAtencion??0;a.Cita=cita;a.HoraInicio=inicio;a.HoraFin=fin;
            a.PesoActual=modelo.PesoActual;a.Alergias=modelo.Alergias;a.Observaciones=modelo.Observaciones;
            int resultado= a switch
            {
                MascovetDomain.AtencionesMedicas.Consulta consulta => EsEdicion ? await ConsultasREST.ModificarAsync(consulta) : await ConsultasREST.InsertarAsync(consulta),
                MascovetDomain.AtencionesMedicas.Control control => EsEdicion ? await ControlesREST.ModificarAsync(control) : await ControlesREST.InsertarAsync(control),
                MascovetDomain.AtencionesMedicas.Cirugia cirugia => EsEdicion ? await CirugiasREST.ModificarAsync(cirugia) : await CirugiasREST.InsertarAsync(cirugia),
                _=>0
            };
            if(resultado<=0){Toast.Warning("No se confirmó el registro de atención.");return;}
            ultimoIdAtencion=EsEdicion?IdAtencion:resultado;
            if (EsEdicion) { Toast.Success("Atención actualizada."); return; }
            if(!EsEdicion)
            {
                citasYaAtendidas.Add(idCita);
                try
                {
                    var actual=await CitasREST.BuscarPorIdAsync(idCita);
                    if(actual is null || actual.Estado!=MascovetDomain.Enums.EstadoCita.CONFIRMADA)
                    { Toast.Warning("Atención guardada, pero la cita ya no está confirmada. Verifica su estado."); return; }
                    var mascota = (await MascotasREST.ListarTodosAsync())
                        .FirstOrDefault(m => m.IdMascota == actual.Mascota?.IdMascota);
                    if(mascota?.Cliente?.IdUsuario is not > 0)
                    { Toast.Warning("Atención guardada, pero no se pudo actualizar la cita porque falta el propietario."); return; }
                    actual.Mascota=new MascovetDomain.Mascotas.Mascota
                        { IdMascota=mascota.IdMascota,Cliente=new MascovetDomain.Usuarios.Cliente{IdUsuario=mascota.Cliente.IdUsuario}};
                    if(actual.Fecha.HasValue) actual.Fecha=ReglasCitas.FechaParaRest(actual.Fecha.Value);
                    actual.Estado=MascovetDomain.Enums.EstadoCita.ATENDIDA;
                    if(await CitasREST.ModificarAsync(actual)<=0)
                    { Toast.Warning("Atención guardada, pero el estado de la cita no se actualizó."); return; }
                    citas=citas.Where(c=>c.Id!=idCita).ToList();
                    Toast.Success("Atención registrada y cita marcada ATENDIDA.");
                }
                catch(Exception ex)
                { Toast.Warning($"Atención guardada, pero no se pudo marcar la cita ATENDIDA: {ex.Message}"); }
            }
        }
        catch(Exception ex){Toast.Error($"No se pudo guardar la atención: {ex.Message}");}
        finally {guardando=false;}
    }

    private sealed record CitaBusqueda(int Id, DateOnly Fecha, TimeOnly Hora, string Mascota, string Dueno,
        bool Confirmada, string Servicio);

    // Los límites de longitud salen de las validaciones de ConsultaBOImpl, ControlBOImpl y CirugiaBOImpl.
    private sealed class AtencionModel : IValidatableObject
    {
        [Required(ErrorMessage = "Seleccione una cita.")]
        public string IdCita { get; set; } = string.Empty;
        public string Mascota { get; set; } = string.Empty;
        public string Dueno { get; set; } = string.Empty;

        public string Tipo { get; set; } = "Consulta";

        [Required(ErrorMessage = "Ingrese la hora de inicio.")]
        public string HoraInicio { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingrese la hora de fin.")]
        public string HoraFin { get; set; } = string.Empty;

        [Range(0, double.MaxValue, ErrorMessage = "El peso actual no puede ser negativo.")]
        public double PesoActual { get; set; }

        [StringLength(500, ErrorMessage = "Las alergias no deben exceder los 500 caracteres.")]
        public string Alergias { get; set; } = string.Empty;

        [StringLength(255, ErrorMessage = "Las observaciones no deben exceder los 255 caracteres.")]
        public string Observaciones { get; set; } = string.Empty;

        // Consulta
        [StringLength(400, ErrorMessage = "El motivo de consulta no debe exceder los 400 caracteres.")]
        public string MotivoConsulta { get; set; } = string.Empty;

        [StringLength(400, ErrorMessage = "El diagnóstico no debe exceder los 400 caracteres.")]
        public string Diagnostico { get; set; } = string.Empty;

        [StringLength(400, ErrorMessage = "El tratamiento no debe exceder los 400 caracteres.")]
        public string Tratamiento { get; set; } = string.Empty;

        // Control
        [StringLength(500, ErrorMessage = "La evolución no debe exceder los 500 caracteres.")]
        public string Evolucion { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Las indicaciones no deben exceder los 500 caracteres.")]
        public string Indicaciones { get; set; } = string.Empty;

        // Cirugía
        [StringLength(500, ErrorMessage = "El procedimiento no debe exceder los 500 caracteres.")]
        public string Procedimiento { get; set; } = string.Empty;

        [StringLength(500, ErrorMessage = "Las indicaciones postoperatorias no deben exceder los 500 caracteres.")]
        public string IndicacionesPostoperatorias { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            var errores = new List<ValidationResult>();

            if (string.CompareOrdinal(HoraInicio, HoraFin) >= 0)
                errores.Add(new("La hora de inicio debe ser anterior a la hora de fin.", new[] { nameof(HoraFin) }));

            void Obligatorio(string valor, string mensaje, string campo)
            {
                if (string.IsNullOrWhiteSpace(valor))
                    errores.Add(new(mensaje, new[] { campo }));
            }

            switch (Tipo)
            {
                case "Consulta":
                    Obligatorio(MotivoConsulta, "El motivo de consulta es obligatorio.", nameof(MotivoConsulta));
                    Obligatorio(Diagnostico, "El diagnóstico es obligatorio.", nameof(Diagnostico));
                    Obligatorio(Tratamiento, "El tratamiento es obligatorio.", nameof(Tratamiento));
                    break;
                case "Control":
                    Obligatorio(Evolucion, "La evolución es obligatoria.", nameof(Evolucion));
                    Obligatorio(Indicaciones, "Las indicaciones son obligatorias.", nameof(Indicaciones));
                    break;
                default:
                    Obligatorio(Procedimiento, "El procedimiento es obligatorio.", nameof(Procedimiento));
                    Obligatorio(IndicacionesPostoperatorias, "Las indicaciones postoperatorias son obligatorias.", nameof(IndicacionesPostoperatorias));
                    break;
            }

            return errores;
        }
    }
}

