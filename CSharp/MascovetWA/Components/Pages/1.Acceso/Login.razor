@page "/"
@layout AuthLayout
@inject AuthRestService Auth
@inject UserContext User
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations
@using MascovetWA.Servicios.REST

<PageTitle>Iniciar sesión | Mascovet</PageTitle>

<main class="login-page">
    <section class="login-panel" aria-labelledby="login-title">

        <header class="login-brand">
            <div class="login-logo" aria-hidden="true">
                <span>🐾</span>
            </div>

            <h1>Mascovet</h1>
            <p class="login-tagline">
                Cuidamos a quienes más quieres.
            </p>
        </header>

        <div class="login-heading">
            <h2 id="login-title">¡Bienvenido!</h2>
            <p>Ingresa tus datos para acceder a tu cuenta.</p>
        </div>

        <EditForm Model="@modelo" OnValidSubmit="@IniciarSesion">
            <DataAnnotationsValidator />

            <div class="login-fields">
                <label class="ms-role-field"><span>Tipo de usuario</span>
                    <select class="ms-role-input" @bind="rolSeleccionado">
                        <option value="Cliente">Cliente</option><option value="Recepcionista">Recepcionista</option>
                        <option value="Veterinario">Veterinario</option><option value="Administrador">Administrador</option>
                    </select>
                </label>
                <AppInput TValue="string"
                          Label="@(rolSeleccionado == "Cliente" ? "Correo electrónico" : "Nombre de usuario")"
                          Type="text"
                          Placeholder="usuario o nombre@correo.com"
                          Required="true"
                          @bind-Value="modelo.Usuario"
                          autocomplete="username" />
                
                <AppInput TValue="string"
                          Label="Contraseña"
                          Type="password"
                          Placeholder="Ingresa tu contraseña"
                          Required="true"
                          @bind-Value="modelo.Contrasena"
                          autocomplete="current-password" />
            </div>

            <div class="login-options">
                <a href="#" @onclick="AbrirModalRecuperacion"
                   @onclick:preventDefault="true">
                    ¿Olvidaste tu contraseña?
                </a>
            </div>

            <div class="login-submit">
                <AppButton Type="submit"
                           Variant="ButtonVariant.Primary"
                           Size="ButtonSize.Medium"
                           Disabled="@enviando"
                           Loading="@enviando">
                    Iniciar sesión
                </AppButton>
            </div>

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <p class="login-feedback" role="status">
                    @mensaje
                </p>
            }
        </EditForm>

        <footer class="login-footer">
            <span>¿Todavía no tienes una cuenta?</span>
            <a href="/registro">Crear una cuenta</a>
        </footer>
    </section>

    <p class="login-copyright">
        © 2026 Mascovet. Todos los derechos reservados.
    </p>
    <AppModal @bind-Visible="mostrarModalRecuperacion"
          Title="Recuperar contraseña"
          ConfirmText="Enviar instrucciones"
          CancelText="Cancelar"
          OnConfirm="EnviarSolicitudRecuperacion">

    <p>Ingresa tu correo electrónico para recuperar tu cuenta.</p>

    <AppInput TValue="string"
              Label="Correo electrónico"
              Type="email"
              Placeholder="nombre@correo.com"
              Required="true"
              @bind-Value="correoRecuperacion"
              autocomplete="email" />

    @if (!string.IsNullOrWhiteSpace(errorRecuperacion))
    {
        <p class="login-feedback">@errorRecuperacion</p>
    }
    </AppModal>
</main>

@code {
    private LoginModel modelo = new();
    private string rolSeleccionado = "Cliente";
    private bool enviando;
    private string mensaje = string.Empty;
    private bool mostrarModalRecuperacion;
    private string correoRecuperacion = string.Empty;
    private string errorRecuperacion = string.Empty;
    
    private void AbrirModalRecuperacion()
    {
        errorRecuperacion = string.Empty;
        mostrarModalRecuperacion = true;
    }

    private void EnviarSolicitudRecuperacion()
    {
        if (!new System.ComponentModel.DataAnnotations
            .EmailAddressAttribute().IsValid(correoRecuperacion))
        {
            errorRecuperacion = "Ingresa un correo electrónico válido.";
            return;
        }

        mostrarModalRecuperacion = false;
        mensaje = "No se pudo enviar la solicitud. El servicio de recuperación no está disponible.";
    }

    private async Task IniciarSesion()
    {
        enviando = true;
        mensaje = string.Empty;

        try
        {
            string usuario = modelo.Usuario.Trim();
            bool esCliente = rolSeleccionado == "Cliente";

            var sesion = esCliente
                ? await Auth.AutenticarAsync(usuario, modelo.Contrasena)
                : await Auth.AutenticarPersonalAsync(usuario, modelo.Contrasena);

            if (sesion is null)
            {
                mensaje = esCliente
                    ? "Correo o contraseña incorrectos."
                    : "Nombre de usuario o contraseña incorrectos.";
                return;
            }

            UserRole? rolRecibido = sesion.Rol switch
            {
                "CLIENTE" => UserRole.Cliente,
                "RECEPCIONISTA" => UserRole.Recepcionista,
                "VETERINARIO" => UserRole.Veterinario,
                "ADMINISTRADOR" => UserRole.Administrador,
                _ => null
            };

            if (rolRecibido is not UserRole rol ||
                !string.Equals(sesion.Rol, rolSeleccionado, StringComparison.OrdinalIgnoreCase))
            {
                mensaje = "La cuenta no corresponde al tipo de usuario seleccionado.";
                return;
            }

            User.SignIn(rol, sesion.Nombre, sesion.NombreUsuario);
            Navigation.NavigateTo(NavCatalog.HomeFor(rol));
        }
        catch (Exception)
        {
            mensaje = "No se pudo iniciar sesión. Inténtalo nuevamente.";
        }
        finally
        {
            modelo.Contrasena = string.Empty;
            enviando = false;
        }
    }

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Ingresa tu usuario o correo electrónico.")]
        public string Usuario { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa tu contraseña.")]
        public string Contrasena { get; set; } = string.Empty;
    }
    
}
