@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]
@page "/administrador/reportes/especialidad"
@using System.ComponentModel.DataAnnotations
@inject ToastService Toast
@inject CitaRestService CitasREST
@inject VeterinarioRestService VeterinariosREST
@inject ReporteRestService ReportesREST

<PageTitle>Reporte de citas por especialidad | Mascovet</PageTitle>

<div class="page-header">
    <h1>Reportes</h1>
    </div>

<div class="acciones acciones--barra">
    <AppButton Href="/administrador/reportes/tipo-atencion" Variant="ButtonVariant.Secondary" Icon="bar-chart">
        Citas por tipo de atención
    </AppButton>
    <AppButton Href="/administrador/reportes/especialidad" Variant="ButtonVariant.Primary" Icon="bar-chart">
        Citas por especialidad
    </AppButton>
    <AppButton Href="/administrador/reportes/historial" Variant="ButtonVariant.Secondary" Icon="file-text">Historial clínico</AppButton>
</div>

<EditForm Model="filtro" OnValidSubmit="Generar">
    <DataAnnotationsValidator />

    <div class="seccion">
        <AppCard Title="Reporte de citas por especialidad">
            <div class="form-grid">
                <div class="span-3">
                    <AppDatePicker Label="Fecha de inicio" Required="true" @bind-Value="filtro.FechaInicio" />
                </div>
                <div class="span-3">
                    <AppDatePicker Label="Fecha de fin" Required="true" @bind-Value="filtro.FechaFin" />
                </div>
            </div>

            <div class="acciones acciones--sup">
                <AppButton Type="submit" Variant="ButtonVariant.Primary" Icon="bar-chart" Disabled="@cargando">Generar reporte</AppButton>
                <AppButton Variant="ButtonVariant.Secondary" Icon="file-text" Disabled="@cargando" OnClick="ExportarPdf">Ver PDF</AppButton>
                <AppButton Variant="ButtonVariant.Tertiary" OnClick="Limpiar">Limpiar</AppButton>
            </div>
        </AppCard>
    </div>
</EditForm>

<AppCard Title="Resultados">
    <AppTable Items="Pagina(resumen, paginaResumen)"
              ColumnCount="3"
              Caption="Citas registradas por especialidad médica">
        <HeaderContent>
            <th scope="col">Especialidad</th>
            <th scope="col">Cantidad de citas</th>
            <th scope="col">Porcentaje</th>
        </HeaderContent>
        <RowTemplate Context="fila">
            <td>@fila.Especialidad</td>
            <td>@fila.Cantidad</td>
            <td>
                <div class="porcentaje">
                    <div class="barra" aria-hidden="true">
                        <div class="barra__relleno" style="width: @(Porcentaje(fila).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                    <span>@Porcentaje(fila).ToString("0.#")%</span>
                </div>
            </td>
        </RowTemplate>
        <EmptyContent>
            <AppEmptyState Icon="bar-chart"
                           Title="Sin resultados para mostrar"
                           Description="Selecciona un rango de fechas y presiona «Generar reporte»." />
        </EmptyContent>
    </AppTable>

    <AppPagination @bind-CurrentPage="paginaResumen"
                   TotalItems="resumen.Count"
                   PageSize="TamPagina"
                   AriaLabel="Paginación del reporte" />

    @if (resumen.Count > 0)
    {
        <p class="total">
            Total de citas en el rango: <strong>@TotalCitas</strong>
        </p>
    }
</AppCard>


<ReportePdfModal @bind-Visible="mostrarPdf" PdfDataUrl="@pdfBase64"
                 Title="Citas por especialidad" FileName="ReporteCitasEspecialidad.pdf" />

@code {
    private const int TamPagina = 10;
    private FiltroModel filtro = new();
    private int paginaResumen = 1;
    private readonly List<FilaEspecialidad> resumen = new();
    private bool cargando;
    private string? pdfBase64;
    private bool mostrarPdf;
    private int TotalCitas => resumen.Sum(f => f.Cantidad);
    private double Porcentaje(FilaEspecialidad fila) => TotalCitas == 0 ? 0 : fila.Cantidad * 100.0 / TotalCitas;
    private static IEnumerable<T> Pagina<T>(IEnumerable<T> fuente, int pagina) =>
        fuente.Skip((Math.Max(1, pagina) - 1) * TamPagina).Take(TamPagina);

    private bool RangoValido() => filtro.FechaInicio.HasValue && filtro.FechaFin.HasValue &&
        filtro.FechaInicio <= filtro.FechaFin;

    private async Task Generar()
    {
        if (!RangoValido()) { Toast.Warning("Selecciona un rango válido."); return; }
        cargando = true;
        resumen.Clear();
        paginaResumen = 1;
        pdfBase64 = null; mostrarPdf = false;
        try
        {
            var citas = (await CitasREST.ListarTodosAsync())
                .Where(c => c.Activo && c.Fecha.HasValue &&
                    DateOnly.FromDateTime(c.Fecha.Value) >= filtro.FechaInicio!.Value &&
                    DateOnly.FromDateTime(c.Fecha.Value) <= filtro.FechaFin!.Value).ToList();
            var vets = await VeterinariosREST.ListarTodosAsync();
            var especialidades = vets.GroupBy(v => v.IdUsuario)
                .ToDictionary(g => g.Key, g => g.First().Especialidad?.ToString().Replace('_', ' ') ?? "SIN ESPECIALIDAD ASIGNADA");
            resumen.AddRange(citas.GroupBy(c =>
            {
                if (c.Veterinario is null || !especialidades.TryGetValue(c.Veterinario.IdUsuario, out var esp))
                    return "SIN ESPECIALIDAD ASIGNADA";
                return esp;
            }).Select(g => new FilaEspecialidad(g.Key, g.Count()))
              .OrderByDescending(g => g.Cantidad).ThenBy(g => g.Especialidad));
        }
        catch (Exception ex) { resumen.Clear(); Toast.Error($"No se pudo generar el reporte: {ex.Message}"); }
        finally { cargando = false; }
    }

    private async Task ExportarPdf()
    {
        if (!RangoValido()) { Toast.Warning("Selecciona primero un rango válido."); return; }
        cargando = true;
        pdfBase64 = null; mostrarPdf = false;
        try
        {
            byte[] pdf = await ReportesREST.GenerarCitasPorEspecialidadAsync(filtro.FechaInicio!.Value, filtro.FechaFin!.Value);
            pdfBase64 = "data:application/pdf;base64," + Convert.ToBase64String(pdf);
            mostrarPdf = true;
            Toast.Success("Reporte PDF generado.");
        }
        catch (Exception ex) { Toast.Error($"Java no pudo generar el PDF: {ex.Message}"); }
        finally { cargando = false; }
    }

    private void Limpiar()
    {
        filtro = new FiltroModel(); resumen.Clear(); paginaResumen = 1; pdfBase64 = null; mostrarPdf = false;
    }

    private sealed record FilaEspecialidad(string Especialidad, int Cantidad);

    private sealed class FiltroModel : IValidatableObject
    {
        [Required(ErrorMessage = "Ingrese la fecha de inicio.")]
        public DateOnly? FechaInicio { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddMonths(-3));
        [Required(ErrorMessage = "Ingrese la fecha de fin.")]
        public DateOnly? FechaFin { get; set; } = DateOnly.FromDateTime(DateTime.Today.AddMonths(1));
        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (FechaInicio.HasValue && FechaFin.HasValue && FechaInicio > FechaFin)
                yield return new("La fecha de inicio no puede ser posterior a la fecha de fin.", new[] { nameof(FechaFin) });
        }
    }
}
