@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@page "/cliente/disponibilidad"
@page "/recepcion/disponibilidad"
@layout MainLayout
@inject HorarioAtencionRestService HorariosREST
@inject CitaRestService CitasREST
@inject VeterinarioRestService VeterinariosREST
@inject UserContext User
@inject ToastService Toast
@using MascovetWA.Servicios.Validaciones

<PageTitle>Consultar disponibilidad | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div><h1>Consultar disponibilidad</h1></div>
    </header>
    <AppCard Title="Buscar turnos disponibles">
        <div class="form-grid">
            <div class="span-4"><AppDatePicker Label="Fecha de atención" Required="true" Min="@Hoy" @bind-Value="fecha" /></div>
            <div class="span-4"><AppSelect TValue="string" Label="Especialidad" Options="especialidades" @bind-Value="especialidad" /></div>
            <div class="span-4"><AppSelect TValue="string" Label="Veterinario" Options="veterinarios" @bind-Value="veterinario" /></div>
        </div>
        <div class="acciones">
            <AppButton OnClick="Buscar" Disabled="@buscando" Loading="@buscando">Buscar disponibilidad</AppButton>
        </div>
    </AppCard>
    <AppCard Title="Turnos disponibles">
        @if (!string.IsNullOrWhiteSpace(error))
        {
            <p role="alert" class="ms-small-note">@error</p>
        }
        <AppTable Items="resultados" Loading="buscando" Caption="Disponibilidad de veterinarios" ColumnCount="6">
            <HeaderContent>
                <th>Veterinario</th><th>Especialidad</th><th>Día</th><th>Fecha</th><th>Hora libre</th><th>Acción</th>
            </HeaderContent>
            <RowTemplate Context="turno">
                <td>@turno.Nombre</td>
                <td>@turno.Especialidad.Replace("_", " ")</td>
                <td>@DiaTexto(turno.Fecha.DayOfWeek)</td>
                <td>@turno.Fecha.ToString("dd/MM/yyyy")</td>
                <td>@turno.Hora.ToString("HH:mm")</td>
                <td><AppButton Href="@EnlaceReserva(turno)" Size="ButtonSize.Small" Variant="ButtonVariant.Secondary">Reservar cita</AppButton></td>
            </RowTemplate>
            <EmptyContent>
                <AppEmptyState Title="Sin turnos disponibles" Description="No hay horas libres para los filtros y la fecha elegidos. Prueba otra fecha o veterinario." Icon="clock" />
            </EmptyContent>
        </AppTable>
        <p class="ms-muted">La disponibilidad se actualiza al pulsar «Buscar disponibilidad» y se verifica nuevamente antes de reservar.</p>
    </AppCard>
</div>
@code {
    private DateOnly Hoy => DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? fecha = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private string especialidad = "", veterinario = "";
    private List<SelectOption<string>> especialidades = new() { new("", "Todas") };
    private List<SelectOption<string>> veterinarios = new() { new("", "Todos") };
    private List<MascovetDomain.Usuarios.Veterinario> veterinariosDatos = new();
    private List<TurnoFila> resultados = new();
    private bool buscando;
    private string? error;
    private sealed record TurnoFila(int IdVeterinario, string Nombre, string Especialidad, DateOnly Fecha, TimeOnly Hora);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            veterinariosDatos = (await VeterinariosREST.ListarTodosAsync()).Where(v => v.Activo).ToList();
            veterinarios.AddRange(veterinariosDatos.Select(v => new SelectOption<string>(v.IdUsuario.ToString(),
                $"{v.Nombre} {v.ApellidoPaterno}".Trim())));
            especialidades.AddRange(veterinariosDatos.Where(v => v.Especialidad.HasValue)
                .Select(v => v.Especialidad!.Value.ToString()).Distinct().OrderBy(x => x)
                .Select(x => new SelectOption<string>(x, x.Replace("_", " "))));
            await Buscar();
        }
        catch (Exception ex) { error = $"No se pudieron cargar los veterinarios: {ex.Message}"; }
    }

    private async Task Buscar()
    {
        if (!fecha.HasValue || fecha.Value < Hoy)
        {
            resultados.Clear();
            Toast.Warning("Selecciona una fecha de hoy en adelante.");
            return;
        }
        buscando = true;
        error = null;
        resultados = new();
        try
        {
             
            var horarios = await HorariosREST.ListarTodosAsync();
            var citas = await CitasREST.ListarTodosAsync();
            resultados = veterinariosDatos
                .Where(v => string.IsNullOrEmpty(veterinario) || v.IdUsuario.ToString() == veterinario)
                .Where(v => string.IsNullOrEmpty(especialidad) || v.Especialidad?.ToString() == especialidad)
                .SelectMany(v => DisponibilidadCitas.ObtenerHoras(fecha.Value, v.IdUsuario, horarios, citas)
                    .Select(h => new TurnoFila(v.IdUsuario, $"{v.Nombre} {v.ApellidoPaterno}".Trim(),
                        v.Especialidad?.ToString() ?? "Sin especialidad", fecha.Value, h)))
                .OrderBy(x => x.Hora).ThenBy(x => x.Nombre).ToList();
        }
        catch (Exception ex)
        {
            error = $"No se pudo verificar la disponibilidad con Java REST: {ex.Message}";
        }
        finally { buscando = false; }
    }

    private string EnlaceReserva(TurnoFila turno)
    {
        string ruta = User.Role == UserRole.Recepcionista ? "/recepcion/citas/nueva" : "/cliente/reservar";
        return $"{ruta}?vetId={turno.IdVeterinario}&fecha={turno.Fecha:yyyy-MM-dd}&hora={turno.Hora.ToString("HH:mm")}";
    }

    private static string DiaTexto(DayOfWeek dia) => dia switch
    {
        DayOfWeek.Monday => "Lunes", DayOfWeek.Tuesday => "Martes", DayOfWeek.Wednesday => "Miércoles",
        DayOfWeek.Thursday => "Jueves", DayOfWeek.Friday => "Viernes", DayOfWeek.Saturday => "Sábado",
        _ => "Domingo"
    };
}