@page "/recepcion/mascotas/nueva"
@inject MascotaRestService MascotasREST
@inject ClienteRestService ClientesREST
@inject NavigationManager Navigation
@layout MainLayout
@inject ToastService Toast

<PageTitle>Registrar mascota | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header"><div><h1>Registrar mascota</h1><p>Asocia una mascota con su propietario.</p></div></header>
    <AppCard Title="Datos de la mascota">
        <div class="form-grid">
            <div class="span-6"><AppSelect TValue="string" Label="Propietario" Placeholder="Selecciona un cliente" Required="true" Options="clientes" @bind-Value="idCliente" /></div>
            <div class="span-6"><AppInput TValue="string" Label="Nombre de mascota" Required="true" maxlength="150" @bind-Value="nombre" /></div>
            <div class="span-4"><AppSelect TValue="string" Label="Especie" Options="especies" @bind-Value="especie" /></div>
            <div class="span-4"><AppInput TValue="string" Label="Raza (escribe Desconocida si no se conoce)" Required="true" @bind-Value="raza" /></div>
            <div class="span-4"><AppSelect TValue="string" Label="Sexo" Options="sexos" @bind-Value="sexo" /></div>
            <div class="span-6"><AppDatePicker Label="Fecha de nacimiento" @bind-Value="nacimiento" /></div>
        </div>
        <div class="acciones">
            <AppButton OnClick="Guardar">Registrar mascota</AppButton>
            <AppButton Href="/recepcion/mascotas" Variant="ButtonVariant.Secondary">Cancelar</AppButton>
        </div>
    </AppCard>
</div>
@code {
    [SupplyParameterFromQuery(Name = "cliente")] private int? Cliente { get; set; }
    private string idCliente = "";
    private string nombre = "";
    private string especie = "PERRO";
    private string raza = "";
    private string sexo = "HEMBRA";
    private DateOnly? nacimiento;
    private List<SelectOption<string>> clientes = new();
    private readonly List<SelectOption<string>> especies = [new("PERRO", "Perro"), new("GATO", "Gato"), new("AVE", "Ave"), new("CONEJO", "Conejo")];
    private readonly List<SelectOption<string>> sexos = [new("HEMBRA", "Hembra"), new("MACHO", "Macho")];
    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = (await ClientesREST.ListarTodosAsync()).Where(x => x.Activo)
                .Select(x => new SelectOption<string>(x.IdUsuario.ToString(), $"{x.Nombre} {x.ApellidoPaterno}".Trim())).ToList();
            if (Cliente.HasValue) idCliente = Cliente.Value.ToString();
        }
        catch (Exception ex) { Toast.Error($"No se pudieron cargar los clientes: {ex.Message}"); }
    }
    private async Task Guardar()
    {
        if (!int.TryParse(idCliente, out int id) || string.IsNullOrWhiteSpace(nombre) ||
            string.IsNullOrWhiteSpace(raza) || !nacimiento.HasValue)
        { Toast.Warning("Completa los campos obligatorios."); return; }
        try
        {
            var mascota = new MascovetDomain.Mascotas.Mascota
            {
                Cliente = new MascovetDomain.Usuarios.Cliente { IdUsuario = id },
                Nombre = nombre, Raza = raza, FechaNacimiento = nacimiento.Value.ToDateTime(TimeOnly.MinValue),
                Especie = Enum.Parse<MascovetDomain.Enums.Especie>(especie),
                Sexo = Enum.Parse<MascovetDomain.Enums.Sexo>(sexo)
            };
            int resultado = await MascotasREST.InsertarAsync(mascota);
            if (resultado <= 0) { Toast.Warning("El servidor no confirmó el registro."); return; }
            Toast.Success("Mascota registrada."); Navigation.NavigateTo("/recepcion/mascotas");
        }
        catch (Exception ex) { Toast.Error($"No se pudo registrar la mascota: {ex.Message}"); }
    }
}
