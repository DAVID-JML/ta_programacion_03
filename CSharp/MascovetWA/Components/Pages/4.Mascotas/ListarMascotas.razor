@page "/cliente/mascotas"
@inject MascotaRestService MascotasREST
@inject ClienteRestService ClientesREST
@inject CitaRestService CitasREST
@inject VacunacionRestService VacunacionesREST
@inject VacunaRestService VacunasREST
@inject UserContext User
@layout MainLayout

@using System.Globalization
@using MascovetWA.Components.Layout
@using MascovetWA.Components.DesignSystem
@using MascovetWA.Components.DesignSystem.Buttons
@using MascovetWA.Components.DesignSystem.DataDisplay
@using MascovetWA.Components.DesignSystem.Forms
@using MascovetWA.Components.DesignSystem.Icons

<PageTitle>Mis mascotas | Mascovet</PageTitle>

<div class="pets-page">
    <header class="pets-page__header">
        <div class="pets-page__heading">
            <span class="pets-page__eyebrow">MI ESPACIO MASCOVET</span>
            <h1>Mis mascotas</h1>
            <p>
                Consulta la información de tus compañeros y mantén
                al día el seguimiento de su salud.
            </p>
        </div>

        <div class="pets-page__header-action">
            <AppButton Href="/cliente/mascotas/nueva" Icon="plus">
                Registrar mascota
            </AppButton>
        </div>
    </header>

    @{
        var mascotasVisibles = MascotasFiltradas.ToList();
    }

    @if (!string.IsNullOrWhiteSpace(ErrorCarga))
    {
        <p role="alert" class="ms-small-note">@ErrorCarga</p>
    }
    <section class="pets-toolbar"
             aria-label="Buscar y consultar mascotas">

        <div class="pets-results" aria-live="polite">
            <div class="pets-results__count">
                <strong>@mascotasVisibles.Count</strong>
                <span>
                    @(mascotasVisibles.Count == 1
                        ? "mascota encontrada"
                        : "mascotas encontradas")
                </span>
            </div>

            <p>
                de @ListaMascotas.Count registradas
            </p>
        </div>

        <div class="pets-search">
            <AppSearchInput @bind-Value="Busqueda"
                            Id="buscar-mascotas"
                            Label="Buscar mascota"
                            Placeholder="Nombre, especie o raza"
                            AriaLabel="Buscar mascotas por nombre, especie o raza" />
        </div>
    </section>

    @if (ListaMascotas.Count == 0)
    {
        <section class="pets-empty">
            <AppEmptyState Icon="heart"
                           Title="Aún no tienes mascotas registradas"
                           Description="Registra a tu compañero para poder consultar su información.">
                <AppButton Href="/cliente/mascotas/nueva" Icon="plus">
                    Registrar mascota
                </AppButton>
            </AppEmptyState>
        </section>
    }
    else if (mascotasVisibles.Count == 0)
    {
        <section class="pets-empty">
            <AppEmptyState Icon="search"
                           Title="No encontramos mascotas"
                           Description="Prueba con otro nombre, especie o raza." />
        </section>
    }
    else
    {
        <section class="pets-grid" aria-label="Mis mascotas">
            @foreach (var mascota in MascotasFiltradas)
            {
                <article class="pet-card" @key="mascota.Id">
                    <AppCard Title="@mascota.Nombre"
                             Subtitle="@($"{mascota.Especie} · {mascota.Raza}")">

                        <Actions>
                            <div class="pet-card__avatar" aria-hidden="true">
                                <AppIcon Name="@ObtenerIconoEspecie(mascota.Especie)"
                                         Size="32" />
                            </div>
                        </Actions>

                        <ChildContent>
                            <div class="pet-card__content">
                                <div class="pet-card__badges">
                                    <AppBadge Variant="SemanticVariant.Neutral"
                                              ShowIcon="false">
                                        @mascota.Sexo
                                    </AppBadge>
                                </div>

                                <div class="pet-card__details">
                                    <div class="pet-detail">
                                        <span class="pet-detail__label">
                                            <AppIcon Name="calendar" Size="15" />
                                            Fecha de nacimiento
                                        </span>
                                        <strong>
                                            @FormatoFecha(mascota.FechaNacimiento)
                                        </strong>
                                    </div>

                                    <div class="pet-detail">
                                        <span class="pet-detail__label">
                                            <AppIcon Name="clock" Size="15" />
                                            Edad
                                        </span>
                                        <strong>
                                            @CalcularEdad(mascota.FechaNacimiento)
                                        </strong>
                                    </div>
                                </div>

                                <div class="pet-card__health">
                                    <div class="pet-health-item">
                                        <span class="pet-detail__label">
                                            <AppIcon Name="heart" Size="15" />
                                            Última vacuna
                                        </span>

                                        <strong>
                                            @mascota.UltimaVacuna
                                        </strong>

                                        <small>
                                            @FormatoFecha(mascota.FechaUltimaVacuna)
                                        </small>
                                    </div>

                                    <div class="pet-health-item">
                                        <span class="pet-detail__label">
                                            <AppIcon Name="calendar" Size="15" />
                                            Próxima cita
                                        </span>

                                        @if (mascota.FechaProximaCita is DateOnly fechaCita)
                                        {
                                            <strong>
                                                @FormatoFecha(fechaCita)
                                            </strong>

                                            <small>
                                                @mascota.HoraProximaCita
                                            </small>
                                        }
                                        else
                                        {
                                            <strong class="pet-health-item__empty">
                                                Sin citas programadas
                                            </strong>

                                            <small>
                                                Puedes reservar una atención.
                                            </small>
                                        }
                                    </div>
                                </div>
                            </div>
                        </ChildContent>

                        <Footer>
                            <div class="pet-card__actions">
                                <AppButton Href="@($"/cliente/mascotas/{mascota.Id}/editar")" Variant="ButtonVariant.Tertiary" Size="ButtonSize.Small">Editar</AppButton>

                                <AppButton Href="@($"/cliente/mascotas/{mascota.Id}/cartilla")" Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Icon="check-circle">Cartilla</AppButton>

                                <AppButton Href="@HistorialHref(mascota.Id)"
                                           Variant="ButtonVariant.Secondary"
                                           Size="ButtonSize.Small"
                                           Icon="file-text">
                                    Ver historial
                                </AppButton>

                                <AppButton Href="@ReservaHref(mascota.Id)"
                                           Size="ButtonSize.Small"
                                           Icon="calendar">
                                    Reservar cita
                                </AppButton>
                            </div>
                        </Footer>
                    </AppCard>
                </article>
            }
        </section>
    }
</div>

@code {
    private string? Busqueda {get;set;}="";
    private string? ErrorCarga;
    private List<MascotaListado> ListaMascotas {get;set;}=new();
    protected override async Task OnInitializedAsync()
    {
        ErrorCarga = null;
        ListaMascotas.Clear();
        // La cuenta de prueba se vincula temporalmente mediante su correo único.
        int idCliente;
        try
        {
            var coincidentes = (await ClientesREST.ListarTodosAsync())
                .Where(c => c.Activo && !string.IsNullOrWhiteSpace(User.UsuarioVinculado) &&
                    string.Equals(c.NombreUsuario, User.UsuarioVinculado, StringComparison.OrdinalIgnoreCase)).ToList();
            if (coincidentes.Count != 1)
            {
                ErrorCarga = "No se pudo asociar la cuenta de prueba a un cliente único. Revisa los datos de la base.";
                return;
            }
            idCliente = coincidentes[0].IdUsuario;
        }
        catch (Exception ex) { ErrorCarga = $"No se pudo consultar el cliente: {ex.Message}"; return; }

        List<MascovetDomain.Mascotas.Mascota> mascotas;
        try { mascotas = (await MascotasREST.ListarTodosAsync()).Where(m => m.Activo && m.Cliente?.IdUsuario == idCliente).ToList(); }
        catch (Exception ex) { ErrorCarga = $"No se pudieron cargar las mascotas: {ex.Message}"; return; }

        List<MascovetDomain.Citas.Cita> citas = new();
        List<MascovetDomain.AtencionesMedicas.Vacunacion> vacunas = new();
        List<MascovetDomain.AtencionesMedicas.Vacuna> catalogoVacunas = new();
        try { citas = await CitasREST.ListarTodosAsync(); }
        catch (Exception ex) { ErrorCarga = $"No se pudo consultar la próxima cita: {ex.Message}"; }
        try { catalogoVacunas = await VacunasREST.ListarTodosAsync(); }
        catch (Exception ex) { ErrorCarga = (ErrorCarga is null ? "" : ErrorCarga + " ") + $"Catálogo de vacunas: {ex.Message}"; }
        try { vacunas = await VacunacionesREST.ListarTodosAsync(); }
        catch (Exception ex) { ErrorCarga = (ErrorCarga is null ? "" : ErrorCarga + " ") + $"No se pudieron consultar las vacunas: {ex.Message}"; }
        ListaMascotas = mascotas.Select(m =>
        {
            var proxima = citas.Where(c => c.Mascota?.IdMascota == m.IdMascota && c.Fecha.HasValue &&
                c.Fecha.Value.Date >= DateTime.Today && c.Estado is not MascovetDomain.Enums.EstadoCita.CANCELADA)
                .OrderBy(c => c.Fecha).ThenBy(c => c.Hora).FirstOrDefault();
            // La vacunación puede contener solo el ID de la cita, sin la mascota completa.
            var idsCitas = citas.Where(c => c.Mascota?.IdMascota == m.IdMascota)
                .Select(c => c.IdCita).ToHashSet();
            var vacuna = vacunas.Where(v => v.Cita is not null && idsCitas.Contains(v.Cita.IdCita))
                .OrderByDescending(v => v.FechaAplicacion).FirstOrDefault();
            var vacunaAplicada = vacuna?.Vacunas.FirstOrDefault();
            string? nombreVacuna = vacunaAplicada?.Nombre;
            if (string.IsNullOrWhiteSpace(nombreVacuna) && vacunaAplicada?.IdVacuna is > 0)
                nombreVacuna = catalogoVacunas.FirstOrDefault(v => v.IdVacuna == vacunaAplicada.IdVacuna)?.Nombre;
            if (string.IsNullOrWhiteSpace(nombreVacuna))
                nombreVacuna = vacuna is null ? "Sin registro" : "Vacuna sin asociar";
            return new MascotaListado(m.IdMascota, m.Nombre ?? "", m.Especie?.ToString() ?? "",
                m.Raza ?? "", m.Sexo?.ToString() ?? "",
                m.FechaNacimiento.HasValue ? DateOnly.FromDateTime(m.FechaNacimiento.Value) : null,
                nombreVacuna,
                vacuna?.FechaAplicacion is DateTime fv ? DateOnly.FromDateTime(fv) : null,
                proxima?.Fecha is DateTime fc ? DateOnly.FromDateTime(fc) : null,
                proxima?.Hora?.ToString("HH:mm"));
        }).ToList();
    }
    private IEnumerable<MascotaListado> MascotasFiltradas=>ListaMascotas.Where(m=>string.IsNullOrWhiteSpace(Busqueda)||
        Coincide(m.Nombre)||Coincide(m.Especie)||Coincide(m.Raza));
    private bool Coincide(string texto)=>texto.Contains(Busqueda?.Trim()??"",StringComparison.OrdinalIgnoreCase);
    private static string FormatoFecha(DateOnly? fecha)=>fecha?.ToString("dd/MM/yyyy",CultureInfo.InvariantCulture)??"No registrada";
    private static string CalcularEdad(DateOnly? nacimiento)
    {
        if(nacimiento is null)return "No registrada";
        var hoy=DateOnly.FromDateTime(DateTime.Today);var f=nacimiento.Value;
        if(f>hoy)return "Por verificar";
        int anios=hoy.Year-f.Year;if(f>hoy.AddYears(-anios))anios--;
        if(anios>0)return anios==1?"1 año":$"{anios} años";
        int meses=(hoy.Year-f.Year)*12+hoy.Month-f.Month;
        if(hoy.Day<f.Day)meses--;
        return meses<=0?"Menos de un mes":meses==1?"1 mes":$"{meses} meses";
    }
    private static string ObtenerIconoEspecie(string especie)=>especie.Trim().ToLowerInvariant() switch{"gato"=>"cat","perro"=>"dog",_=>"paw-print"};
    private static string HistorialHref(int mascotaId)=>$"/cliente/mascotas/{mascotaId}/historial";
    private static string ReservaHref(int mascotaId)=>$"/cliente/reservar?mascotaId={mascotaId}";
    private sealed record MascotaListado(int Id,string Nombre,string Especie,string Raza,string Sexo,
        DateOnly? FechaNacimiento,string UltimaVacuna,DateOnly? FechaUltimaVacuna,DateOnly? FechaProximaCita,string? HoraProximaCita);
}
