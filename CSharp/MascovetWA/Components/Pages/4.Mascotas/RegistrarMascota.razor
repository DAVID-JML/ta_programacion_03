
@inject MascotaRestService MascotasREST
@inject ClienteRestService ClientesREST
@inject UserContext User
@inject NavigationManager Navigation
@page "/cliente/mascotas/nueva"
@layout MainLayout

@inject ToastService Toast

<PageTitle>Registrar mascota | Mascovet</PageTitle>

<div class="registrar-mascota">

    <header class="registrar-mascota__header">
        <h1>Registrar mascota</h1>
        <p>
            Registra a tu compañero para llevar el seguimiento de sus citas y su salud.
        </p>
    </header>
    <EditForm Model="@modelo" OnValidSubmit="@Registrar">
        <DataAnnotationsValidator />
        <ValidationSummary class="registrar-mascota__validation" />

        <AppCard Title="Información de la mascota"
                 Subtitle="Completa los datos de tu mascota para continuar.">

            <ChildContent>
                <div class="registrar-mascota__grid">

                    <div class="registrar-mascota__field">
                        <AppInput TValue="string"
                                  Id="mascota-nombre"
                                  Label="Nombre"
                                  Placeholder="Nombre de tu mascota"
                                  Required="true"
                                  maxlength="150"
                                  autocomplete="off"
                                  @bind-Value="modelo.Nombre" />
                    </div>

                    <div class="registrar-mascota__field">
                        <AppDatePicker Id="mascota-fecha-nacimiento"
                                       Label="Fecha de nacimiento"
                                       Required="true" HelpText="Campo requerido para este registro."
                                       Max="@FechaMaxima"
                                       @bind-Value="modelo.FechaNacimiento" />
                    </div>

                    <div class="registrar-mascota__field">
                        <AppSelect TValue="string"
                                   Id="mascota-especie"
                                   Label="Especie"
                                   Placeholder="Selecciona la especie"
                                   Required="true"
                                   Options="@OpcionesEspecie"
                                   @bind-Value="modelo.Especie" />
                    </div>

                    <div class="registrar-mascota__field">
                        <AppInput TValue="string"
                                  Id="mascota-raza"
                                  Label="Raza"
                                  Placeholder="Ej. Mestiza, Labrador o Desconocida"
                                  maxlength="150"
                                  Required="true" HelpText="Si no se conoce, escribe Desconocida."
                                  @bind-Value="modelo.Raza" />
                    </div>

                    <div class="registrar-mascota__field">
                        <AppSelect TValue="string"
                                   Id="mascota-sexo"
                                   Label="Sexo"
                                   Placeholder="Selecciona el sexo"
                                   Required="true"
                                   Options="@OpcionesSexo"
                                   @bind-Value="modelo.Sexo" />
                    </div>

                </div>

            </ChildContent>

            <Footer>
                <div class="registrar-mascota__actions">

                    <AppButton Href="/cliente/mascotas"
                               Variant="ButtonVariant.Secondary"
                               Icon="chevron-left">
                        Cancelar
                    </AppButton>

                    <AppButton Type="submit"
                               Variant="ButtonVariant.Primary"
                               Icon="check-circle">
                        Registrar mascota
                    </AppButton>

                </div>
            </Footer>

        </AppCard>
    </EditForm>

</div>

@code {
    private readonly MascotaModel modelo=new();
    private DateOnly FechaMaxima=>DateOnly.FromDateTime(DateTime.Today);
    private readonly List<SelectOption<string>> OpcionesEspecie=[new("PERRO","Perro"),new("GATO","Gato"),new("AVE","Ave"),new("CONEJO","Conejo")];
    private readonly List<SelectOption<string>> OpcionesSexo=[new("MACHO","Macho"),new("HEMBRA","Hembra")];
    private int? idCliente;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var clientes=await ClientesREST.ListarTodosAsync();
            idCliente=clientes.Where(c=>c.Activo&&!string.IsNullOrWhiteSpace(User.UsuarioVinculado)&&
                string.Equals(c.NombreUsuario,User.UsuarioVinculado,StringComparison.OrdinalIgnoreCase))
                .Select(c=>(int?)c.IdUsuario).SingleOrDefault();
        }
        catch(Exception ex){Toast.Error($"No se pudo identificar al cliente: {ex.Message}");}
    }
    private async Task Registrar()
    {
        if(!idCliente.HasValue){Toast.Warning("No se puede identificar al cliente. Revisa los datos de acceso.");return;}
        try
        {
            int result=await MascotasREST.InsertarAsync(new MascovetDomain.Mascotas.Mascota{
                Cliente=new MascovetDomain.Usuarios.Cliente{IdUsuario=idCliente.Value},
                Nombre=modelo.Nombre,FechaNacimiento=modelo.FechaNacimiento!.Value.ToDateTime(TimeOnly.MinValue),
                Especie=Enum.Parse<MascovetDomain.Enums.Especie>(modelo.Especie),Raza=modelo.Raza,
                Sexo=Enum.Parse<MascovetDomain.Enums.Sexo>(modelo.Sexo)});
            if(result<=0){Toast.Warning("No se confirmó el registro.");return;}
            Toast.Success("Mascota registrada.");Navigation.NavigateTo("/cliente/mascotas");
        }
        catch(Exception ex){Toast.Error($"No se pudo registrar la mascota: {ex.Message}");}
    }
    private sealed class MascotaModel : IValidatableObject
    {
        [Required(ErrorMessage = "Ingresa el nombre de la mascota.")]
        [StringLength(150,
            ErrorMessage = "El nombre no puede superar los 150 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa la fecha de nacimiento.")]
        public DateOnly? FechaNacimiento { get; set; }

        [Required(ErrorMessage = "Selecciona una especie.")]
        public string Especie { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa la raza.")]
        [StringLength(150,
            ErrorMessage = "La raza no puede superar los 150 caracteres.")]
        public string Raza { get; set; } = string.Empty;

        [Required(ErrorMessage = "Selecciona una opción para el sexo.")]
        public string Sexo { get; set; } = string.Empty;

        public IEnumerable<ValidationResult> Validate(
            ValidationContext validationContext)
        {
            if (FechaNacimiento.HasValue &&
                FechaNacimiento.Value >
                DateOnly.FromDateTime(DateTime.Today))
            {
                yield return new ValidationResult(
                    "La fecha de nacimiento no puede ser futura.",
                    [nameof(FechaNacimiento)]);
            }
        }
    }
}
