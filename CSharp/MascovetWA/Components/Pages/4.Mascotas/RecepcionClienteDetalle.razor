@page "/recepcion/clientes/{Id:int}"
@inject ClienteRestService ClientesREST
@inject MascotaRestService MascotasREST
@inject CitaRestService CitasREST
@inject VeterinarioRestService VeterinariosREST
@layout MainLayout

<PageTitle>Ficha del cliente | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div><h1>Ficha del cliente</h1><p>Información de contacto, mascotas registradas y citas del cliente.</p></div>
        <AppButton Href="/recepcion/clientes" Variant="ButtonVariant.Secondary">Volver al directorio</AppButton>
    </header>
    @if (Cliente is null)
    {
        <AppCard Title="Cliente no disponible"><p>@(Error ?? "No se encontró el cliente solicitado.")</p></AppCard>
    }
    else
    {
        <AppCard Title="@Cliente.Nombre" Subtitle="Datos personales y contacto">
            <div class="ms-detail-grid">
                <div><span>DNI</span><strong>@Cliente.Dni</strong></div>
                <div><span>Teléfono</span><strong>@Cliente.Telefono</strong></div>
                <div><span>Correo electrónico</span><strong>@Cliente.Correo</strong></div>
                <div><span>Estado</span><AppBadge Variant="@(Cliente.Activo ? SemanticVariant.Success : SemanticVariant.Warning)" ShowIcon="false">@(Cliente.Activo ? "Activo" : "Inactivo")</AppBadge></div>
            </div>
            <div class="ms-inline-actions">
                <AppButton Href="@($"/recepcion/clientes/editar/{Id}")">Editar cliente</AppButton>
                <AppButton Href="@($"/recepcion/mascotas/nueva?cliente={Id}")" Variant="ButtonVariant.Secondary">Registrar mascota</AppButton>
            </div>
        </AppCard>
        @if (!string.IsNullOrWhiteSpace(Aviso))
        {
            <p role="alert" class="ms-small-note">@Aviso</p>
        }
        <AppCard Title="Mascotas del cliente" Subtitle="Accede a su ficha, cartilla y seguimiento.">
            <AppTable Items="Cliente.Mascotas" Caption="Mascotas del cliente" ColumnCount="4">
                <HeaderContent><th>Mascota</th><th>Especie</th><th>Estado</th><th>Acciones</th></HeaderContent>
                <RowTemplate Context="m">
                    <td>@m.Nombre</td><td>@m.Especie</td><td>@(m.Activo ? "Activa" : "Inactiva")</td>
                    <td><div class="ms-inline-actions">
                        <AppButton Href="@($"/recepcion/mascotas/{m.Id}")" Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Ver ficha</AppButton>
                        <AppButton Href="@($"/recepcion/mascotas/{m.Id}/cartilla")" Variant="ButtonVariant.Tertiary" Size="ButtonSize.Small">Cartilla</AppButton>
                    </div></td>
                </RowTemplate>
            </AppTable>
        </AppCard>
        <AppCard Title="Próximas citas" Subtitle="Citas asociadas a las mascotas del cliente.">
            <AppTable Items="Cliente.Citas" Caption="Citas del cliente" ColumnCount="4">
                <HeaderContent><th>Mascota</th><th>Fecha</th><th>Veterinario</th><th>Estado</th></HeaderContent>
                <RowTemplate Context="c"><td>@c.Mascota</td><td>@c.Fecha</td><td>@c.Veterinario</td><td>@c.Estado</td></RowTemplate>
                <EmptyContent><AppEmptyState Title="Sin citas" Description="El cliente no tiene citas registradas." Icon="calendar" /></EmptyContent>
            </AppTable>
            <AppButton Href="@($"/recepcion/citas/nueva?cliente={Id}")" Variant="ButtonVariant.Secondary">Registrar cita</AppButton>
        </AppCard>
    }
</div>
@code {
    [Parameter] public int Id { get; set; }
    private string? Error;
    private string? Aviso;
    private sealed record MascotaFila(int Id, string Nombre, string Especie, bool Activo);
    private sealed record CitaFila(string Mascota, string Fecha, string Veterinario, string Estado);
    private sealed record ClienteFicha(string Nombre, string Dni, string Telefono, string Correo, bool Activo,
        List<MascotaFila> Mascotas, List<CitaFila> Citas);
    private ClienteFicha? Cliente;
    protected override async Task OnParametersSetAsync()
    {
        Error = null;
        Aviso = null;
        Cliente = null;
        MascovetDomain.Usuarios.Cliente? c = null;
        try { c = await ClientesREST.BuscarPorIdAsync(Id); }
        catch { /* Si falla la búsqueda individual, se intenta con la lista. */ }
        if (c is null)
        {
            try { c = (await ClientesREST.ListarTodosAsync()).FirstOrDefault(x => x.IdUsuario == Id); }
            catch (Exception ex) { Error = $"No se pudo consultar el cliente: {ex.Message}"; return; }
        }
        if (c is null) { Error = "No se encontró el cliente solicitado."; return; }
        List<MascovetDomain.Mascotas.Mascota> mascotas = new();
        try { mascotas = (await MascotasREST.ListarTodosAsync()).Where(m => m.Cliente?.IdUsuario == Id).ToList(); }
        catch (Exception ex) { Aviso = $"No se pudieron consultar las mascotas: {ex.Message}"; }
        List<MascovetDomain.Citas.Cita> citas = new();
        try
        {
            var ids = mascotas.Select(m => m.IdMascota).ToHashSet();
            citas = (await CitasREST.ListarTodosAsync())
                .Where(x => x.Mascota is not null && ids.Contains(x.Mascota.IdMascota)).ToList();
        }
        catch (Exception ex) { Aviso = $"No se pudieron consultar las citas: {ex.Message}"; }
        List<MascovetDomain.Usuarios.Veterinario> veterinarios = new();
        try { veterinarios = await VeterinariosREST.ListarTodosAsync(); }
        catch { /* El ID sigue visible si falta el catálogo de veterinarios. */ }
        Cliente = new ClienteFicha($"{c.Nombre} {c.ApellidoPaterno} {c.ApellidoMaterno}".Trim(),
            c.Dni ?? "", c.Telefono ?? "", c.Correo ?? "", c.Activo,
            mascotas.Select(m => new MascotaFila(m.IdMascota, m.Nombre ?? "", m.Especie?.ToString() ?? "", m.Activo)).ToList(),
            citas.OrderBy(x => x.Estado switch {MascovetDomain.Enums.EstadoCita.CONFIRMADA=>0,MascovetDomain.Enums.EstadoCita.RESERVADA=>1,MascovetDomain.Enums.EstadoCita.ATENDIDA=>2,MascovetDomain.Enums.EstadoCita.CANCELADA=>3,_=>4}).ThenBy(x=>x.Fecha).ThenBy(x=>x.Hora).Select(x =>
            {
                int idMascota = x.Mascota?.IdMascota ?? 0;
                int idVet = x.Veterinario?.IdUsuario ?? 0;
                var mascota = mascotas.FirstOrDefault(m => m.IdMascota == idMascota);
                var vet = veterinarios.FirstOrDefault(v => v.IdUsuario == idVet) ?? x.Veterinario;
                return new CitaFila(mascota?.Nombre ?? (idMascota > 0 ? $"Mascota #{idMascota}" : "—"),
                    $"{x.Fecha:dd/MM/yyyy} {x.Hora}",
                    !string.IsNullOrWhiteSpace($"{vet?.Nombre} {vet?.ApellidoPaterno}".Trim())
                        ? $"{vet?.Nombre} {vet?.ApellidoPaterno}".Trim()
                        : idVet > 0 ? $"Veterinario #{idVet}" : "—",
                    x.Estado?.ToString() ?? "");
            }).ToList());
    }
}
