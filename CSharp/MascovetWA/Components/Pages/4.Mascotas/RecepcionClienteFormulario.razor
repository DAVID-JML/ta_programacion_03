@page "/recepcion/clientes/nuevo"
@inject ClienteRestService ClientesREST
@inject NavigationManager Navigation
@page "/recepcion/clientes/editar/{Id:int}"
@layout MainLayout
@inject ToastService Toast

<PageTitle>@Titulo | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header"><div><h1>@Titulo</h1><p>Datos personales y de contacto del cliente.</p></div></header>
    <EditForm Model="modelo" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <AppCard Title="Datos del cliente">
            <div class="form-grid">
                <div class="span-4"><AppInput TValue="string" Label="Nombres" Required="true" maxlength="50" @bind-Value="modelo.Nombres" /></div>
                <div class="span-4"><AppInput TValue="string" Label="Apellido paterno" Required="true" maxlength="50" @bind-Value="modelo.Paterno" /></div>
                <div class="span-4"><AppInput TValue="string" Label="Apellido materno" Required="true" maxlength="50" @bind-Value="modelo.Materno" /></div>
                <div class="span-4"><AppInput TValue="string" Label="DNI" Required="true" maxlength="8" @bind-Value="modelo.Dni" /></div>
                <div class="span-4"><AppInput TValue="string" Label="Teléfono" Type="tel" Required="true" maxlength="20" @bind-Value="modelo.Telefono" /></div>
                <div class="span-4"><AppInput TValue="string" Label="Correo electrónico" Type="email" Required="true" maxlength="200" @bind-Value="modelo.Correo" /></div>
            </div>
        </AppCard>
        @if (!EsEdicion)
        {
            <AppCard Title="Datos de acceso" Subtitle="Credenciales iniciales para la nueva cuenta.">
                <div class="form-grid">
                    <div class="span-6"><AppInput TValue="string" Label="Usuario" Required="true" autocomplete="username" @bind-Value="modelo.Usuario" /></div>
                    <div class="span-6"><AppInput TValue="string" Label="Contraseña inicial" Type="password" Required="true" autocomplete="new-password" @bind-Value="modelo.Contrasena" /></div>
                </div>
            </AppCard>
        }
        <div class="acciones">
            <AppButton Type="submit">@(EsEdicion ? "Guardar cambios" : "Registrar cliente")</AppButton>
            <AppButton Href="/recepcion/clientes" Variant="ButtonVariant.Secondary">Cancelar</AppButton>
        </div>
    </EditForm>
</div>
@code {
    [Parameter] public int? Id { get; set; }
    private bool EsEdicion => Id.HasValue;
    private string Titulo => EsEdicion ? "Editar cliente" : "Registrar cliente";
    private ClienteModel modelo = new();
    private MascovetDomain.Usuarios.Cliente? clienteOriginal;
    protected override async Task OnParametersSetAsync()
    {
        modelo = new(); clienteOriginal = null;
        if (!Id.HasValue) return;
        try
        {
            clienteOriginal = await ClientesREST.BuscarPorIdAsync(Id.Value);
            if (clienteOriginal is null) { Toast.Warning("Cliente no encontrado."); return; }
            modelo = new()
            {
                Nombres = clienteOriginal.Nombre ?? "", Paterno = clienteOriginal.ApellidoPaterno ?? "",
                Materno = clienteOriginal.ApellidoMaterno ?? "", Dni = clienteOriginal.Dni ?? "",
                Telefono = clienteOriginal.Telefono ?? "", Correo = clienteOriginal.Correo ?? "",
                Usuario = clienteOriginal.NombreUsuario ?? ""
            };
        }
        catch (Exception ex) { Toast.Error($"No se pudo cargar el cliente: {ex.Message}"); }
    }
    private async Task Guardar()
    {
        try
        {
            var cliente = clienteOriginal ?? new MascovetDomain.Usuarios.Cliente();
            cliente.Nombre = modelo.Nombres; cliente.ApellidoPaterno = modelo.Paterno;
            cliente.ApellidoMaterno = modelo.Materno; cliente.Dni = modelo.Dni;
            cliente.Telefono = modelo.Telefono; cliente.Correo = modelo.Correo;
            if (!EsEdicion) { cliente.NombreUsuario = modelo.Usuario; cliente.Contrasena = modelo.Contrasena; }
            int resultado = EsEdicion ? await ClientesREST.ModificarAsync(cliente) : await ClientesREST.InsertarAsync(cliente);
            if (resultado <= 0) { Toast.Warning("El servidor no confirmó el registro."); return; }
            Toast.Success(EsEdicion ? "Cliente actualizado." : "Cliente registrado.");
            Navigation.NavigateTo("/recepcion/clientes");
        }
        catch (Exception ex) { Toast.Error($"No se pudo guardar el cliente: {ex.Message}"); }
    }
    private sealed class ClienteModel
    {
        [Required] public string Nombres { get; set; } = "";
        [Required] public string Paterno { get; set; } = "";
        [Required] public string Materno { get; set; } = "";
        [Required] public string Dni { get; set; } = "";
        [Required] public string Telefono { get; set; } = "";
        [Required, EmailAddress] public string Correo { get; set; } = "";
        public string Usuario { get; set; } = "";
        public string Contrasena { get; set; } = "";
    }
}
