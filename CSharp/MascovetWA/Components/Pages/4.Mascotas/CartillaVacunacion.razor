@page "/cliente/mascotas/{IdMascota:int}/cartilla"
@inject MascotaRestService MascotasREST
@inject VacunacionRestService VacunacionesREST
@inject VacunaRestService VacunasREST
@inject CitaRestService CitasREST
@inject VeterinarioRestService VeterinariosREST
@page "/recepcion/mascotas/{IdMascota:int}/cartilla"
@page "/veterinario/mascotas/{IdMascota:int}/cartilla"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>Cartilla de vacunación | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div><h1>Cartilla de vacunación</h1><p>Registro de vacunas aplicadas y seguimiento de próximas dosis.</p></div>
        <AppButton Href="@($"/{Prefijo}/mascotas/{IdMascota}")" Variant="ButtonVariant.Secondary">Volver a la ficha</AppButton>
    </header>
    @if (Mascota is null)
    {
        <AppCard Title="Cartilla no disponible"><p>@(Error ?? "No se encontró información para la mascota solicitada.")</p></AppCard>
    }
    else
    {
        <AppCard Title="@($"Cartilla de {Mascota}")" Subtitle="Consulta de historial de vacunación">
            <div class="ms-detail-grid">
                <div><span>Nombre</span><strong>@Mascota</strong></div>
                <div><span>Próxima dosis programada</span><strong>@(Vacunas.Where(v => v.ProximaDosis.HasValue).OrderBy(v => v.ProximaDosis).FirstOrDefault()?.ProximaDosis?.ToString("dd/MM/yyyy") ?? "Sin fecha programada")</strong></div>
            </div>
        </AppCard>
        <AppCard Title="Vacunas aplicadas" Subtitle="Fechas, dosis y profesional responsable.">
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p role="alert" class="ms-small-note">No fue posible consultar el registro de vacunaciones desde Java REST: @Error</p>
            }
            <AppTable Items="Vacunas.OrderByDescending(v=>v.Fecha)" Caption="Cartilla de vacunación" ColumnCount="6">
                <HeaderContent><th>Vacuna</th><th>Dosis</th><th>Fecha aplicada</th><th>Próxima dosis</th><th>Veterinario</th><th>Estado</th></HeaderContent>
                <RowTemplate Context="v">
                    <td>@v.Nombre</td><td>@v.Dosis</td><td>@v.Fecha.ToString("dd/MM/yyyy")</td><td>@(v.ProximaDosis?.ToString("dd/MM/yyyy") ?? "No programada")</td><td>@v.Veterinario</td>
                    <td><AppBadge Variant="@(v.ProximaDosis.HasValue && v.ProximaDosis < DateOnly.FromDateTime(DateTime.Today) ? SemanticVariant.Warning : SemanticVariant.Success)" ShowIcon="false">@(v.ProximaDosis.HasValue && v.ProximaDosis < DateOnly.FromDateTime(DateTime.Today) ? "Revisar dosis" : "Aplicada")</AppBadge></td>
                </RowTemplate>
                <EmptyContent>
                    @if (string.IsNullOrWhiteSpace(Error))
                    {
                        <AppEmptyState Icon="check-circle" Title="Sin vacunas registradas" Description="Aún no existen vacunas asociadas a esta mascota." />
                    }
                </EmptyContent>
            </AppTable>
            @if (EsVeterinario) { <div class="acciones"><AppButton Href="@($"/veterinario/vacunas?mascota={IdMascota}")" Icon="check-circle">Consultar y gestionar vacunaciones</AppButton></div> }
        </AppCard>
    }
</div>
@code {
    [Parameter] public int IdMascota { get; set; }
    private string Prefijo => Navigation.ToBaseRelativePath(Navigation.Uri).Split('/')[0].ToLowerInvariant();
    private bool EsVeterinario => Prefijo == "veterinario";
    private string? Mascota;
    private string? Error;
    private sealed record VacunaFila(string Nombre, string Dosis, DateOnly Fecha, DateOnly? ProximaDosis, string Veterinario);
    private List<VacunaFila> Vacunas = new();
    protected override async Task OnParametersSetAsync()
    {
        Mascota = null;
        Error = null;
        Vacunas.Clear();
        // Recuperar primero el nombre de la mascota. Un error al listar
        // vacunas no debe impedir que la cartilla se abra.
        try { Mascota = (await MascotasREST.BuscarPorIdAsync(IdMascota))?.Nombre; }
        catch (Exception) { /* Se intenta con la lista general. */ }
        if (string.IsNullOrWhiteSpace(Mascota))
        {
            try { Mascota = (await MascotasREST.ListarTodosAsync()).FirstOrDefault(m => m.IdMascota == IdMascota)?.Nombre; }
            catch (Exception ex) { Error = $"Mascota: {ex.Message}"; }
        }
        if (string.IsNullOrWhiteSpace(Mascota)) return;
        List<MascovetDomain.Usuarios.Veterinario> veterinarios = new();
        try { veterinarios = await VeterinariosREST.ListarTodosAsync(); }
        catch { /* El ID sigue disponible aunque los nombres no carguen. */ }
        List<MascovetDomain.AtencionesMedicas.Vacuna> catalogoVacunas = new();
        try { catalogoVacunas = await VacunasREST.ListarTodosAsync(); }
        catch (Exception ex) { Error = $"No se pudo consultar el catálogo de vacunas: {ex.Message}"; }
        try
        {
            // VacunacionRS devuelve solo el ID de Cita. Relacionar con las citas
            // completas para determinar a qué mascota pertenece cada vacuna.
            var citas = await CitasREST.ListarTodosAsync();
            var ids = citas.Where(c => c.Mascota?.IdMascota == IdMascota)
                .Select(c => c.IdCita).ToHashSet();
            Vacunas = (await VacunacionesREST.ListarTodosAsync())
                .Where(v => v.Cita is not null && ids.Contains(v.Cita.IdCita))
                .SelectMany(v => v.Vacunas.Count > 0
                        ? v.Vacunas.Cast<MascovetDomain.AtencionesMedicas.Vacuna?>()
                        : new MascovetDomain.AtencionesMedicas.Vacuna?[] { null },
                    (v, vacuna) =>
                    {
                        int idVet = v.Cita?.Veterinario?.IdUsuario ?? 0;
                        var cita = citas.FirstOrDefault(c => c.IdCita == v.Cita?.IdCita);
                        idVet = cita?.Veterinario?.IdUsuario ?? idVet;
                        var vet = veterinarios.FirstOrDefault(x => x.IdUsuario == idVet)
                            ?? cita?.Veterinario ?? v.Cita?.Veterinario;
                        string nombre = $"{vet?.Nombre} {vet?.ApellidoPaterno}".Trim();
                        if (string.IsNullOrWhiteSpace(nombre)) nombre = idVet > 0 ? $"Veterinario #{idVet}" : "—";
                        string? nombreVacuna = vacuna?.Nombre;
                        if (string.IsNullOrWhiteSpace(nombreVacuna) && vacuna?.IdVacuna is > 0)
                            nombreVacuna = catalogoVacunas.FirstOrDefault(x => x.IdVacuna == vacuna.IdVacuna)?.Nombre;
                        if (string.IsNullOrWhiteSpace(nombreVacuna))
                            nombreVacuna = vacuna?.IdVacuna is > 0
                                ? $"Vacuna #{vacuna.IdVacuna}" : "Vacuna sin asociar";
                        return new VacunaFila(nombreVacuna, v.Dosis ?? "",
                            DateOnly.FromDateTime(v.FechaAplicacion ?? cita?.Fecha ?? DateTime.Today),
                            v.FechaProximaDosis.HasValue ? DateOnly.FromDateTime(v.FechaProximaDosis.Value) : null, nombre);
                    }).ToList();
        }
        catch (Exception ex) { Error = $"No se pudieron cargar las vacunaciones: {ex.Message}"; }
    }
}
