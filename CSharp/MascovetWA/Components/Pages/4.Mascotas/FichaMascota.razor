@page "/cliente/mascotas/{IdMascota:int}"
@inject MascotaRestService MascotasREST
@inject ClienteRestService ClientesREST
@inject VeterinarioRestService VeterinariosREST
@inject CitaRestService CitasREST
@inject ConsultaRestService ConsultasREST
@inject ControlRestService ControlesREST
@inject CirugiaRestService CirugiasREST
@inject VacunacionRestService VacunacionesREST
@page "/recepcion/mascotas/{IdMascota:int}"
@page "/veterinario/mascotas/{IdMascota:int}"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>Ficha de mascota | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div><h1>Ficha de mascota</h1><p>Datos generales y acceso al seguimiento médico.</p></div>
        <AppButton Href="@VolverHref" Variant="ButtonVariant.Secondary">Volver</AppButton>
    </header>
    @if (Mascota is null)
    {
        <AppCard Title="Mascota no disponible"><p>@(Error ?? "No se encontró la mascota solicitada.")</p></AppCard>
    }
    else
    {
        <AppCard Title="@Mascota.Nombre" Subtitle="@($"{Mascota.Especie} · {Mascota.Raza}")">
            <div class="ms-detail-grid">
                <div><span>Sexo</span><strong>@Mascota.Sexo</strong></div>
                <div><span>Fecha de nacimiento</span><strong>@Mascota.Nacimiento</strong></div>
                <div><span>Propietario</span><strong>@Mascota.Propietario</strong></div>
                <div><span>Teléfono del propietario</span><strong>@Mascota.Telefono</strong></div>
                <div><span>Correo electrónico</span><strong>@Mascota.Correo</strong></div>
                <div><span>Estado</span><AppBadge Variant="@(Mascota.Activo ? SemanticVariant.Success : SemanticVariant.Warning)" ShowIcon="false">@(Mascota.Activo ? "Activa" : "Inactiva")</AppBadge></div>
            </div>
            <div class="ms-inline-actions">
                <AppButton Href="@CartillaHref" Icon="check-circle">Cartilla de vacunación</AppButton>
                <AppButton Href="@HistorialHref" Variant="ButtonVariant.Secondary" Icon="file-text">Historial médico</AppButton>
                @if (!EsVeterinario) { <AppButton Href="@($"/{Prefijo}/mascotas/{IdMascota}/editar")" Variant="ButtonVariant.Tertiary">Editar mascota</AppButton> }
                @if (EsRecepcion && Mascota.IdCliente > 0) { <AppButton Href="@($"/recepcion/clientes/{Mascota.IdCliente}")" Variant="ButtonVariant.Tertiary">Ver propietario</AppButton> }
            </div>
        </AppCard>
        @if (ErroresSecundarios.Count > 0)
        {
            <p role="alert" class="ms-small-note">Algunos datos médicos no pudieron cargarse desde Java REST. @AvisoMedico</p>
        }
        <AppCard Title="Citas de la mascota" Subtitle="Consulta las citas programadas y realizadas.">
            <AppTable Items="Mascota.Citas.OrderBy(c=>PrioridadEstado(c.Estado)).ThenBy(c=>ParseFecha(c.Fecha))" Caption="Citas asociadas" ColumnCount="4">
                <HeaderContent><th>Fecha y hora</th><th>Tipo</th><th>Veterinario</th><th>Estado</th></HeaderContent>
                <RowTemplate Context="c"><td>@c.Fecha</td><td>@c.Tipo</td><td>@c.Veterinario</td><td>@c.Estado</td></RowTemplate>
                <EmptyContent><AppEmptyState Icon="calendar" Title="Sin citas" Description="No hay citas asociadas a esta mascota." /></EmptyContent>
            </AppTable>
        </AppCard>
        <AppCard Title="Atenciones recientes">
            <AppTable Items="Mascota.Atenciones.OrderByDescending(a=>ParseFecha(a.Fecha))" Caption="Atenciones médicas" ColumnCount="4">
                <HeaderContent><th>Fecha</th><th>Tipo de atención</th><th>Veterinario</th><th>Resumen</th></HeaderContent>
                <RowTemplate Context="a"><td>@a.Fecha</td><td>@a.Tipo</td><td>@a.Veterinario</td><td>@a.Resultado</td></RowTemplate>
                <EmptyContent><AppEmptyState Icon="file-text" Title="Sin atenciones" Description="No hay atenciones registradas." /></EmptyContent>
            </AppTable>
        </AppCard>
    }
</div>
@code {
    [Parameter] public int IdMascota { get; set; }
    private string Prefijo => Navigation.ToBaseRelativePath(Navigation.Uri).Split('/')[0].ToLowerInvariant();
    private bool EsRecepcion => Prefijo == "recepcion";
    private bool EsVeterinario => Prefijo == "veterinario";
    private string VolverHref => EsRecepcion ? "/recepcion/mascotas" : EsVeterinario ? "/veterinario/agenda" : "/cliente/mascotas";
    private string CartillaHref => $"/{Prefijo}/mascotas/{IdMascota}/cartilla";
    private string HistorialHref => EsVeterinario ? $"/veterinario/historias?mascota={IdMascota}" : $"/{Prefijo}/mascotas/{IdMascota}/historial";
    private static int PrioridadEstado(string estado) => estado switch { "CONFIRMADA"=>0,"RESERVADA"=>1,"ATENDIDA"=>2,"CANCELADA"=>3,_=>4 };
    private static DateTime ParseFecha(string valor) => DateTime.TryParseExact(valor, new[]{"dd/MM/yyyy HH:mm","dd/MM/yyyy"},System.Globalization.CultureInfo.InvariantCulture,System.Globalization.DateTimeStyles.None,out var fecha)?fecha:DateTime.MaxValue;
    private sealed record CitaFila(string Fecha, string Tipo, string Veterinario, string Estado);
    private sealed record AtencionFila(string Fecha, string Tipo, string Veterinario, string Resultado);
    private sealed record MascotaFicha(string Nombre, string Especie, string Raza, string Sexo, string Nacimiento,
        int IdCliente, string Propietario, string Telefono, string Correo, bool Activo, List<CitaFila> Citas, List<AtencionFila> Atenciones);
    private MascotaFicha? Mascota;
    private string? Error;
    private readonly List<string> ErroresSecundarios = new();
    private string AvisoMedico => string.Join(" | ", ErroresSecundarios);
    protected override async Task OnParametersSetAsync()
    {
        Error = null;
        Mascota = null;
        ErroresSecundarios.Clear();
        MascovetDomain.Mascotas.Mascota? m = null;
        try { m = await MascotasREST.BuscarPorIdAsync(IdMascota); }
        catch (Exception ex)
        {
            // Si la búsqueda por ID falla en Java, usar el listado que ya
            // permite mostrar mascotas en recepción.
            ErroresSecundarios.Add($"Ficha individual: {ex.Message}");
        }
        if (m is null)
        {
            try { m = (await MascotasREST.ListarTodosAsync()).FirstOrDefault(x => x.IdMascota == IdMascota); }
            catch (Exception ex) { Error = $"No fue posible consultar la mascota: {ex.Message}"; return; }
        }
        if (m is null) { Error = "No existe la mascota solicitada."; return; }

        int idCliente = m.Cliente?.IdUsuario ?? 0;
        MascovetDomain.Usuarios.Cliente? propietario = m.Cliente;
        try
        {
            // MascotaRS devuelve el propietario solamente con ID.
            // ClienteRS sí devuelve los datos personales.
            var clientes = await ClientesREST.ListarTodosAsync();
            propietario = clientes.FirstOrDefault(c => c.IdUsuario == idCliente) ?? propietario;
        }
        catch (Exception ex) { ErroresSecundarios.Add($"Propietario: {ex.Message}"); }

        var nombrePropietario = $"{propietario?.Nombre} {propietario?.ApellidoPaterno} {propietario?.ApellidoMaterno}".Trim();
        if (string.IsNullOrWhiteSpace(nombrePropietario))
            nombrePropietario = idCliente > 0 ? $"Cliente #{idCliente}" : "Sin propietario asociado";

        List<MascovetDomain.Citas.Cita> citas = new();
        try { citas = (await CitasREST.ListarTodosAsync()).Where(x => x.Mascota?.IdMascota == IdMascota).ToList(); }
        catch (Exception ex) { ErroresSecundarios.Add($"Citas: {ex.Message}"); }

        List<MascovetDomain.Usuarios.Veterinario> veterinarios = new();
        try { veterinarios = await VeterinariosREST.ListarTodosAsync(); }
        catch (Exception ex) { ErroresSecundarios.Add($"Veterinarios: {ex.Message}"); }
        string NombreVeterinario(int id, MascovetDomain.Usuarios.Veterinario? parcial)
        {
            var v = veterinarios.FirstOrDefault(x => x.IdUsuario == id) ?? parcial;
            string nombre = $"{v?.Nombre} {v?.ApellidoPaterno}".Trim();
            return !string.IsNullOrWhiteSpace(nombre) ? nombre : id > 0 ? $"Veterinario #{id}" : "—";
        }

        var ids = citas.Select(c => c.IdCita).ToHashSet();
        string FechaCita(int idCita) => citas.FirstOrDefault(c => c.IdCita == idCita)?.Fecha?.ToString("dd/MM/yyyy") ?? "Sin fecha";
        string VeterinarioCita(int idCita)
        {
            var cita = citas.FirstOrDefault(c => c.IdCita == idCita);
            return NombreVeterinario(cita?.Veterinario?.IdUsuario ?? 0, cita?.Veterinario);
        }
        var atenciones = new List<AtencionFila>();
        // Cada colección clínica se carga por separado: un HTTP 500 no
        // debe borrar la ficha ni las secciones que sí respondieron.
        try
        {
            foreach (var x in await ConsultasREST.ListarTodosAsync())
                if (x.Cita is not null && ids.Contains(x.Cita.IdCita))
                    atenciones.Add(new(FechaCita(x.Cita.IdCita), "Consulta", VeterinarioCita(x.Cita.IdCita), x.Diagnostico ?? x.Observaciones ?? ""));
        }
        catch (Exception ex) { ErroresSecundarios.Add($"Consultas: {ex.Message}"); }
        try
        {
            foreach (var x in await ControlesREST.ListarTodosAsync())
                if (x.Cita is not null && ids.Contains(x.Cita.IdCita))
                    atenciones.Add(new(FechaCita(x.Cita.IdCita), "Control", VeterinarioCita(x.Cita.IdCita), x.Evolucion ?? x.Observaciones ?? ""));
        }
        catch (Exception ex) { ErroresSecundarios.Add($"Controles: {ex.Message}"); }
        try
        {
            foreach (var x in await CirugiasREST.ListarTodosAsync())
                if (x.Cita is not null && ids.Contains(x.Cita.IdCita))
                    atenciones.Add(new(FechaCita(x.Cita.IdCita), "Cirugía", VeterinarioCita(x.Cita.IdCita), x.Procedimiento ?? x.Observaciones ?? ""));
        }
        catch (Exception ex) { ErroresSecundarios.Add($"Cirugías: {ex.Message}"); }
        try
        {
            foreach (var x in await VacunacionesREST.ListarTodosAsync())
                if (x.Cita is not null && ids.Contains(x.Cita.IdCita))
                    atenciones.Add(new(x.FechaAplicacion?.ToString("dd/MM/yyyy") ?? "—", "Vacunación",
                        VeterinarioCita(x.Cita.IdCita), x.Dosis ?? ""));
        }
        catch (Exception ex) { ErroresSecundarios.Add($"Vacunaciones: {ex.Message}"); }

        Mascota = new(m.Nombre ?? "", m.Especie?.ToString() ?? "", m.Raza ?? "", m.Sexo?.ToString() ?? "",
            m.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—", idCliente, nombrePropietario,
            propietario?.Telefono ?? "No registrado", propietario?.Correo ?? "No registrado", m.Activo,
            citas.Select(x => new CitaFila($"{x.Fecha:dd/MM/yyyy} {x.Hora}", x.TipoAtencion?.ToString() ?? "",
                NombreVeterinario(x.Veterinario?.IdUsuario ?? 0, x.Veterinario), x.Estado?.ToString() ?? "")).ToList(), atenciones);
    }
}
