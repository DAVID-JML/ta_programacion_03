@page "/administrador/horarios"
@inject HorarioAtencionRestService HorariosREST
@inject VeterinarioRestService VeterinariosREST
@inject ToastService Toast
@layout MainLayout
<PageTitle>Horarios de atención | Mascovet</PageTitle>

<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div><h1>Horarios de atención</h1><p>Registra y administra la disponibilidad semanal de los veterinarios.</p></div>
    </header>

    <AppCard Title="Registrar horario">
        <div class="form-grid">
            <div class="span-6"><AppSelect TValue="string" Label="Veterinario" Options="veterinarios" @bind-Value="veterinario" /></div>
            <div class="span-6"><AppSelect TValue="string" Label="Día de la semana" Options="dias" @bind-Value="dia" /></div>
            <div class="span-6"><AppInput TValue="string" Type="time" Label="Hora de inicio" Required="true" @bind-Value="inicio" /></div>
            <div class="span-6"><AppInput TValue="string" Type="time" Label="Hora de fin" Required="true" @bind-Value="fin" /></div>
        </div>
        <div class="acciones">
            <AppButton OnClick="Registrar" Disabled="@guardando" Loading="@guardando">Registrar horario</AppButton>
            <AppButton OnClick="Limpiar" Variant="ButtonVariant.Secondary">Limpiar</AppButton>
        </div>
    </AppCard>

    <AppCard Title="Horarios registrados">
        <AppTable Items="horarios.OrderBy(h=>IndiceDia(h.Dia)).ThenBy(h=>h.Inicio)" ColumnCount="6" Caption="Horarios de veterinarios">
            <HeaderContent><th>Veterinario</th><th>Día</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Acciones</th></HeaderContent>
            <RowTemplate Context="h">
                <td>@h.Veterinario</td><td>@h.Dia</td><td>@h.Inicio</td><td>@h.Fin</td>
                <td><AppBadge Variant="@(h.Activo ? SemanticVariant.Success : SemanticVariant.Warning)" ShowIcon="false">@(h.Activo ? "Activo" : "Inactivo")</AppBadge></td>
                <td>
                    <div class="ms-inline-actions">
                        <AppButton Href="@($"/administrador/horarios/editar/{h.Id}")" Variant="ButtonVariant.Secondary" Size="ButtonSize.Small">Editar</AppButton>
                        <AppButton Variant="ButtonVariant.Danger" Size="ButtonSize.Small" OnClick="() => SolicitarInactivar(h)">Inactivar</AppButton>
                    </div>
                </td>
            </RowTemplate>
        </AppTable>
    </AppCard>
</div>

<AppModal @bind-Visible="mostrarSuperposicion" Title="No se puede guardar el horario">
    <ChildContent><p>El veterinario ya tiene un horario registrado que se superpone con el día y las horas seleccionadas. Elige otra franja horaria.</p></ChildContent>
    <Actions><AppButton OnClick="() => mostrarSuperposicion = false">Aceptar</AppButton></Actions>
</AppModal>
<AppModal @bind-Visible="mostrarInactivar" Title="Inactivar horario" ConfirmText="Inactivar" ConfirmVariant="ButtonVariant.Danger" OnConfirm="Inactivar">
    <p>¿Deseas inactivar el horario seleccionado?</p>
</AppModal>

@code {
    private sealed record HorarioFila(int Id, string Veterinario, string Dia, string Inicio, string Fin, bool Activo);
    private static int IndiceDia(string dia) => dia.ToUpperInvariant() switch { "LUNES"=>0,"MARTES"=>1,"MIERCOLES"=>2,"MIÉRCOLES"=>2,"JUEVES"=>3,"VIERNES"=>4,"SABADO"=>5,"SÁBADO"=>5,"DOMINGO"=>6,_=>7 };
    private List<HorarioFila> horarios = new();
    private List<SelectOption<string>> veterinarios = new();
    private readonly List<SelectOption<string>> dias = [new("LUNES", "Lunes"), new("MARTES", "Martes"), new("MIERCOLES", "Miércoles"), new("JUEVES", "Jueves"), new("VIERNES", "Viernes"), new("SABADO", "Sábado"), new("DOMINGO", "Domingo")];
    private string veterinario = "", dia = "LUNES", inicio = "08:00", fin = "12:00";
    private bool mostrarInactivar, guardando, mostrarSuperposicion;
    private int? idInactivar;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        // El DAO de Java devuelve solamente el id del veterinario en cada horario.
        // Se consulta el catálogo existente por REST para mostrar el nombre real.
        List<MascovetDomain.Usuarios.Veterinario> listaVeterinarios = new();
        try
        {
            listaVeterinarios = await VeterinariosREST.ListarTodosAsync();
            veterinarios = listaVeterinarios.Where(v => v.Activo)
                .Select(v => new SelectOption<string>(v.IdUsuario.ToString(),
                    $"{v.Nombre} {v.ApellidoPaterno}".Trim())).ToList();
        }
        catch (Exception ex)
        {
            Toast.Error($"No se pudo consultar el catálogo de veterinarios: {ex.Message}");
        }
        try
        {
            horarios = (await HorariosREST.ListarTodosAsync()).Select(h =>
            {
                int idVet = h.Veterinario?.IdUsuario ?? 0;
                var encontrado = listaVeterinarios.FirstOrDefault(v => v.IdUsuario == idVet);
                string nombre = encontrado is not null
                    ? $"{encontrado.Nombre} {encontrado.ApellidoPaterno} {encontrado.ApellidoMaterno}".Trim()
                    : idVet > 0 ? $"Veterinario #{idVet}" : "Sin veterinario asociado";
                return new HorarioFila(h.IdHorario, nombre, h.Dia?.ToString() ?? "",
                    h.HoraInicio?.ToString("HH:mm") ?? "", h.HoraFin?.ToString("HH:mm") ?? "", h.Activo);
            }).ToList();
        }
        catch (Exception ex) { Toast.Error($"No se pudieron cargar los horarios: {ex.Message}"); }
        if (string.IsNullOrWhiteSpace(veterinario)) veterinario = veterinarios.FirstOrDefault()?.Value ?? "";
    }

    private void Limpiar()
    {
        veterinario = veterinarios.FirstOrDefault()?.Value ?? "";
        dia = "LUNES"; inicio = "08:00"; fin = "12:00";
    }

    private async Task Registrar()
    {
        if (guardando) return;
        if (!int.TryParse(veterinario, out int idVet) ||
            !TimeOnly.TryParse(inicio, out var desde) ||
            !TimeOnly.TryParse(fin, out var hasta) || desde >= hasta)
        {
            Toast.Warning("Selecciona un veterinario y horas válidas."); return;
        }
        if (!Enum.TryParse<MascovetDomain.Enums.Dia>(dia, out var diaSeleccionado))
        {
            Toast.Warning("Selecciona un día válido."); return;
        }
        try
        {
            if ((await HorariosREST.ListarTodosAsync()).Any(h => h.Activo && h.Veterinario?.IdUsuario == idVet &&
                h.Dia == diaSeleccionado && h.HoraInicio.HasValue && h.HoraFin.HasValue &&
                desde < h.HoraFin.Value && hasta > h.HoraInicio.Value))
            { mostrarSuperposicion=true; return; }
        }
        catch (Exception ex) { Toast.Error($"No se pudo verificar los horarios actuales: {ex.Message}"); return; }
        guardando = true;
        try
        {
            var horario = new MascovetDomain.Citas.HorarioAtencion
            {
                Veterinario = new MascovetDomain.Usuarios.Veterinario { IdUsuario = idVet },
                Dia = diaSeleccionado,
                HoraInicio = desde, HoraFin = hasta, Activo = true
            };
            int resultado = await HorariosREST.InsertarAsync(horario);
            if (resultado <= 0) { mostrarSuperposicion=true; return; }
            Toast.Success("Horario registrado.");
            Limpiar(); await Cargar();
        }
        catch (Exception ex) { Toast.Error($"El servidor rechazó el horario: {ex.Message}"); }
        finally { guardando = false; }
    }

    private void SolicitarInactivar(HorarioFila h) { idInactivar = h.Id; mostrarInactivar = true; }
    private async Task Inactivar()
    {
        if (!idInactivar.HasValue) { mostrarInactivar = false; return; }
        int id = idInactivar.Value;
        try
        {
            int resultado = await HorariosREST.EliminarAsync(id);
            if (resultado > 0) { Toast.Success("Horario inactivado."); await Cargar(); }
            else Toast.Warning("No se confirmó la inactivación.");
        }
        catch (Exception ex) { Toast.Error($"No se pudo inactivar el horario: {ex.Message}"); }
        finally { idInactivar = null; mostrarInactivar = false; }
    }
}
