@page "/administrador/personal/editar/{Id:int}"
@inject VeterinarioRestService VeterinariosREST
@inject RecepcionistaRestService RecepcionistasREST
@inject NavigationManager Navigation
@layout MainLayout
@inject ToastService Toast
<PageTitle>Editar personal | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header"><div><h1>Editar personal</h1><p>Modifica la información del trabajador seleccionado.</p></div></header>
    @if(!Existe) { <AppCard Title="Registro no encontrado"><p>No se encontró al trabajador.</p></AppCard> }
    else
    {
        <AppCard Title="Datos del trabajador">
            <div class="form-grid">
                <div class="span-4"><AppInput TValue="string" Label="Tipo de personal" Disabled="true" @bind-Value="tipo" /></div>
                <div class="span-4"><AppInput TValue="string" Label="Nombres" @bind-Value="nombres" /></div>
                <div class="span-4"><AppInput TValue="string" Label="Apellido paterno" @bind-Value="paterno" /></div>
                <div class="span-4"><AppInput TValue="string" Label="Apellido materno" @bind-Value="materno" /></div>
                <div class="span-4"><AppInput TValue="string" Label="DNI" @bind-Value="dni" /></div>
                <div class="span-4"><AppInput TValue="string" Label="Teléfono" Type="tel" @bind-Value="telefono" /></div>
                <div class="span-6"><AppInput TValue="string" Label="Correo electrónico" Type="email" @bind-Value="correo" /></div>
                @if(tipo=="Veterinario")
                { <div class="span-3"><AppSelect TValue="string" Label="Especialidad" Options="especialidades" @bind-Value="especialidad" /></div><div class="span-3"><AppInput TValue="string" Label="Colegiatura" @bind-Value="colegiatura" /></div> }
                else { <div class="span-6"><AppSelect TValue="string" Label="Turno" Options="turnos" @bind-Value="turno" /></div> }
            </div>
            <div class="acciones"><AppButton OnClick="Guardar">Guardar cambios</AppButton><AppButton OnClick="() => confirmar = true" Variant="ButtonVariant.Danger">Inactivar personal</AppButton><AppButton Href="/administrador/personal" Variant="ButtonVariant.Secondary">Cancelar</AppButton></div>
        </AppCard>
    }
</div>
<AppModal @bind-Visible="confirmar" Title="Inactivar personal" ConfirmText="Inactivar" ConfirmVariant="ButtonVariant.Danger" OnConfirm="Inactivar"><p>¿Deseas inactivar el acceso de este trabajador?</p></AppModal>
@code {
    [Parameter] public int Id { get; set; }
    private MascovetDomain.Usuarios.Veterinario? vet;
    private MascovetDomain.Usuarios.Recepcionista? recep;
    private bool Existe => vet is not null || recep is not null;
    private bool confirmar;
    private string tipo="",nombres="",paterno="",materno="",dni="",telefono="",correo="",especialidad="CIRUGIA",colegiatura="",turno="Mañana";
    private readonly List<SelectOption<string>> especialidades=[new("MEDICINA_GENERAL","Medicina general"),new("CIRUGIA","Cirugía"),new("DERMATOLOGIA","Dermatología"),new("CARDIOLOGIA","Cardiología"),new("ODONTOLOGIA","Odontología")];
    private readonly List<SelectOption<string>> turnos=[new("Mañana","Mañana"),new("Tarde","Tarde"),new("Noche","Noche")];
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            vet=(await VeterinariosREST.ListarTodosAsync()).FirstOrDefault(x=>x.IdUsuario==Id);
            recep=vet is null ? (await RecepcionistasREST.ListarTodosAsync()).FirstOrDefault(x=>x.IdUsuario==Id) : null;
            if (!Existe) return;
            var u=(MascovetDomain.Usuarios.Usuario?)vet ?? recep;
            tipo=vet is null ? "Recepcionista" : "Veterinario";
            nombres=u?.Nombre ?? ""; paterno=u?.ApellidoPaterno ?? ""; materno=u?.ApellidoMaterno ?? "";
            dni=u?.Dni ?? ""; telefono=vet?.Telefono ?? recep?.Telefono ?? ""; correo=vet?.Correo ?? recep?.Correo ?? "";
            especialidad=vet?.Especialidad?.ToString() ?? "CIRUGIA";colegiatura=vet?.NumeroColegiatura ?? "";turno=recep?.Turno ?? "Mañana";
        }
        catch(Exception ex){Toast.Error($"No se pudo cargar el trabajador: {ex.Message}");}
    }
    private async Task Guardar()
    {
        if (!Existe) return;
        try
        {
            int result;
            if(vet is not null)
            {
                vet.Nombre=nombres;vet.ApellidoPaterno=paterno;vet.ApellidoMaterno=materno;vet.Dni=dni;
                vet.Telefono=telefono;vet.Correo=correo;vet.NumeroColegiatura=colegiatura;
                vet.Especialidad=Enum.Parse<MascovetDomain.Enums.Especialidad>(especialidad);
                result=await VeterinariosREST.ModificarAsync(vet);
            }
            else
            {
                recep!.Nombre=nombres;recep.ApellidoPaterno=paterno;recep.ApellidoMaterno=materno;recep.Dni=dni;
                recep.Telefono=telefono;recep.Correo=correo;recep.Turno=turno;
                result=await RecepcionistasREST.ModificarAsync(recep);
            }
            if(result<=0){Toast.Warning("No se confirmó el cambio.");return;}
            Toast.Success("Datos actualizados.");Navigation.NavigateTo("/administrador/personal");
        }
        catch(Exception ex){Toast.Error($"No se pudo actualizar el personal: {ex.Message}");}
    }
    private async Task Inactivar()
    {
        confirmar=false;
        try
        {
            int result=vet is not null ? await VeterinariosREST.EliminarAsync(Id) : await RecepcionistasREST.EliminarAsync(Id);
            if(result<=0){Toast.Warning("No se confirmó la inactivación.");return;}
            Toast.Success("Trabajador inactivado.");Navigation.NavigateTo("/administrador/personal");
        }
        catch(Exception ex){Toast.Error($"No se pudo inactivar al trabajador: {ex.Message}");}
    }
}
