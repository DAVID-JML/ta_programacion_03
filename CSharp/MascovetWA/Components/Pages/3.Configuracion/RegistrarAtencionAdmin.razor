@page "/administrador/atenciones/nueva"
@inject CitaRestService CitasREST
@inject MascotaRestService MascotasREST
@inject VacunaRestService VacunasREST
@inject ConsultaRestService ConsultasREST
@inject ControlRestService ControlesREST
@inject CirugiaRestService CirugiasREST
@inject VacunacionRestService VacunacionesREST
@inject NavigationManager Navigation
@layout MainLayout
@inject ToastService Toast
@using MascovetWA.Servicios.Validaciones
<PageTitle>Registrar atención médica | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header"><div><h1>Registrar atención médica</h1><p>Completa los datos generales y específicos de la atención.</p></div></header>
    <AppCard Title="Datos de la atención">
        <div class="form-grid">
            <div class="span-6"><AppSelect TValue="string" Label="Tipo de atención" Options="tipos" @bind-Value="tipo" /></div>
            <div class="span-6"><AppSelect TValue="string" Label="Cita asociada" Options="citas" @bind-Value="idCita" /></div>
            <div class="span-4"><AppInput TValue="decimal" Type="number" Label="Peso actual (kg)" step="0.01" min="0" @bind-Value="peso" /></div>
            <div class="span-4"><AppInput TValue="string" Type="time" Label="Hora de inicio" @bind-Value="horaInicio" /></div>
            <div class="span-4"><AppInput TValue="string" Type="time" Label="Hora de fin" @bind-Value="horaFin" /></div>
            <div class="span-6"><AppTextArea TValue="string" Label="Alergias" Rows="3" @bind-Value="alergias" /></div>
            <div class="span-6"><AppTextArea TValue="string" Label="Observaciones" Rows="3" @bind-Value="observaciones" /></div>
        </div>
    </AppCard>
    <AppCard Title="@($"Detalle de {tipo}")">
        <div class="form-grid">
            @if (tipo == "Consulta")
            {
                <div class="span-12"><AppTextArea TValue="string" Label="Motivo de consulta" @bind-Value="detalle1" /></div>
                <div class="span-6"><AppTextArea TValue="string" Label="Diagnóstico" @bind-Value="detalle2" /></div>
                <div class="span-6"><AppTextArea TValue="string" Label="Tratamiento" @bind-Value="detalle3" /></div>
            }
            else if (tipo == "Control")
            {
                <div class="span-6"><AppTextArea TValue="string" Label="Evolución" @bind-Value="detalle1" /></div>
                <div class="span-6"><AppTextArea TValue="string" Label="Indicaciones" @bind-Value="detalle2" /></div>
            }
            else if (tipo == "Cirugía")
            {
                <div class="span-6"><AppTextArea TValue="string" Label="Procedimiento" @bind-Value="detalle1" /></div>
                <div class="span-6"><AppTextArea TValue="string" Label="Indicaciones postoperatorias" @bind-Value="detalle2" /></div>
            }
            else
            {
                <div class="span-6"><AppSelect TValue="string" Label="Vacuna aplicada" Options="vacunas" @bind-Value="vacuna" /></div>
                <div class="span-6"><AppInput TValue="string" Label="Dosis" @bind-Value="detalle1" /></div>
                <div class="span-6"><AppDatePicker Label="Fecha de aplicación" @bind-Value="fechaAplicacion" /></div>
                <div class="span-6"><AppDatePicker Label="Próxima dosis" @bind-Value="fechaDosis" /></div>
            }
        </div>
        <div class="acciones"><AppButton OnClick="Guardar" Disabled="@guardando" Loading="@guardando">Guardar atención</AppButton><AppButton Href="/administrador/atenciones" Variant="ButtonVariant.Secondary">Volver</AppButton></div>
    </AppCard>
</div>
@code {
    [SupplyParameterFromQuery(Name="tipo")]public string? TipoSeleccionado{get;set;}
    private string tipo="Consulta",idCita="",horaInicio="09:00",horaFin="10:00",alergias="",observaciones="",detalle1="",detalle2="",detalle3="",vacuna="";
    private decimal peso;
    private DateOnly? fechaAplicacion,fechaDosis;
    private bool guardando;
    private List<MascovetDomain.Citas.Cita> citasDatos=new();
    private readonly List<SelectOption<string>> tipos=[new("Consulta","Consulta"),new("Control","Control"),new("Cirugía","Cirugía"),new("Vacunación","Vacunación")];
    private List<SelectOption<string>> citas=new(),vacunas=new();
    protected override async Task OnInitializedAsync()
    {
        if(TipoSeleccionado is "Consulta" or "Control" or "Cirugía" or "Vacunación")tipo=TipoSeleccionado;
        try
        {
            var mascotas = await MascotasREST.ListarTodosAsync();
            citasDatos=(await CitasREST.ListarTodosAsync()).Where(c=>c.Activo && c.Estado==MascovetDomain.Enums.EstadoCita.CONFIRMADA).ToList();
            citas=citasDatos
                .Select(c=>
                {
                    var mascota = mascotas.FirstOrDefault(m => m.IdMascota == c.Mascota?.IdMascota);
                    return new SelectOption<string>(c.IdCita.ToString(), $"{c.IdCita} — {mascota?.Nombre ?? "Mascota"} ({c.TipoAtencion})");
                }).ToList();
            vacunas=(await VacunasREST.ListarTodosAsync()).Where(v=>v.Activo)
                .Select(v=>new SelectOption<string>(v.IdVacuna.ToString(),v.Nombre??"")).ToList();
            idCita=citas.FirstOrDefault()?.Value??"";vacuna=vacunas.FirstOrDefault()?.Value??"";
        }
        catch(Exception ex){Toast.Error($"No se pudieron cargar las citas o vacunas: {ex.Message}");}
    }
    private async Task Guardar()
    {
        if (guardando) return;
        if(!int.TryParse(idCita,out int id)||!TimeOnly.TryParse(horaInicio,out var inicio)||!TimeOnly.TryParse(horaFin,out var fin)||inicio>=fin)
        {Toast.Warning("Selecciona una cita y horas válidas.");return;}
        if(!citasDatos.Any(c=>c.IdCita==id && c.TipoAtencion?.ToString()==
            (tipo=="Cirugía"?"CIRUGIA":tipo=="Vacunación"?"VACUNACION":tipo.ToUpperInvariant())))
        { Toast.Warning("La cita no está confirmada o su tipo no corresponde a la atención seleccionada."); return; }
        try
        {
            var usadas=(await ConsultasREST.ListarTodosAsync()).Any(a=>a.Activo && a.Cita?.IdCita==id) ||
                (await ControlesREST.ListarTodosAsync()).Any(a=>a.Activo && a.Cita?.IdCita==id) ||
                (await CirugiasREST.ListarTodosAsync()).Any(a=>a.Activo && a.Cita?.IdCita==id) ||
                (await VacunacionesREST.ListarTodosAsync()).Any(a=>a.Activo && a.Cita?.IdCita==id);
            if(usadas) { Toast.Warning("La cita ya tiene una atención registrada."); return; }
        }
        catch(Exception ex) { Toast.Error($"No se pudo validar si la cita ya fue atendida: {ex.Message}"); return; }
        guardando=true;
        try
        {
            var cita=new MascovetDomain.Citas.Cita{IdCita=id};
            MascovetDomain.AtencionesMedicas.AtencionMedica a=tipo switch
            {
                "Consulta"=>new MascovetDomain.AtencionesMedicas.Consulta{MotivoConsulta=detalle1,Diagnostico=detalle2,Tratamiento=detalle3},
                "Control"=>new MascovetDomain.AtencionesMedicas.Control{Evolucion=detalle1,Indicaciones=detalle2},
                "Cirugía"=>new MascovetDomain.AtencionesMedicas.Cirugia{Procedimiento=detalle1,IndicacionesPostOperatorias=detalle2},
                _=>new MascovetDomain.AtencionesMedicas.Vacunacion{
                    FechaAplicacion=fechaAplicacion?.ToDateTime(TimeOnly.MinValue),
                    FechaProximaDosis=fechaDosis?.ToDateTime(TimeOnly.MinValue),Dosis=detalle1}
            };
            a.Cita=cita;a.HoraInicio=inicio;a.HoraFin=fin;a.PesoActual=(double)peso;a.Alergias=alergias;a.Observaciones=observaciones;
            int result;
            if(a is MascovetDomain.AtencionesMedicas.Vacunacion v)
            {
                if(!int.TryParse(vacuna,out int idVacuna)){Toast.Warning("Selecciona una vacuna.");return;}
                v.AgregarVacuna(new MascovetDomain.AtencionesMedicas.Vacuna{IdVacuna=idVacuna});
                result=await VacunacionesREST.InsertarAsync(v);
            }
            else result=a switch
            {
                MascovetDomain.AtencionesMedicas.Consulta x=>await ConsultasREST.InsertarAsync(x),
                MascovetDomain.AtencionesMedicas.Control x=>await ControlesREST.InsertarAsync(x),
                MascovetDomain.AtencionesMedicas.Cirugia x=>await CirugiasREST.InsertarAsync(x),
                _=>0
            };
            if(result<=0){Toast.Warning("El servidor no confirmó el registro.");return;}
            try
            {
                var citaReal=await CitasREST.BuscarPorIdAsync(id);
                var mascota=(await MascotasREST.ListarTodosAsync()).FirstOrDefault(m=>m.IdMascota==citaReal?.Mascota?.IdMascota);
                if(citaReal is null || mascota?.Cliente?.IdUsuario is not > 0)
                { Toast.Warning("Atención guardada, pero no se pudo completar el estado de la cita.");return; }
                citaReal.Mascota=new MascovetDomain.Mascotas.Mascota
                    {IdMascota=mascota.IdMascota,Cliente=new MascovetDomain.Usuarios.Cliente{IdUsuario=mascota.Cliente.IdUsuario}};
                if(citaReal.Fecha.HasValue) citaReal.Fecha=ReglasCitas.FechaParaRest(citaReal.Fecha.Value);
                citaReal.Estado=MascovetDomain.Enums.EstadoCita.ATENDIDA;
                if(await CitasREST.ModificarAsync(citaReal)<=0)
                { Toast.Warning("Atención guardada, pero la cita no pasó a ATENDIDA.");return; }
                Toast.Success("Atención registrada y cita marcada ATENDIDA.");
                Navigation.NavigateTo("/administrador/atenciones");
            }
            catch(Exception ex) { Toast.Warning($"Atención guardada; fallo al actualizar la cita: {ex.Message}"); }
        }
        catch(Exception ex){Toast.Error($"No se pudo registrar la atención: {ex.Message}");}
        finally {guardando=false;}
    }
}
