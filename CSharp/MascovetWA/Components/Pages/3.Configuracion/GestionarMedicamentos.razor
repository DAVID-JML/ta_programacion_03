@page "/administrador/medicamentos"
@inject MedicamentoRestService MedicamentosREST
@layout MainLayout
@inject ToastService Toast
<PageTitle>Medicamentos | Mascovet</PageTitle>

<div class="ms-feature-page">
    <header class="ms-feature-header"><div><h1>Medicamentos</h1><p>Administra el catálogo de medicamentos utilizados en las recetas.</p></div></header>

    <AppCard Title="Registrar medicamento">
        <div class="form-grid">
            <div class="span-6"><AppInput TValue="string" Label="Nombre" Required="true" maxlength="100" @bind-Value="nombre" /></div>
            <div class="span-3"><AppDatePicker Label="Fecha de vencimiento" Required="true" @bind-Value="vencimiento" /></div>
            <div class="span-3"><AppInput TValue="decimal" Label="Monto (S/)" Type="number" min="0" step="0.01" @bind-Value="monto" /></div>
            <div class="span-12"><AppTextArea TValue="string" Label="Descripción" maxlength="200" @bind-Value="descripcion" /></div>
        </div>
        <div class="acciones">
            <AppButton OnClick="Registrar" Loading="@registrando" Disabled="@registrando">Registrar medicamento</AppButton>
            <AppButton OnClick="LimpiarRegistro" Variant="ButtonVariant.Secondary">Limpiar</AppButton>
        </div>
    </AppCard>

    <AppCard Title="Medicamentos registrados">
        <AppTable Items="medicamentos" Caption="Catálogo de medicamentos" ColumnCount="6">
            <HeaderContent><th>Medicamento</th><th>Descripción</th><th>Vencimiento</th><th>Monto (S/)</th><th>Estado</th><th>Acciones</th></HeaderContent>
            <RowTemplate Context="m">
                <td>@m.Nombre</td><td>@m.Descripcion</td><td>@m.Vencimiento.ToString("dd/MM/yyyy")</td><td>@m.Monto.ToString("0.00")</td>
                <td><AppBadge Variant="@(m.Activo ? SemanticVariant.Success : SemanticVariant.Warning)" ShowIcon="false">@(m.Activo ? "Activo" : "Inactivo")</AppBadge></td>
                <td><div class="ms-inline-actions">
                    <AppButton OnClick="() => Editar(m)" Size="ButtonSize.Small" Variant="ButtonVariant.Secondary">Editar</AppButton>
                    <AppButton OnClick="() => SolicitarInactivar(m)" Size="ButtonSize.Small" Variant="ButtonVariant.Danger">Inactivar</AppButton>
                </div></td>
            </RowTemplate>
        </AppTable>
    </AppCard>
</div>

<AppModal @bind-Visible="mostrarEdicion" Title="Editar medicamento" ConfirmText="Guardar cambios" OnConfirm="GuardarEdicion" Busy="@guardandoEdicion">
    <div class="form-grid">
        <div class="span-12"><AppInput TValue="string" Label="Nombre" Required="true" maxlength="100" @bind-Value="nombreEdicion" /></div>
        <div class="span-6"><AppDatePicker Label="Fecha de vencimiento" Required="true" @bind-Value="vencimientoEdicion" /></div>
        <div class="span-6"><AppInput TValue="decimal" Label="Monto (S/)" Type="number" min="0" step="0.01" @bind-Value="montoEdicion" /></div>
        <div class="span-12"><AppTextArea TValue="string" Label="Descripción" maxlength="200" @bind-Value="descripcionEdicion" /></div>
    </div>
</AppModal>

<AppModal @bind-Visible="confirmando" Title="Inactivar medicamento" ConfirmText="Inactivar" ConfirmVariant="ButtonVariant.Danger" OnConfirm="Inactivar">
    <p>¿Deseas inactivar este medicamento del catálogo?</p>
</AppModal>

@code {
    private sealed record MedicamentoFila(int Id, string Nombre, string Descripcion, DateOnly Vencimiento, decimal Monto, bool Activo);
    private List<MedicamentoFila> medicamentos = new();
    private bool mostrarEdicion, guardandoEdicion, registrando, confirmando;
    private int? idEdicion, idInactivar;
    private string nombre = "", descripcion = "";
    private DateOnly? vencimiento;
    private decimal monto;
    private string nombreEdicion = "", descripcionEdicion = "";
    private DateOnly? vencimientoEdicion;
    private decimal montoEdicion;

    protected override async Task OnInitializedAsync() => await Cargar();
    private async Task Cargar()
    {
        try
        {
            medicamentos = (await MedicamentosREST.ListarTodosAsync())
                .Select(m => new MedicamentoFila(m.IdMedicamento, m.Nombre ?? "", m.Descripcion ?? "",
                    DateOnly.FromDateTime(m.FechaVencimiento ?? DateTime.Today), (decimal)m.Monto, m.Activo)).ToList();
        }
        catch (Exception ex) { Toast.Error($"No se pudieron cargar los medicamentos: {ex.Message}"); }
    }

    private void LimpiarRegistro() { nombre = ""; descripcion = ""; vencimiento = null; monto = 0; }
    private async Task Registrar()
    {
        if (registrando) return;
        if (string.IsNullOrWhiteSpace(nombre) || !vencimiento.HasValue || monto < 0)
        { Toast.Warning("Completa el nombre, la fecha y un monto válido."); return; }
        registrando = true;
        try
        {
            var medicamento = new MascovetDomain.Recetas.Medicamento
            {
                Nombre = nombre.Trim(), Descripcion = descripcion,
                FechaVencimiento = vencimiento.Value.ToDateTime(TimeOnly.MinValue),
                Monto = (double)monto, Activo = true
            };
            int resultado = await MedicamentosREST.InsertarAsync(medicamento);
            if (resultado <= 0) { Toast.Warning("El servidor no confirmó el registro."); return; }
            Toast.Success("Medicamento registrado."); LimpiarRegistro(); await Cargar();
        }
        catch (Exception ex) { Toast.Error($"No se pudo registrar el medicamento: {ex.Message}"); }
        finally { registrando = false; }
    }

    private void Editar(MedicamentoFila m)
    {
        idEdicion = m.Id;
        nombreEdicion = m.Nombre;
        descripcionEdicion = m.Descripcion;
        vencimientoEdicion = m.Vencimiento;
        montoEdicion = m.Monto;
        mostrarEdicion = true;
    }

    private async Task GuardarEdicion()
    {
        if (guardandoEdicion || !idEdicion.HasValue) return;
        if (string.IsNullOrWhiteSpace(nombreEdicion) || !vencimientoEdicion.HasValue || montoEdicion < 0)
        { Toast.Warning("Completa el nombre, la fecha y un monto válido."); return; }
        guardandoEdicion = true;
        try
        {
            var medicamento = await MedicamentosREST.BuscarPorIdAsync(idEdicion.Value);
            if (medicamento is null) { Toast.Warning("El medicamento ya no está disponible."); return; }
            medicamento.IdMedicamento = idEdicion.Value;
            medicamento.Nombre = nombreEdicion.Trim();
            medicamento.Descripcion = descripcionEdicion;
            medicamento.FechaVencimiento = vencimientoEdicion.Value.ToDateTime(TimeOnly.MinValue);
            medicamento.Monto = (double)montoEdicion;
            int resultado = await MedicamentosREST.ModificarAsync(medicamento);
            if (resultado <= 0) { Toast.Warning("El servidor no confirmó la modificación."); return; }
            Toast.Success("Medicamento actualizado.");
            mostrarEdicion = false;
            idEdicion = null;
            await Cargar();
        }
        catch (Exception ex) { Toast.Error($"No se pudo editar el medicamento: {ex.Message}"); }
        finally { guardandoEdicion = false; }
    }

    private void SolicitarInactivar(MedicamentoFila m) { idInactivar = m.Id; confirmando = true; }
    private async Task Inactivar()
    {
        if (!idInactivar.HasValue) { confirmando = false; return; }
        int id = idInactivar.Value;
        try
        {
            int resultado = await MedicamentosREST.EliminarAsync(id);
            if (resultado > 0) { Toast.Success("Medicamento inactivado."); await Cargar(); }
            else Toast.Warning("No se confirmó la inactivación.");
        }
        catch (Exception ex) { Toast.Error($"No se pudo inactivar el medicamento: {ex.Message}"); }
        finally { idInactivar = null; confirmando = false; }
    }
}
