@page "/administrador/atenciones/ver/{Id:int}"
@inject ConsultaRestService ConsultasREST
@inject ControlRestService ControlesREST
@inject CirugiaRestService CirugiasREST
@inject VacunacionRestService VacunacionesREST
@inject CitaRestService CitasREST
@inject MascotaRestService MascotasREST
@inject VeterinarioRestService VeterinariosREST
@page "/administrador/atenciones/editar/{Id:int}"
@layout MainLayout
@inject NavigationManager Navigation
@inject ToastService Toast
<PageTitle>@Titulo | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header"><div><h1>@Titulo</h1><p>Información asociada a la atención seleccionada.</p></div></header>
    @if (Atencion is null)
    { <AppCard Title="Atención no encontrada"><p>No se encontró el registro solicitado.</p><AppButton Href="/administrador/atenciones" Variant="ButtonVariant.Secondary">Volver</AppButton></AppCard> }
    else
    {
        <AppCard Title="Datos de la atención">
            <div class="ms-detail-grid">
                <div><span>Código</span><strong>AT-@Id</strong></div><div><span>Mascota</span><strong>@Atencion.Mascota</strong></div>
                <div><span>Veterinario</span><strong>@Atencion.Veterinario</strong></div>
                <div><span>Estado</span><AppBadge Variant="SemanticVariant.Success" ShowIcon="false">Activa</AppBadge></div>
            </div>
            @if (EsEdicion)
            {
                <div class="form-grid">
                    <div class="span-6"><AppSelect TValue="string" Label="Tipo de atención" Options="tipos" Disabled="true" @bind-Value="tipo" /></div>
                    <div class="span-6"><AppInput TValue="string" Label="Fecha de atención" Disabled="true" @bind-Value="fechaTexto" /></div>
                    <div class="span-12"><AppTextArea TValue="string" Label="Observaciones" @bind-Value="observaciones" /></div>
                </div>
            }
            else
            {
                <div class="ms-detail-grid"><div><span>Tipo</span><strong>@Atencion.Tipo</strong></div><div><span>Fecha</span><strong>@Atencion.Fecha.ToString("dd/MM/yyyy")</strong></div><div><span>Observaciones</span><strong>@Atencion.Observaciones</strong></div></div>
            }
            <div class="acciones">
                @if (EsEdicion) { <AppButton OnClick="Guardar">Guardar cambios</AppButton><AppButton Href="@($"/administrador/atenciones/ver/{Id}?tipo={Uri.EscapeDataString(tipo)}")" Variant="ButtonVariant.Tertiary">Ver detalle</AppButton> }
                else { <AppButton Href="@($"/administrador/atenciones/editar/{Id}?tipo={Uri.EscapeDataString(tipo)}")">Editar</AppButton> }
                <AppButton Href="/administrador/atenciones" Variant="ButtonVariant.Secondary">Volver</AppButton>
            </div>
        </AppCard>
    }
</div>
@code {
    [Parameter]public int Id{get;set;}
    [SupplyParameterFromQuery(Name="tipo")]private string? TipoSolicitado{get;set;}
    private bool EsEdicion=>Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("administrador/atenciones/editar/",StringComparison.OrdinalIgnoreCase);
    private string Titulo=>EsEdicion?"Editar atención":"Detalle de atención";
    private sealed record AtencionFila(string Mascota,string Veterinario,string Tipo,DateOnly Fecha,string Observaciones);
    private AtencionFila? Atencion;
    private MascovetDomain.AtencionesMedicas.AtencionMedica? registro;
    private string tipo="Consulta",observaciones="",fechaTexto="";
    private readonly List<SelectOption<string>> tipos=[new("Consulta","Consulta"),new("Control","Control"),new("Cirugía","Cirugía"),new("Vacunación","Vacunación")];
    protected override async Task OnParametersSetAsync()
    {
        Atencion = null;
        registro = null;
        var atenciones = new List<(MascovetDomain.AtencionesMedicas.AtencionMedica Registro, string Tipo)>();

        // Si se recibe el tipo, consultar solo ese recurso: un fallo en otra
        // categoría no debe impedir abrir el detalle actual.
        bool Incluir(string nombre) => string.IsNullOrWhiteSpace(TipoSolicitado)
            || nombre.Equals(TipoSolicitado, StringComparison.OrdinalIgnoreCase);

        try
        {
            if (Incluir("Consulta"))
                atenciones.AddRange((await ConsultasREST.ListarTodosAsync())
                    .Select(a => ((MascovetDomain.AtencionesMedicas.AtencionMedica)a, "Consulta")));
            if (Incluir("Control"))
                atenciones.AddRange((await ControlesREST.ListarTodosAsync())
                    .Select(a => ((MascovetDomain.AtencionesMedicas.AtencionMedica)a, "Control")));
            if (Incluir("Cirugía"))
                atenciones.AddRange((await CirugiasREST.ListarTodosAsync())
                    .Select(a => ((MascovetDomain.AtencionesMedicas.AtencionMedica)a, "Cirugía")));
            if (Incluir("Vacunación"))
                atenciones.AddRange((await VacunacionesREST.ListarTodosAsync())
                    .Select(a => ((MascovetDomain.AtencionesMedicas.AtencionMedica)a, "Vacunación")));
        }
        catch (Exception ex)
        {
            Toast.Error($"No se pudo consultar la atención desde REST: {ex.Message}");
            return;
        }

        var encontrado = atenciones.FirstOrDefault(a => a.Registro.IdAtencion == Id);
        registro = encontrado.Registro;
        if (registro is null) return;
        tipo = encontrado.Tipo;
        observaciones = registro.Observaciones ?? "";

        MascovetDomain.Citas.Cita? cita = registro.Cita;
        try
        {
            var citas = await CitasREST.ListarTodosAsync();
            cita = citas.FirstOrDefault(c => c.IdCita == registro.Cita?.IdCita) ?? cita;
        }
        catch { /* Se conservan los datos que existan en el objeto recibido. */ }

        int idMascota = cita?.Mascota?.IdMascota ?? 0;
        int idVet = cita?.Veterinario?.IdUsuario ?? 0;
        string nombreMascota = cita?.Mascota?.Nombre ?? "";
        string nombreVet = $"{cita?.Veterinario?.Nombre} {cita?.Veterinario?.ApellidoPaterno}".Trim();
        try
        {
            var mascotas = await MascotasREST.ListarTodosAsync();
            nombreMascota = mascotas.FirstOrDefault(m => m.IdMascota == idMascota)?.Nombre
                ?? nombreMascota;
        }
        catch { }
        try
        {
            var veterinarios = await VeterinariosREST.ListarTodosAsync();
            var vet = veterinarios.FirstOrDefault(v => v.IdUsuario == idVet);
            if (vet is not null) nombreVet = $"{vet.Nombre} {vet.ApellidoPaterno}".Trim();
        }
        catch { }
        if (string.IsNullOrWhiteSpace(nombreMascota))
            nombreMascota = idMascota > 0 ? $"Mascota #{idMascota}" : "Sin mascota asociada";
        if (string.IsNullOrWhiteSpace(nombreVet))
            nombreVet = idVet > 0 ? $"Veterinario #{idVet}" : "Sin veterinario asociado";

        var fecha = DateOnly.FromDateTime(cita?.Fecha ?? DateTime.Today);
        fechaTexto = cita?.Fecha?.ToString("dd/MM/yyyy") ?? "Sin fecha";
        Atencion = new(nombreMascota, nombreVet, tipo, fecha, observaciones);
    }
    private async Task Guardar()
    {
        if(registro is null)return;
        registro.Observaciones=observaciones;
        try
        {
            int result=registro switch
            {
                MascovetDomain.AtencionesMedicas.Consulta a=>await ConsultasREST.ModificarAsync(a),
                MascovetDomain.AtencionesMedicas.Control a=>await ControlesREST.ModificarAsync(a),
                MascovetDomain.AtencionesMedicas.Cirugia a=>await CirugiasREST.ModificarAsync(a),
                MascovetDomain.AtencionesMedicas.Vacunacion a=>await VacunacionesREST.ModificarAsync(a),
                _=>0
            };
            if(result<=0){Toast.Warning("No se confirmó la actualización.");return;}
            Toast.Success("Atención actualizada.");Navigation.NavigateTo($"/administrador/atenciones/ver/{Id}?tipo={Uri.EscapeDataString(tipo)}");
        }
        catch(Exception ex){Toast.Error($"No se pudo actualizar la atención: {ex.Message}");}
    }
}
