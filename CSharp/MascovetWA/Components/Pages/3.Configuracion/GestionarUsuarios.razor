@page "/administrador/cuentas"
@page "/administrador/cuentas/gestionar"
@layout MainLayout
@inject ToastService Toast
<PageTitle>Cuentas y roles | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header"><div><h1>Cuentas y roles</h1><p>Gestiona los roles y el acceso del personal.</p></div></header>
    <AppCard Title="Cuentas del sistema">
        <AppTable Items="cuentas" ColumnCount="4" Caption="Cuentas del personal">
            <HeaderContent><th>Usuario</th><th>Rol</th><th>Estado</th><th>Acciones</th></HeaderContent>
            <RowTemplate Context="c"><td>@c.Usuario</td><td>@c.Rol</td><td><AppBadge Variant="SemanticVariant.Success" ShowIcon="false">Habilitado</AppBadge></td><td><AppButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" OnClick="() => Seleccionar(c)">Gestionar</AppButton></td></RowTemplate>
        </AppTable>
    </AppCard>
    <AppCard Title="Administrar acceso">
        <div class="form-grid">
            <div class="span-4"><AppInput TValue="string" Label="Usuario" Disabled="true" @bind-Value="usuario" /></div>
            <div class="span-4"><AppSelect TValue="string" Label="Rol" Options="roles" @bind-Value="rol" /></div>
            <div class="span-4"><AppSelect TValue="string" Label="Acceso" Options="estados" @bind-Value="estado" /></div>
        </div>
        <div class="acciones"><AppButton OnClick="Guardar">Guardar cambios</AppButton></div>
    </AppCard>
</div>
@code {
    private sealed record CuentaFila(string Usuario,string Rol);
    private readonly List<CuentaFila> cuentas=[new("admin","Administrador"),new("vet.paredes","Veterinario"),new("recepcion","Recepcionista")];
    private readonly List<SelectOption<string>> roles=[new("Administrador","Administrador"),new("Veterinario","Veterinario"),new("Recepcionista","Recepcionista")];
    private readonly List<SelectOption<string>> estados=[new("Habilitado","Habilitado"),new("Deshabilitado","Deshabilitado")];
    private string usuario="admin",rol="Administrador",estado="Habilitado";
    private void Seleccionar(CuentaFila c){usuario=c.Usuario;rol=c.Rol;estado="Habilitado";}
    private void Guardar()=>Toast.Warning("No se pudieron guardar los cambios. El servicio de cuentas no está disponible.");
}
