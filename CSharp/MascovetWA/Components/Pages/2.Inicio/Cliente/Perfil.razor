@page "/cliente/perfil"
@inject ClienteRestService ClientesREST
@inject UserContext User
@layout MainLayout

@inject ToastService Toast

<PageTitle>Mi perfil | Mascovet</PageTitle>

<div class="perfil-cliente">

    <header class="perfil-cliente__header">
        <h1>Mi perfil</h1>
        <p>
            Consulta tus datos personales y administra la información
            de tu cuenta.
        </p>
    </header>

    <section class="perfil-cliente__section"
             aria-label="Información personal">

        <EditForm Model="@datos" OnValidSubmit="@GuardarDatos">
            <DataAnnotationsValidator />

            <AppCard Title="Datos personales"
                     Subtitle="Consulta tu información y actualiza tus datos de contacto.">

                <ChildContent>
                    <div class="perfil-cliente__grid">

                        <div class="perfil-cliente__field">
                            <AppInput TValue="string"
                                      Id="perfil-nombres"
                                      Label="Nombres"
                                      Placeholder="Se cargarán desde tu cuenta"
                                      readonly
                                      @bind-Value="datos.Nombres"
                                      autocomplete="given-name" />
                        </div>

                        <div class="perfil-cliente__field">
                            <AppInput TValue="string"
                                      Id="perfil-apellido-paterno"
                                      Label="Apellido paterno"
                                      Placeholder="Se cargará desde tu cuenta"
                                      readonly
                                      @bind-Value="datos.ApellidoPaterno"
                                      autocomplete="family-name" />
                        </div>
                        <div class="perfil-cliente__field">
                            <AppInput TValue="string"
                                      Id="perfil-apellido-materno"
                                      Label="Apellido materno"
                                      Placeholder="Se cargará desde tu cuenta"
                                      readonly
                                      @bind-Value="datos.ApellidoMaterno" />
                        </div>

                        <div class="perfil-cliente__field">
                            <AppInput TValue="string"
                                      Id="perfil-dni"
                                      Label="DNI"
                                      Placeholder="Se cargará desde tu cuenta"
                                      readonly
                                      @bind-Value="datos.Dni" />
                        </div>

                        <div class="perfil-cliente__field">
                            <AppInput TValue="string"
                                      Id="perfil-telefono"
                                      Label="Teléfono"
                                      Type="tel"
                                      Placeholder="Ingresa tu teléfono"
                                      Required="true"
                                      @bind-Value="datos.Telefono"
                                      autocomplete="tel" />
                        </div>

                        <div class="perfil-cliente__field perfil-cliente__field--full">
                            <AppInput TValue="string"
                                      Id="perfil-correo"
                                      Label="Correo electrónico"
                                      Type="email"
                                      Placeholder="nombre@correo.com"
                                      Required="true"
                                      maxlength="200"
                                      @bind-Value="datos.Correo"
                                      autocomplete="email" />
                        </div>

                    </div>
                </ChildContent>

                <Footer>
                    <div class="perfil-cliente__actions">
                        <AppButton Type="submit"
                                   Variant="ButtonVariant.Primary"
                                   Icon="check-circle">
                            Guardar cambios
                        </AppButton>
                    </div>
                </Footer>

            </AppCard>
        </EditForm>

    </section>

    <div class="perfil-cliente__back">
        <AppButton Href="/cliente"
                   Variant="ButtonVariant.Tertiary"
                   Icon="chevron-left">
            Volver al inicio
        </AppButton>
    </div>

</div>

@code {
    private readonly DatosPerfilModel datos = new();

    private MascovetDomain.Usuarios.Cliente? cliente;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var propios=(await ClientesREST.ListarTodosAsync()).Where(c=>c.Activo&&
                !string.IsNullOrWhiteSpace(User.UsuarioVinculado)&&
                string.Equals(c.NombreUsuario,User.UsuarioVinculado,StringComparison.OrdinalIgnoreCase)).ToList();
            cliente=propios.Count==1?propios[0]:null;
            if(cliente is null){Toast.Warning("No se pudo identificar la cuenta del cliente.");return;}
            datos.Nombres=cliente.Nombre??"";datos.ApellidoPaterno=cliente.ApellidoPaterno??"";
            datos.ApellidoMaterno=cliente.ApellidoMaterno??"";datos.Dni=cliente.Dni??"";
            datos.Telefono=cliente.Telefono??"";datos.Correo=cliente.Correo??"";
        }
        catch(Exception ex){Toast.Error($"No se pudo cargar el perfil: {ex.Message}");}
    }

    private async Task GuardarDatos()
    {
        if(cliente is null){Toast.Warning("Selecciona una cuenta válida.");return;}
        cliente.Telefono=datos.Telefono;cliente.Correo=datos.Correo;
        try
        {
            int result=await ClientesREST.ModificarAsync(cliente);
            if(result>0){Toast.Success("Datos de contacto actualizados.");}
            else Toast.Warning("No se confirmó la actualización.");
        }
        catch(Exception ex){Toast.Error($"No se pudo guardar el perfil: {ex.Message}");}
    }

    private sealed class DatosPerfilModel
    {
        public string Nombres { get; set; } = string.Empty;

        public string ApellidoPaterno { get; set; } = string.Empty;
        public string ApellidoMaterno { get; set; } = string.Empty;

        public string Dni { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa tu teléfono.")]
        [Phone(ErrorMessage = "Ingresa un teléfono válido.")]
        [StringLength(20, ErrorMessage = "El teléfono no puede superar los 20 caracteres.")]
        public string Telefono { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa tu correo electrónico.")]
        [EmailAddress(ErrorMessage = "Ingresa un correo electrónico válido.")]
        [StringLength(200, ErrorMessage = "El correo no puede superar los 200 caracteres.")]
        public string Correo { get; set; } = string.Empty;
    }
}
