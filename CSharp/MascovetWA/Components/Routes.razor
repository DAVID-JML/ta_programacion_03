@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @if (EsPublica())
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        }
        else
        {
            <AuthorizeView>
                <Authorized Context="ctx">
                    @if (TienePermiso(ctx.User))
                    {
                        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                            <NotAuthorized><RedirectToLogin /></NotAuthorized>
                        </AuthorizeRouteView>
                    }
                    else
                    {
                        <LayoutView Layout="typeof(AuthLayout)">
                            <p role="alert">No tienes permisos para acceder a este módulo.</p>
                            <a href="/">Ir al inicio</a>
                        </LayoutView>
                    }
                </Authorized>
                <NotAuthorized><RedirectToLogin /></NotAuthorized>
            </AuthorizeView>
        }
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(AuthLayout)">
            <h1>Página no encontrada</h1><a href="/">Volver al inicio</a>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private string Ruta() => Navigation.ToBaseRelativePath(Navigation.Uri)
        .Split('?', '#')[0].Trim('/').ToLowerInvariant();
    private bool EsPublica() => Ruta() is "" or "registro";

    private bool TienePermiso(ClaimsPrincipal usuario)
    {
        if (usuario.Identity?.IsAuthenticated != true) return false;
        var ruta = Ruta();
        if (ruta.StartsWith("cliente/", StringComparison.Ordinal) || ruta == "cliente")
            return usuario.IsInRole("Cliente");
        if (ruta.StartsWith("administrador/", StringComparison.Ordinal) || ruta == "administrador")
            return usuario.IsInRole("Administrador");
        if (ruta.StartsWith("veterinario/", StringComparison.Ordinal) || ruta == "veterinario")
            return usuario.IsInRole("Veterinario");
        if (ruta.StartsWith("recepcion/", StringComparison.Ordinal) || ruta == "recepcion")
            return usuario.IsInRole("Recepcionista");
        return false;
    }
}
