@inject NavigationManager Navigation
@inject UserContext User

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @if (EsPublica())
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        }
        else if (!User.IsAuthenticated)
        {
            <RedirectToLogin />
        }
        else if (TienePermiso())
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        }
        else
        {
            <LayoutView Layout="typeof(AuthLayout)">
                <p role="alert">No tienes permisos para acceder a este módulo.</p>
                <a href="/">Ir al inicio</a>
            </LayoutView>
        }
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(AuthLayout)">
            <h1>Página no encontrada</h1><a href="/">Volver al inicio</a>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private string Ruta() => Navigation.ToBaseRelativePath(Navigation.Uri)
        .Split('?', '#')[0].Trim('/').ToLowerInvariant();

    private bool EsPublica() => Ruta() is "" or "registro" or "autentificar-personal";

    private bool TienePermiso()
    {
        string ruta = Ruta();
        string? prefijo = User.Role switch
        {
            UserRole.Cliente => "cliente",
            UserRole.Veterinario => "veterinario",
            UserRole.Recepcionista => "recepcion",
            UserRole.Administrador => "administrador",
            _ => null
        };
        return prefijo is not null &&
               (ruta == prefijo || ruta.StartsWith(prefijo + "/", StringComparison.Ordinal));
    }
}