        <element kind="staticText" uuid="1acb697e-1a8c-45dd-b80c-4a311c16ddab" x="279" y="33" width="85" height="13" fontName="DejaVu Sans" fontSize="7" forecolor="#667E90" hTextAlign="Left" vTextAlign="Middle" bold="true">
          <text>ESPECIE / RAZA</text>
        </element>
        <element kind="textField" uuid="e471dbf9-110a-41ba-96bb-1c235fce30e6" x="369" y="27" width="173" height="29" fontName="DejaVu Sans" fontSize="9" forecolor="#183A55" hTextAlign="Left" vTextAlign="Top" bold="false" textAdjust="StretchHeight">
          <expression>($F{especie} == null ? "-" : $F{especie}) + " / " + ($F{raza} == null ? "-" : $F{raza})</expression>
        </element>
        <element kind="staticText" uuid="5faf5837-3661-4a49-9aea-762575b00ef8" x="15" y="65" width="86" height="13" fontName="DejaVu Sans" fontSize="7" forecolor="#667E90" hTextAlign="Left" vTextAlign="Middle" bold="true">
          <text>PROPIETARIO</text>
        </element>
        <element kind="textField" uuid="fb36878a-ced5-40f5-8c02-d95789de1588" x="103" y="59" width="435" height="25" fontName="DejaVu Sans" fontSize="10" forecolor="#183A55" hTextAlign="Left" vTextAlign="Middle" bold="false">
          <expression>$F{propietario} == null ? "Sin titular informado" : $F{propietario}</expression>
        </element>
      </band>
    </groupHeader>
  </group>
