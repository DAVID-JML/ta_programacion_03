<?xml version='1.0' encoding='UTF-8'?>
<jasperReport name="ReporteHistorialClinico" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="c27989fa-7687-40af-adb6-c3e585bc0f28">
  <parameter name="idMascota" class="java.lang.Integer"/>
  <parameter name="fechaInicio" class="java.sql.Date"/>
  <parameter name="fechaFin" class="java.sql.Date"/>
  <query language="sql">SELECT m.nombre AS nombreMascota, m.especie AS especie, m.raza AS raza,
 CONCAT_WS(' ', up.nombre, up.apellido_paterno, up.apellido_materno) AS propietario,
 a.peso_actual AS pesoActual, a.alergias AS alergias, c.fecha AS fecha, COALESCE(CONCAT(u.nombre,' ',u.apellido_paterno,' ',u.apellido_materno),'Veterinario no asignado') AS veterinario,
 c.tipo_atencion AS tipo,
 COALESCE(NULLIF(con.diagnostico,''), NULLIF(ctrl.evolucion,''), NULLIF(cir.procedimiento,''),
    CONCAT('Vacuna(s): ', COALESCE(vacunas.nombres,'No especificada')), 'Sin diagnóstico registrado') AS diagnostico,
 COALESCE(NULLIF(con.tratamiento,''), NULLIF(ctrl.indicaciones,''), NULLIF(cir.indicaciones_post_operatorias,''),
    NULLIF(vacun.dosis,''), 'Sin tratamiento registrado') AS tratamiento
 FROM ATENCION_MEDICA a
 JOIN CITA c ON c.id_cita = a.id_cita
 JOIN MASCOTA m ON m.id_mascota = c.id_mascota
 LEFT JOIN USUARIO up ON up.id_usuario = m.id_usuario
 LEFT JOIN VETERINARIO v ON v.id_usuario = c.id_veterinario
 LEFT JOIN USUARIO u ON u.id_usuario = v.id_usuario
 LEFT JOIN CONSULTA con ON con.id_atencion = a.id_atencion AND con.activo = 1
 LEFT JOIN CONTROL ctrl ON ctrl.id_atencion = a.id_atencion AND ctrl.activo = 1
 LEFT JOIN CIRUGIA cir ON cir.id_atencion = a.id_atencion AND cir.activo = 1
 LEFT JOIN VACUNACION vacun ON vacun.id_atencion = a.id_atencion AND vacun.activo = 1
 LEFT JOIN (SELECT vv.id_vacunacion, GROUP_CONCAT(va.nombre SEPARATOR ', ') AS nombres
     FROM VACUNACION_VACUNA vv JOIN VACUNA va ON va.id_vacuna=vv.id_vacuna
     WHERE vv.activo=1 GROUP BY vv.id_vacunacion) vacunas ON vacunas.id_vacunacion=a.id_atencion
 WHERE c.id_mascota = $P{idMascota} AND a.activo = 1
 AND ($P{fechaInicio} IS NULL OR c.fecha &gt;= $P{fechaInicio})
 AND ($P{fechaFin} IS NULL OR c.fecha &lt;= $P{fechaFin})
 ORDER BY c.fecha ASC, a.hora_inicio ASC, a.id_atencion ASC</query>
  <field name="nombreMascota" class="java.lang.String"/>
  <field name="fecha" class="java.sql.Date"/>
  <field name="veterinario" class="java.lang.String"/>
  <field name="tipo" class="java.lang.String"/>
  <field name="diagnostico" class="java.lang.String"/>
  <field name="tratamiento" class="java.lang.String"/>
  <field name="especie" class="java.lang.String"/>
  <field name="raza" class="java.lang.String"/>
  <field name="propietario" class="java.lang.String"/>
  <field name="pesoActual" class="java.lang.Double"/>
  <field name="alergias" class="java.lang.String"/>
  <group name="PerfilMascota">
    <expression>$P{idMascota}</expression>
