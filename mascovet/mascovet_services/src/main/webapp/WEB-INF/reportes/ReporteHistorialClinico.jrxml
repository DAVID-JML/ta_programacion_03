    <element kind="textField" uuid="09d5b9a0-f054-4dc7-9aa6-81116c694b67" x="20" y="83" width="520" height="15" fontName="DejaVu Sans" fontSize="8" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Top" bold="false">
      <expression>"Mascota N.° " + $P{idMascota} + "   |   Período: " + ($P{fechaInicio} == null ? "Desde el primer registro" : new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fechaInicio})) + " al " + ($P{fechaFin} == null ? "último registro" : new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fechaFin}))</expression>
    </element>
  </title>
