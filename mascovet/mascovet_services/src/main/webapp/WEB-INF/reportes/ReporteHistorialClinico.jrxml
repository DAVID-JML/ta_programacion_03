        <element kind="staticText" uuid="7b2b807d-f752-4f02-8cb2-4f4ff535cfa5" x="15" y="7" width="525" height="18" fontName="DejaVu Sans" fontSize="9" forecolor="#143B56" hTextAlign="Left" vTextAlign="Middle" bold="true">
          <text>FICHA DE IDENTIFICACIÓN</text>
        </element>
        <element kind="staticText" uuid="38675de9-aa7f-42a1-9072-4105aa335150" x="15" y="33" width="79" height="13" fontName="DejaVu Sans" fontSize="7" forecolor="#667E90" hTextAlign="Left" vTextAlign="Middle" bold="true">
          <text>MASCOTA</text>
        </element>
        <element kind="textField" uuid="1f31db6e-3ae6-4202-b5a9-c2b6b7e9e4b8" x="92" y="27" width="175" height="26" fontName="DejaVu Sans" fontSize="11" forecolor="#143B56" hTextAlign="Left" vTextAlign="Middle" bold="true">
          <expression>$F{nombreMascota}</expression>
