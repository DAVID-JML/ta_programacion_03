@page "/cliente/mascotas/{IdMascota:int}"
@page "/recepcion/mascotas/{IdMascota:int}"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>Ficha de mascota | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header">
        <div><h1>Ficha de mascota</h1><p>Consulta los datos, citas, vacunas y recetas de la mascota seleccionada.</p></div>
        <span class="ms-demo-pill">Vista de demostración</span>
    </header>
    @if (Mascota is null)
    {
        <AppCard Title="Mascota no encontrada">
            <p>No hay información de ejemplo para la mascota seleccionada.</p>
            <AppButton Href="@VolverHref" Variant="ButtonVariant.Secondary">Volver a mascotas</AppButton>
        </AppCard>
    }
    else
    {
        <div class="seccion">
            <AppCard Title="Datos de la mascota" Subtitle="RF014 · Información general y del propietario.">
                <div class="ms-feature-grid">
                    <label class="ms-demo-field"><span>Nombre</span><input class="ms-demo-input" value="@Mascota.Nombre" readonly /></label>
                    <label class="ms-demo-field"><span>Especie</span><input class="ms-demo-input" value="@Mascota.Especie" readonly /></label>
                    <label class="ms-demo-field"><span>Raza</span><input class="ms-demo-input" value="@Mascota.Raza" readonly /></label>
                    <label class="ms-demo-field"><span>Sexo</span><input class="ms-demo-input" value="@Mascota.Sexo" readonly /></label>
                    <label class="ms-demo-field"><span>Fecha de nacimiento</span><input class="ms-demo-input" value="@Mascota.FechaNacimiento" readonly /></label>
                    <label class="ms-demo-field"><span>Propietario</span><input class="ms-demo-input" value="@Mascota.Propietario" readonly /></label>
                </div>
            </AppCard>
        </div>
        <div class="seccion">
            <AppCard Title="Historial de atenciones" Subtitle="Registros de ejemplo para la demostración">
                <div class="ms-table-wrap">
                    <table class="ms-table">
                        <thead><tr><th scope="col">Fecha</th><th scope="col">Tipo de atención</th><th scope="col">Veterinario</th><th scope="col">Resultado</th></tr></thead>
                        <tbody>
                            @foreach (var atencion in Mascota.Atenciones)
                            {
                                <tr><td>@atencion.Fecha</td><td>@atencion.Tipo</td><td>@atencion.Veterinario</td><td>@atencion.Resultado</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </AppCard>
        </div>
        <div class="seccion">
            <AppCard Title="Vacunaciones y recetas" Subtitle="Consulta la información asociada a la mascota.">
                <div class="ms-demo-actions">
                    <AppButton Href="@HistorialHref" Variant="ButtonVariant.Secondary">Ver historial clínico</AppButton>
                    <AppButton Href="@VolverHref" Variant="ButtonVariant.Secondary">Volver a mascotas</AppButton>
                </div>
            </AppCard>
        </div>
    }
</div>
@code {
    [Parameter] public int IdMascota { get; set; }

    private bool EsRecepcion => Navigation.ToBaseRelativePath(Navigation.Uri)
        .StartsWith("recepcion/", StringComparison.OrdinalIgnoreCase);
    private string VolverHref => EsRecepcion ? "/recepcion/mascotas" : "/cliente/mascotas";
    private string HistorialHref => $"/{(EsRecepcion ? "recepcion" : "cliente")}/mascotas/{IdMascota}/historial";

    // Se mantienen los datos de demostración de cada listado y sus identificadores.
    private MascotaDemo? Mascota => (EsRecepcion, IdMascota) switch
    {
        (_, 1) => new("Luna", "Perro", "Mestiza", "Hembra", "14/03/2022", "Ana Martínez López",
            [new("23/10/2026", "Consulta", "Dra. Lucía Paredes", "Control registrado"),
             new("14/09/2026", "Vacunación", "Dr. Mateo Silva", "Vacuna aplicada")]),
        (true, 2) => new("Max", "Gato", "Doméstico", "Macho", "03/02/2024", "Carlos Vega Ruiz",
            [new("25/10/2026", "Vacunación", "Dr. Mateo Silva", "Vacuna aplicada")]),
        (false, 2) => new("Michi", "Gato", "Doméstico de pelo corto", "Macho", "03/02/2024", "Ana Martínez López",
            [new("07/07/2026", "Vacunación", "Dr. Mateo Silva", "Triple felina aplicada")]),
        _ => null
    };

    private sealed record AtencionDemo(string Fecha, string Tipo, string Veterinario, string Resultado);
    private sealed record MascotaDemo(string Nombre, string Especie, string Raza, string Sexo,
        string FechaNacimiento, string Propietario, List<AtencionDemo> Atenciones);
}
