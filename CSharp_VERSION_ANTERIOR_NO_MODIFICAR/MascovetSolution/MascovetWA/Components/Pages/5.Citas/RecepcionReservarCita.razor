@page "/recepcion/citas/nueva"
@layout MainLayout
@inject ToastService Toast
<PageTitle>Registrar cita | Mascovet</PageTitle>
<div class="ms-feature-page">
    <header class="ms-feature-header">
       <div><h1>Registrar cita</h1><p>Nueva cita gestionada por recepción.</p></div>
       <span class="ms-demo-pill">Vista de demostración</span>
    </header>
    <div class="seccion"><AppCard Title="Datos de la reserva" Subtitle="RF016 · La recepcionista registra una cita en representación del cliente."><ChildContent><div class="ms-feature-grid"><label class="ms-demo-field"><span>Cliente</span><select class="ms-demo-input" ><option value="Ana Martínez López">Ana Martínez López</option><option value="Carlos Vega Ruiz">Carlos Vega Ruiz</option></select></label><label class="ms-demo-field"><span>Mascota</span><select class="ms-demo-input" ><option value="Luna">Luna</option><option value="Max">Max</option></select></label><label class="ms-demo-field"><span>Especialidad</span><select class="ms-demo-input" ><option value="Medicina general">Medicina general</option><option value="Cirugía">Cirugía</option><option value="Dermatología">Dermatología</option></select></label><label class="ms-demo-field"><span>Veterinario</span><select class="ms-demo-input" ><option value="Dra. Lucía Paredes">Dra. Lucía Paredes</option><option value="Dr. Mateo Silva">Dr. Mateo Silva</option></select></label><label class="ms-demo-field"><span>Tipo de atención</span><select class="ms-demo-input" ><option value="Consulta">Consulta</option><option value="Control">Control</option><option value="Cirugía">Cirugía</option><option value="Vacunación">Vacunación</option></select></label><label class="ms-demo-field"><span>Fecha</span><input class="ms-demo-input" type="date" placeholder="" value="" /></label><label class="ms-demo-field"><span>Hora disponible</span><select class="ms-demo-input" ><option value="09:00">09:00</option><option value="10:30">10:30</option><option value="11:30">11:30</option></select></label></div></ChildContent></AppCard></div><div class="ms-demo-note"><AppIcon Name="check-circle" Size="16" /> <span>RF017: antes de registrar, Java verificará la disponibilidad, el horario del veterinario y que no exista una cita activa duplicada.</span></div><div class="ms-demo-actions"><AppButton Variant="ButtonVariant.Primary" OnClick="MostrarAviso">Registrar cita</AppButton><AppButton Href="/recepcion/citas" Variant="ButtonVariant.Secondary">Volver</AppButton></div>
</div>
@code { // Solo demostración visual: no se guardan cambios ni se consulta una base de datos.
 private void MostrarAviso() => Toast.Info("Esta operación se habilitará al integrar el backend Java."); }
