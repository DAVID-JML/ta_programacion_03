<?xml version='1.0' encoding='UTF-8'?>
<jasperReport name="ReporteCitasEspecialidad" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="636fcc15-d030-4850-96ea-1fd4964b8595">
  <parameter name="fechaInicio" class="java.sql.Date"/>
  <parameter name="fechaFin" class="java.sql.Date"/>
  <parameter name="rutaSubreporteGrafico" class="java.lang.String"/>
  <query language="sql">SELECT COALESCE(NULLIF(REPLACE(v.especialidad, '_', ' '),''),'SIN ESPECIALIDAD ASIGNADA') AS especialidad,
 CAST(COUNT(*) AS SIGNED) AS cantidad,
 CAST(ROUND(COUNT(*)*100.0 / NULLIF(SUM(COUNT(*)) OVER(),0),1) AS DECIMAL(5,1)) AS porcentaje
 FROM CITA c LEFT JOIN VETERINARIO v ON v.id_usuario = c.id_veterinario
 WHERE c.activo = 1 AND c.fecha BETWEEN $P{fechaInicio} AND $P{fechaFin}
 GROUP BY COALESCE(NULLIF(REPLACE(v.especialidad, '_', ' '),''),'SIN ESPECIALIDAD ASIGNADA')
 ORDER BY cantidad DESC, especialidad</query>
  <field name="especialidad" class="java.lang.String"/>
  <field name="cantidad" class="java.lang.Long"/>
  <field name="porcentaje" class="java.math.BigDecimal"/>
  <variable name="TOTAL_ESPECIALIDAD" class="java.lang.Long" calculation="Sum">
    <expression>$F{cantidad}</expression>
  </variable>
  <background splitType="Stretch"/>
  <title height="108" splitType="Stretch">
    <element kind="rectangle" uuid="f99f0da5-2bb4-403c-8c14-d34fa5e7b35e" x="0" y="0" width="555" height="101" mode="Opaque" backcolor="#143B56" forecolor="#143B56"/>
    <element kind="rectangle" uuid="1c6dbfe0-8171-4b86-993e-115900a8b438" x="0" y="0" width="6" height="101" mode="Opaque" backcolor="#2A8DA5" forecolor="#2A8DA5"/>
    <element kind="staticText" uuid="b04441fe-2ac4-484c-bdeb-0e66f8bb0353" x="20" y="9" width="300" height="18" fontName="DejaVu Sans" fontSize="9" forecolor="#B8ECF4" hTextAlign="Left" vTextAlign="Middle" bold="true">
      <text>MASCOVET  ·  INFORMES</text>
    </element>
    <element kind="staticText" uuid="cd29f0bf-b55e-44d3-ae59-9b6ee580f32e" x="20" y="29" width="520" height="35" fontName="DejaVu Sans" fontSize="16" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Middle" bold="true">
      <text>Citas por especialidad</text>
    </element>
    <element kind="staticText" uuid="438acb52-f283-4389-b3e5-c470eb68063a" x="20" y="65" width="520" height="16" fontName="DejaVu Sans" fontSize="8" forecolor="#C8DEEA" hTextAlign="Left" vTextAlign="Middle" bold="false">
      <text>Distribución estadística de las citas</text>
    </element>
    <element kind="textField" uuid="846eba16-fdf6-4f7b-9a3b-a5cd8e86ce7c" x="20" y="83" width="520" height="15" fontName="DejaVu Sans" fontSize="8" forecolor="#FFFFFF" hTextAlign="Left" vTextAlign="Top" bold="false">
      <expression>"Desde " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fechaInicio}) + " hasta " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fechaFin})</expression>
    </element>
  </title>
