      <parameter name="fechaInicio">
        <expression>$P{fechaInicio}</expression>
      </parameter>
      <parameter name="fechaFin">
        <expression>$P{fechaFin}</expression>
      </parameter>
      <connectionExpression>$P{REPORT_CONNECTION}</connectionExpression>
      <expression>$P{rutaSubreporteGrafico}</expression>
    </element>
